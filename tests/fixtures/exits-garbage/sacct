# ExitCode values sacct never prints ("%d:%d", each 0-127), one job each on its
# allocation row; JobName names the input.  A field is read only if it is 1-3
# ASCII digits, anything else counts as 0
@include ../_common/sacct-defaults
@defaults State=FAILED
JobID=101; JobName=v[0:]; ExitCode=0:
JobID=102; JobName=v[:53]; ExitCode=:53
JobID=103; JobName=v[0:53:7]; ExitCode=0:53:7
JobID=104; JobName=v[-1:0]; ExitCode=-1:0
JobID=105; JobName=v[0:-3]; ExitCode=0:-3
JobID=106; JobName=v[0:0x35]; ExitCode=0:0x35
JobID=107; JobName=v[0:_53]; ExitCode=0:\s53
JobID=108; JobName=v[1e3:0]; ExitCode=1e3:0
JobID=109; JobName=v[0:1e3]; ExitCode=0:1e3
JobID=110; JobName=v[EMPTY]; ExitCode=
JobID=111; JobName=v[1234:0]; ExitCode=1234:0
JobID=112; JobName=v[0:1234]; ExitCode=0:1234
JobID=113; JobName=v[0:+53]; ExitCode=0:+53
JobID=114; JobName=v[0:53.9]; ExitCode=0:53.9
JobID=115; JobName=v[0:+inf]; ExitCode=0:+inf
JobID=116; JobName=v[+inf:0]; ExitCode=+inf:0
JobID=117; JobName=v[0:٥٣]; ExitCode=0:٥٣
JobID=118; JobName=v[0:５３]; ExitCode=0:５３
JobID=119; JobName=v[N/A]; ExitCode=N/A
JobID=120; JobName=v[0:999]; ExitCode=0:999
JobID=121; JobName=v[007:0]; ExitCode=007:0
# a fold of junk: 0:-3 and 1234:0 read as 0:0, so the group lists 0/sig9 and 0
JobID=7300_0; JobName=junk; ExitCode=0:9
JobID=7300_1; JobName=junk; ExitCode=0:-3
JobID=7300_2; JobName=junk; ExitCode=1234:0
