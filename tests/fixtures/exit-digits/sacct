# R3-1 rule 1 (fix round 1, LOW 1): each field is 1-3 ASCII digits.  0007:0 is
# within 0-255 by value but has 4 digits: no wait status, so the job reads "?";
# 007:0 (3 digits) is 7, 0:0009 "?" too
@include ../_common/sacct-defaults
@defaults State=FAILED
JobID=131; JobName=four0007; ExitCode=0007:0; End=\{now-1m30s}
JobID=132; JobName=three007; ExitCode=007:0; End=\{now-2m30s}
JobID=133; JobName=sig0009; ExitCode=0:0009; End=\{now-3m30s}
