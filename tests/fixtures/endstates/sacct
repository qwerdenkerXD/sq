JobID=302; JobName=stopped; State=CANCELLED; End=2026-10-06T07:20:00
JobID=303; JobName=fed; State=REVOKED; End=2026-10-06T07:30:00
JobID=304; JobName=done; End=2026-10-06T07:40:00
