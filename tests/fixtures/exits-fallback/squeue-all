# squeue -t all prints exit_code as 23.11 does, "%u:%u" of the raw status
# (_print_job_exit_code, src/squeue/print.c): exit status:0, or 0:signal,
# nothing at all for NO_VAL.  Field 1 is not reduced by 128 as sacct does,
# and slurmctld's raw 1 for a job it ended itself prints as 0:1
@include ../_common/squeue-all-defaults
@defaults StateCompact=F; State=FAILED
JobID=3001; StateCompact=R; State=RUNNING; TimeUsed=10:00; EndTime=Unknown; Name=still-running
JobID=6001; exit_code=1:0; Name=rc1; EndTime=\{now-1m30s}
JobID=6002; StateCompact=OOM; State=OUT_OF_MEMORY; exit_code=0:125; Name=oom; EndTime=\{now-2m30s}
JobID=6003; exit_code=137:0; Name=shell137; EndTime=\{now-3m30s}
JobID=6004; exit_code=; Name=noval; EndTime=\{now-4m30s}
JobID=6005; exit_code=0:53; Name=launch; EndTime=\{now-5m30s}
JobID=6006; StateCompact=DL; State=DEADLINE; exit_code=0:1; Name=ctldfail; EndTime=\{now-6m30s}
JobID=6007; StateCompact=CA; State=CANCELLED; exit_code=0:9; Name=killed; EndTime=\{now-7m30s}
JobID=6008; exit_code=0:1x; Name=junk; EndTime=\{now-8m30s}
JobID=6009; StateCompact=CD; State=COMPLETED; exit_code=0:0; Name=fine; EndTime=\{now-9m30s}
# a form squeue cannot print (exit and signal both set), pinning that only
# an rc of 0 with signal 1 is read as exit 1
JobID=6010; exit_code=2:1; Name=both; EndTime=\{now-10m30s}
# forms squeue cannot print either: the 0:1 reading is of the values, so each
# of these is exit 1 like 0:1 itself
JobID=6011; exit_code=\s0:1; Name=lead; EndTime=\{now-11m30s}
JobID=6012; exit_code=00:1; Name=zero2; EndTime=\{now-12m30s}
JobID=6013; exit_code=0:01; Name=one2; EndTime=\{now-13m30s}
JobID=6014; exit_code=0:1:0; Name=third; EndTime=\{now-14m30s}
# 1:1 is not 0:1: an rc of 1 with signal 1 stays as it is
JobID=6015; exit_code=1:1; Name=oneone; EndTime=\{now-15m30s}
