#!/usr/bin/env bash
# not a stub: the real timeout, behaving as another release or host would, for
# the cases that put this directory first on PATH.  SQSTUB_TIMEOUT says how:
#   old     coreutils before 8.29 (RHEL 7, Ubuntu 18.04): --verbose is an unknown
#           option, refused with rc 125 before anything runs
#   core    a host that dumps cores: a command that died of SIGSEGV gets the
#           real timeout's "the monitored command dumped core" on stderr (the
#           stub itself never dumps one)
#   broken  timeout's own failure: every call fails with rc 125, as when it
#           cannot fork; SQSTUB_TIMEOUT_TEXT, when set, is what it says instead
#           (printf %b: several lines, any bytes)
#   log     the real one, each call logged first as "TIMEOUT <argv>" in
#           SQSTUB_LOG, so a case can read the bound sq gave a client
#   logrc   as log, and once the real one returns "TIMEOUT-RC <rc> <argv>",
#           so a case knows whether the bound fired (124) without asking sq:
#           the real timeout runs as a child, TERM, INT and HUP sent to this
#           one go on to it; not for a call sq may SIGKILL (that cannot be
#           passed on: the real one would outlive it)
real=
IFS=: read -ra dirs <<< "$PATH"
for dir in "${dirs[@]}"; do
	[ -x "$dir/timeout" ] && ! [ "$dir/timeout" -ef "${BASH_SOURCE[0]}" ] && { real=$dir/timeout; break; }
done
[ -n "$real" ] || { echo "tests/lib/timeout-as/timeout: no real timeout on PATH" >&2; exit 127; }
case ${SQSTUB_TIMEOUT:-} in
	old)
		for a in "$@"; do
			case $a in
				--verbose) printf "timeout: unrecognized option '--verbose'\nTry 'timeout --help' for more information.\n" >&2; exit 125 ;;
				-*) ;;
				*) break ;;    # the first word that is no option: -k's value, as sq puts --verbose first
			esac
		done
		exec "$real" "$@" ;;
	core)
		{ "$real" "$@" 2>&3; } 3>&2 2>/dev/null; rc=$?    # without bash's own "Segmentation fault"
		[ $rc != 139 ] || echo "timeout: the monitored command dumped core" >&2
		exit $rc ;;
	log)
		printf 'TIMEOUT\t%s\n' "$*" >> "${SQSTUB_LOG:?}"
		exec "$real" "$@" ;;
	logrc)
		printf 'TIMEOUT\t%s\n' "$*" >> "${SQSTUB_LOG:?}"
		"$real" "$@" <&0 & child=$!
		for sig in TERM INT HUP; do trap "kill -$sig $child 2>/dev/null" "$sig"; done
		while kill -0 "$child" 2>/dev/null; do wait "$child"; done   # a signal passed on interrupts the wait
		wait "$child"; rc=$?
		printf 'TIMEOUT-RC\t%s\t%s\n' "$rc" "$*" >> "$SQSTUB_LOG"
		exit $rc ;;
	broken)
		printf '%b\n' "${SQSTUB_TIMEOUT_TEXT:-timeout: fork system call failed: Resource temporarily unavailable}" >&2; exit 125 ;;
	*)	echo "tests/lib/timeout-as/timeout: SQSTUB_TIMEOUT is not old, core, broken, log or logrc" >&2; exit 125 ;;
esac
