# the classes, UTF8 the mode: gawk runs under a UTF-8 locale or C (utf8_ok,
# gawk_locale), where length("…█") is 2 or 6
function width_classes(   R, nr, i, p, lo, hi, w, cls) {
  UTF8 = (length("…█") == 2)
  if (!(128 in JSON_BYTE)) json_bytes()
  W_CONT = "[" JSON_BYTE[128] "-" JSON_BYTE[191] "]"   # a continuation byte (a regex under C only)
  nr = split(WIDTHS, R, " ")
  for (i = 1; i <= nr; i++) {
    w = substr(R[i], length(R[i])); sub(/:.$/, "", R[i])
    p = index(R[i], "-")
    lo = strtonum("0x" (p ? substr(R[i], 1, p - 1) : R[i])); hi = p ? strtonum("0x" substr(R[i], p + 1)) : lo
    if (UTF8) cls[w] = cls[w] json_utf8(lo) (hi > lo ? "-" json_utf8(hi) : "")
    else      cls[w] = cls[w] width_bytes(lo, hi)
  }
  # none of a width matches nothing: never "" (which matches everywhere) nor
  # "[]" (no regex)
  if (UTF8) {
    W_WIDE = (cls[2] == "") ? "" : "[" cls[2] "]"
    W_ZERO = (cls[0] == "") ? "" : "[" cls[0] "]"
    W_FAST = "[^\001-\177" "·…×↳█⚠␚▒▌▓░≥→" "]"   # beyond ASCII and the glyphs of sq
  } else {
    W_WIDE = substr(cls[2], 2); W_ZERO = substr(cls[0], 2)
  }
  W_VS16 = json_utf8(65039); W_ZWJ = json_utf8(8205)    # U+FE0F, U+200D
  W_MODLO = json_utf8(127995); W_MODHI = json_utf8(127999)   # U+1F3FB-1F3FF
}
# code points LO..HI (none below U+0080) as "|"-led alternatives of their
# UTF-8 bytes, a piece of one encoded length at a time, surrogates skipped
function width_bytes(lo, hi,   out, s, e) {
  for (s = lo; s <= hi; s = e + 1) {
    e = (s < 2048) ? 2047 : (s < 55296) ? 55295 : (s < 57344) ? 57343 : (s < 65536) ? 65535 : 1114111
    if (e > hi) e = hi
    if (s < 55296 || s > 57343) out = out width_seqs(s, e)
  }
  return out
}
# LO..HI of one encoded length N: equal leading bytes, then one byte that
# ranges, then any continuation byte, splitting where LO or HI is not aligned
function width_seqs(lo, hi,   n, i, j, m, a, b, s) {
  n = (lo < 2048) ? 2 : (lo < 65536) ? 3 : 4
  for (i = 0; i < n - 1; i++) {
    m = 2 ^ (6 * (n - 1 - i)); a = int(lo / m); b = int(hi / m)
    if (a == b) continue
    if (lo % m) return width_seqs(lo, (a + 1) * m - 1) width_seqs((a + 1) * m, hi)
    if (hi % m != m - 1) return width_seqs(lo, b * m - 1) width_seqs(b * m, hi)
    break
  }
  s = "|"
  for (j = 0; j < n; j++)
    s = s (j > i ? W_CONT : width_byte(lo, n, j) == width_byte(hi, n, j) ? width_byte(lo, n, j) \
                              : "[" width_byte(lo, n, j) "-" width_byte(hi, n, j) "]")
  return s
}
function width_byte(cp, n, j) {   # byte J (from 0) of the N-byte UTF-8 of CP
  if (j == 0) return JSON_BYTE[(n == 2 ? 192 : n == 3 ? 224 : 240) + int(cp / 2 ^ (6 * (n - 1)))]
  return JSON_BYTE[128 + int(cp / 2 ^ (6 * (n - 1 - j))) % 64]
