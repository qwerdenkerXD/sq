			next
		}
		/No steps running/ { next }
		{	rest = $0
			while (match(rest, /job [0-9]+|StepId=[0-9]+[.]/)) {
				id = substr(rest, RSTART, RLENGTH); gsub(/[^0-9]/, "", id)
				if (id in REQ) FAIL[id] = 1
				rest = substr(rest, RSTART + RLENGTH)
			}
		}
		END {
			for (i = 1; i <= n; i++) {
				id = Q[i]
				o = (rc != 0 || (id in FAIL) || ((id in ROWS) && !(id in HASMEM))) ? "failed" \
				  : (id in ROWS) ? "ok" : "none"
				printf "%s\t%s\t%.0f\n", id, o, (o == "ok") ? BYTES[id] : 0
			}
		}' "$tmp/sstat" "$tmp/sstat.err" > "$tmp/memread"
	# renamed into place, so a reader never meets half a snapshot
	if [ -n "$memdir" ] && memtmp=$(mktemp "$memdir/memuse.XXXXXX" 2>/dev/null); then
		{ printf '%s\n' "$memnow"; cat "$tmp/memread"; } > "$memtmp" 2>/dev/null &&
			mv -f "$memtmp" "$memdir/memuse" 2>/dev/null
		rm -f "$memtmp"; memtmp=
	fi
}

# ============================================================================
# sq log JOBID: a job's output file, followed while the job runs
# ============================================================================
# Franz's decisions (2026-10-20): the whole file, live, ending shortly after
# the job ends, raw, to be piped or followed; stdout, --err for stderr; a job
# Slurm forgot is refused, an array asks for a task, a requeue ends the stream
# with a note, notes go to stderr also into a pipe, and a cluster selection is
# refused, as the file is read on this machine.
# sq computes the path the way the job's slurmstepd does, from the raw -o/-e
# pattern squeue prints (scontrol expands only some letters), and polls Slurm
# every 5 s in every phase: waiting for the job to start, for the file to
# appear, and while tail streams it.  The stream ends only at a final state
# (never during CG, when a job may still write), after a 3 s grace.
log_help() {
	cat <<'EOF'
usage: sq log [-e|--err] [-n N] [--no-follow] JOBID

Prints a batch job's output file from its start, then follows it while the
job runs, and ends shortly (within about 10 s) after the job ends: pipe it
to less or grep, or watch it as it comes.  JOBID is 12345, an array task
12345_4, or a het job 12345+1 (its leader writes the output).  A pending job
is waited for until it runs and its file is there.

  -e, --err      the job's stderr file instead of its stdout file
  -n N           only the last N lines, then follow
  --no-follow    print what is there now and stop
  -h, --help     this help

Notes ("sq log: ...") go to stderr, also into a pipe; the file's own bytes
are passed on as they are.  Exit 0 when done, whatever the job's own outcome
(a note names it), 1 when the file cannot be shown, 2 for a usage error,
128+N when stopped by signal N.

Good to know:
- The path is computed from -o/-e the way Slurm's job does.  A file name that
  is reused (no %j in it) may first show an earlier run's text.
- sq log follows for as long as Slurm cannot tell it the job ended: while
  Slurm does not answer, it keeps following.
- "Live" can lag: a job on another node writes through NFS, and a program
  buffers its output into a file (python -u, or stdbuf -oL, helps).
- A requeued job ends the stream with a note; run sq log again for its new run.
- Under watch, use --no-follow -n N:  watch -n 5 sq log --no-follow -n 20 12345
- Slurm forgets a job about 5 minutes after it ends; its path is then unknown.
EOF
}

# every message names sq log and is scrubbed whole: it carries paths, names
# and reasons, all of them outside text
log_say()   { printf 'sq log: %s\n' "$(printf '%s' "$1" | scrub)" >&2; }
log_usage() { log_say "$*"; exit 2; }          # the command line is wrong
log_fail()  { log_say "$*"; exit 1; }          # the file cannot be shown
log_noted=
log_note() {   # log_note KIND TEXT: TEXT, the first time KIND has something to say
	case " $log_noted " in *" $1 "*) return ;; esac
	log_noted="$log_noted $1"; log_say "$2"
}
# SLURM_CLUSTERS, -M/--cluster(s), --federation and --sibling would ask another
# cluster about the job, while its file is read here: one text per cause
log_refuse_cluster() {
	case $1 in
		SLURM_CLUSTERS) log_usage "job output files are read on this machine; unset SLURM_CLUSTERS" ;;
		*) log_usage "job output files are read on this machine; drop $1" ;;
	esac
}

# The facts, one squeue call: every SQUEUE_* variable unset, as SQUEUE_USERS,
# _PARTITION, _NAMES ... filter even under --jobs and SQUEUE_SORT can fail the
# call, the format in SQUEUE_FORMAT2, framed by the nonce like the dashboard's
# calls (-O reads Field:suffix as size 0, the field whole), and the time and
# bitstring formats pinned
log_fields="JobID ArrayJobID ArrayTaskID HetJobID HetJobOffset StateCompact RestartCnt
	BatchFlag BatchHost WorkDir STDOUT STDERR UserName Name StartTime Reason exit_code"
log_ask() {   # log_ask ID HOW JOB [TASK]: ask about ID, the record HOW names into log_*
	SLURM_TIME_FORMAT=%s SLURM_BITSTR_LEN=0 SQUEUE_FORMAT2=$log_fmt \
		collect -w facts squeue -h --jobs="$1" -t all
	local rc=$? kv k
	local -A said=()
	log_verdict= log_why=
	if [ $rc -ne 0 ]; then
		# a job Slurm no longer knows is rc 1 and this text (23.11.4, measured)
		if [ $rc = 1 ] && env LC_ALL=C grep -q 'Invalid job id specified' "$tmp/facts.err" 2>/dev/null
		then log_verdict=none
		else log_verdict=fail; why_of log_why $rc "$tmp/facts" squeue
		fi
		return
	fi
	log_pick "$2" "$3" "${4-}" > "$tmp/pick" &&
	while IFS= read -r -d '' kv; do   # KEY=VALUE, the keys log_pick writes
		case " $log_keys " in *" ${kv%%=*} "*) said[${kv%%=*}]=${kv#*=} ;; esac
	done < "$tmp/pick"
	case ${said[verdict]-} in
		''|bad) log_verdict=fail; log_why="squeue output unreadable"; return ;;
	esac
	# a readable answer replaces every field; a failed or unreadable one
	# above changed only the verdict, so the last good record's host and
	# paths still describe the job for the notes
	for k in $log_keys; do printf -v "log_$k" '%s' "${said[$k]-}"; done
}
# A job's output paths, from the raw -o/-e patterns squeue prints, the way its
# slurmstepd computes them: gawk functions over R[record, squeue -O field
# name] (JobID ArrayJobID ArrayTaskID BatchHost UserName Name WorkDir STDOUT
# STDERR), shared by sq log and sq job
fname_awk='
function onetask(r) { return R[r, "ArrayTaskID"] ~ /^[0-9]+$/ }   # one task, numbered
# slurmstepd, src/slurmd/common/fname.c (23.11.4): remove_path_slashes()
# drops each backslash and keeps the second of two, and any backslash at
# all means no expansion
function unslash(f,   out, i, c) {
	for (i = 1; i <= length(f); i++) {
		c = substr(f, i, 1)
		if (c == "\\" && substr(f, i + 1, 1) == "\\") { out = out c; i++ }
		else if (c != "\\") out = out c
	}
	return out
}
function pad(v, wid) { return wid ? sprintf("%0" wid "d", v) : v }
# _create_batch_fname(): %% is %, a width (10 at most) zero-pads the
# numbers, %N is the batch host short name, %s "batch", %n %t 0; after a
# width an unknown letter keeps only the width last digit, and an unknown
# letter without one stays as written, "%" and all
function expand(f, r,   out, p, q, n, c, wid, host, v) {
	n = length(f); p = q = 1
	host = R[r, "BatchHost"]; sub(/[.].*/, "", host)
	while (p <= n) {
		if (substr(f, p, 1) != "%") { p++; continue }
		if (substr(f, p + 1, 1) == "%") { out = out substr(f, q, p + 1 - q); p += 2; q = p; continue }
		p++; wid = 0
		if (substr(f, p, 1) ~ /[0-9]/) {
			out = out substr(f, q, p - 1 - q)
			match(substr(f, p), /^[0-9]+/)
			wid = substr(f, p, RLENGTH) + 0; if (wid > 10) wid = 10
			p += RLENGTH; q = p - 1
			if (p > n) break
		}
		c = substr(f, p, 1)
		if      (c == "a") v = pad(onetask(r) ? R[r, "ArrayTaskID"] : 4294967294, wid)   # NO_VAL
		else if (c == "A") v = pad(R[r, "ArrayJobID"], wid)
		else if (c == "j" || c == "J") v = pad(R[r, "JobID"], wid)
		else if (c == "n" || c == "t") v = pad(0, wid)
		else if (c == "N") v = host
		else if (c == "s") v = "batch"
		else if (c == "u") v = R[r, "UserName"]
		else if (c == "x") v = R[r, "Name"]
		else continue
		out = out substr(f, q, p - 1 - q) v; p++; q = p
	}
	return out substr(f, q)
}
# fname_create(): a relative pattern is joined to the work dir, and one
# with a backslash is appended to it as it is, without a "/" (sic)
function fullpath(f, r,   dir) {
	if (substr(f, 1, 1) == "/") return index(f, "\\") ? unslash(f) : expand(f, r)
	dir = R[r, "WorkDir"]
	if (index(f, "\\")) return dir unslash(f)
	return dir (dir ~ /\/$/ ? "" : "/") expand(f, r)
}
# squeue prints a job without -o as WorkDir/slurm-JOBID.out, also for an
# array task, whose slurmstepd writes slurm-%A_%a.out; without -e it
# prints STDOUT for STDERR (src/squeue/print.c, 23.11.4), and slurmstepd
# then writes stderr where stdout goes
function outpat(r) {
	if (R[r, "STDOUT"] != R[r, "WorkDir"] "/slurm-" R[r, "JobID"] ".out") return R[r, "STDOUT"]
	return onetask(r) ? "slurm-%A_%a.out" : "slurm-%J.out"
}
function errpat(r) { return (R[r, "STDERR"] == R[r, "STDOUT"]) ? outpat(r) : R[r, "STDERR"] }
'
# What log_pick says, as KEY=VALUE, NUL-separated (no path holds a NUL):
#   verdict  ok, array or tasks (the array's task ids), leader (a het
#            component without its leader in the answer), none, notask,
#            nothet, bad
#   ok:      via: "", last (the array's last task) or het (a component, and
#            leader and offset name its het job and place); jobid, tid
#            (ArrayTaskID), state, restart, batch, host, reason, exit, and
#            out and err, the two paths
#   array, tasks: first (the smallest task id) and list (up to 10)
#   leader:  leader and offset
# log_keys are those keys, each kept in log_<key>; log_why, which log_ask
# sets for a failed or unreadable answer, is not one of them
log_keys="verdict via jobid tid state restart batch host reason exit out err first list leader offset"
# HOW is job (a plain id: the job itself, the leader of its het job, or the
# last task of an array, which carries the array's id), task (JOB_TASK),
# het (the leader of het job JOB) or tasks (array JOB's task ids).
log_pick() {   # log_pick HOW JOB [TASK]
	env LC_ALL=C gawk -v how="$1" -v job="$2" -v task="${3-}" -v fields="$log_fields" "$fname_awk"'
	BEGIN {
		RS = ENVIRON["SQ_NONCE"] "\n"; FS = ENVIRON["SQ_NONCE"]
		nf = split(fields, NAME, /[ \t\n]+/)        # R[record, field name], in this order
	}
	# every record whole, its job id a number, or nothing is read at all
	NF != nf || RT == "" || $1 !~ /^[0-9]+$/ { bad = 1; exit }
	{ nrec++; for (i = 1; i <= NF; i++) R[nrec, NAME[i]] = $i }
	function put(key, value) { printf "%s=%s%c", key, value, 0 }
	function ok(r, via) {
		put("verdict", "ok"); put("via", via)
		put("jobid", R[r, "JobID"]); put("tid", R[r, "ArrayTaskID"]); put("state", R[r, "StateCompact"])
		put("restart", R[r, "RestartCnt"]); put("batch", R[r, "BatchFlag"]); put("host", R[r, "BatchHost"])
		put("reason", R[r, "Reason"]); put("exit", R[r, "exit_code"])
		put("out", fullpath(outpat(r), r)); put("err", fullpath(errpat(r), r))
	}
	# the task ids of array job, smallest first, at most 10 of them; a
	# pending part is a bracket expression: a, a-b, a-b:step, %throttle
	function tasks(verdict,   r, x, t, nt, i, m, a, b, s, k, cnt, ids, sorted, nid, list) {
		for (r = 1; r <= nrec; r++) {
			if (R[r, "ArrayJobID"] != job || R[r, "ArrayTaskID"] == "N/A") continue
			x = R[r, "ArrayTaskID"]; sub(/%[0-9]+$/, "", x)
			nt = split(x, t, ",")
			for (i = 1; i <= nt; i++) {
				if (!match(t[i], /^([0-9]+)(-([0-9]+)(:([0-9]+))?)?$/, m)) continue
				a = m[1] + 0; b = (m[3] != "") ? m[3] + 0 : a; s = (m[5] != "") ? m[5] + 0 : 1
				if (s < 1 || b < a) continue
				cnt += int((b - a) / s) + 1
				for (k = a; k <= b && k < a + 10 * s; k += s) ids[k] = 1
			}
		}
		if (!cnt) { put("verdict", "none"); return }
		nid = asorti(ids, sorted, "@ind_num_asc")
		for (i = 1; i <= nid && i <= 10; i++) list = list (i > 1 ? "," : "") sorted[i]
		put("verdict", verdict); put("first", sorted[1]); put("list", list (cnt > 10 ? ",…" : ""))
	}
	END {
		if (bad) { put("verdict", "bad"); exit }
		if (how == "tasks") { tasks("tasks"); exit }
		if (how == "task") {
			for (r = 1; r <= nrec; r++)
				if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] == task) { ok(r, ""); exit }
			put("verdict", "notask"); exit
		}
		if (how == "het") {
			for (r = 1; r <= nrec; r++)
				if (R[r, "HetJobID"] == job && R[r, "HetJobOffset"] == "0") { ok(r, ""); exit }
			for (r = 1; r <= nrec; r++) if (R[r, "JobID"] == job) { put("verdict", "nothet"); exit }
			put("verdict", "none"); exit
		}
		for (me = 1; me <= nrec; me++) if (R[me, "JobID"] == job) break
		if (me <= nrec && R[me, "HetJobID"] != "N/A") {        # a het job: its leader writes
			if (R[me, "HetJobOffset"] == "0") { ok(me, ""); exit }
			for (r = 1; r <= nrec; r++)
				if (R[r, "HetJobID"] == R[me, "HetJobID"] && R[r, "HetJobOffset"] == "0") {
					ok(r, "het"); put("leader", R[me, "HetJobID"]); put("offset", R[me, "HetJobOffset"]); exit
				}
			put("verdict", "leader"); put("leader", R[me, "HetJobID"]); put("offset", R[me, "HetJobOffset"]); exit
		}
		for (r = 1; r <= nrec; r++) if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] != "N/A") { na++; last = r }
		if (na == 1 && R[last, "JobID"] == job && onetask(last)) { ok(last, "last"); exit }
		if (na) { tasks("array"); exit }
		if (me <= nrec) { ok(me, ""); exit }
		put("verdict", "none")
	}' "$tmp/facts"
}
# the file to read, from the record just taken: refused where it is /dev/null,
# noted where --err names the stdout file
log_resolve() {
	[ "$log_batch" != 0 ] || log_fail "job $log_label is an interactive job; its output went to its terminal"
	if [ $log_want = err ]; then
		[ "$log_err" != /dev/null ] || log_fail "job $log_label's stderr is discarded (it goes to /dev/null); drop --err"
		[ "$log_err" != "$log_out" ] ||
			log_note same "job $log_label writes its stderr into its stdout file; $doing that"
		log_path=$log_err
	else
		if [ "$log_out" = /dev/null ]; then
			[ "$log_err" = /dev/null ] && log_fail "job $log_label's output is discarded (it goes to /dev/null)"
			log_fail "job $log_label's output is discarded (it goes to /dev/null); its stderr has a file of its own: sq log --err $log_label"
		fi
		log_path=$log_out
	fi
}
# what a state means here: the job has not started (wait), runs or may still
# write (run: R, CG, a suspended job, any state sq does not know), ended
# (final), or was requeued (requeue: RQ RF; held: RH SE)
log_classify() {
	case $1 in
		PD|CF|RD) log_kind=wait ;;
		CD|F|CA|TO|OOM|NF|PR|BF|DL) log_kind=final ;;
		RQ|RF) log_kind=requeue ;;
		RH|SE) log_kind=held ;;
		*) log_kind=run ;;
	esac
}
# Only a regular file is read, as sq job's why tail reads one: opening a FIFO
# blocks for good, and tail streams a device like /dev/zero forever
log_readable() {   # is the file there to be read?  Not yet: 1.  Unreadable: rc 1 for sq
	[ ! -e "$log_path" ] || [ -f "$log_path" ] || log_fail "$log_path is not a regular file"
	{ : < "$log_path"; } 2>/dev/null && return 0
	[ -e "$log_path" ] || return 1
	local why; why=$({ : < "$log_path"; } 2>&1)
	log_fail "cannot read $log_path: ${why##*: }"
}
# tail's verdict once it ended: 0, its stderr ignored; its reader gone (141,
# or 1 with nothing said, where SIGPIPE was ignored) ends sq quietly with 0;
# a failure is its first line, rc 1, but for the "file truncated" and "has
# appeared" that -F reports and survives
log_tail_verdict() {   # log_tail_verdict RC
	[ "$1" != 0 ] || return 0
	[ "$1" != 141 ] || exit 0
	[ -s "$tmp/tail.err" ] || [ "$1" != 1 ] || exit 0
	local line
	line=$(env LC_ALL=C gawk '!/file truncated|has appeared/ { print; exit }' "$tmp/tail.err" 2>/dev/null)
	[ -n "$line" ] || [ ! -s "$tmp/tail.err" ] || return 0
	line=${line#tail: }
	log_fail "tail: ${line:-exit $1}"
}
log_dump() {   # what the file holds now, whole or its last N lines
	tail "${log_lines[@]}" -- "$log_path" 2> "$tmp/tail.err"
	log_tail_verdict $?
}
log_state_name() {   # the final state, as sacct and squeue -l spell it
	case $1 in
		CD) log_sname=COMPLETED ;; F) log_sname=FAILED ;; CA) log_sname=CANCELLED ;;
		TO) log_sname=TIMEOUT ;; OOM) log_sname=OUT_OF_MEMORY ;; NF) log_sname=NODE_FAIL ;;
		PR) log_sname=PREEMPTED ;; BF) log_sname=BOOT_FAIL ;; DL) log_sname=DEADLINE ;;
		*) log_sname=$1 ;;
	esac
}
# The end: the stream stopped (its sentinel killed, so tail reads once more
# and exits), else the file shown as it is now, then why it ended.  ENDING:
# final (the job ended), gone (Slurm forgot it), requeue or held
log_finish() {   # log_finish ENDING
	if [ -n "$log_tail_pid" ]; then
		kill "$log_sentinel_pid" 2>/dev/null
		{ wait "$log_tail_pid"; } 2>/dev/null; local rc=$?
		log_pids=$log_sentinel_pid log_tail_pid=
		log_tail_verdict $rc
	else
		case $1 in
			final|gone)
				log_readable || log_fail "job $log_label ended; $log_path was never written"
				log_dump ;;
		esac
	fi
	case $1 in
		final) log_state_name "$log_state"
		       log_say "job $log_label ended: $log_sname${log_exit:+ (exit code $log_exit)}" ;;
		gone)  log_say "job $log_label is gone from Slurm; stopping" ;;
		requeue) log_say "job $log_label was requeued (restart $log_restart); run sq log $log_label again for its new run" ;;
		held)  local now="is held"; [ "$log_state" != SE ] || now="is in special exit"
		       log_say "job $log_label was requeued (restart $log_restart) and $now; run sq log $log_label again for its new run" ;;
	esac
	exit 0
}

sub_log() {
	local a v positional=0 idraw= idset=0 job task= off=
	log_want=out log_follow=1 log_lines=(-n +1)
	while [ $# -gt 0 ]; do
		a=$1; shift
		if [ $positional = 0 ]; then
			case $a in
				-e|--err)    log_want=err; continue ;;
				--no-follow) log_follow=0; continue ;;
				-h|--help)   log_help; exit 0 ;;
				--)          positional=1; continue ;;
				-n|-n*)
					if [ "$a" = -n ]; then
						[ $# -gt 0 ] || log_usage "-n needs a number of lines, e.g. sq log -n 20 12345"
						a=$1; shift
					else a=${a#-n}; fi
					case $a in
						''|*[!0-9]*|??????????*)
							log_usage "-n needs a number of lines, not '$(printf '%s' "$a" | scrub 40)'; e.g. sq log -n 20 12345" ;;
					esac
					log_lines=(-n $((10#$a))); continue ;;
				--err=*|--no-follow=*|--help=*)
					log_usage "${a%%=*} takes no value; write it on its own, e.g. sq log ${a%%=*} 12345" ;;
				-?*) log_usage "'$(printf '%s' "$a" | scrub 40)' is not an option of sq log (sq log -h lists them); e.g. sq log -n 20 --err 12345" ;;
			esac
		fi
		[ $idset = 0 ] || log_usage "one job at a time, not '$(printf '%s' "$idraw" | scrub 40)' and '$(printf '%s' "$a" | scrub 40)'; e.g. sq log 12345"
		idraw=$a idset=1
	done
	[ $idset = 1 ] || log_usage "which job? e.g. sq log 12345"
	# 12345, an array task 12345_4 or a het component 12345+1, base 10; 0 and
	# the empty id are refused, as squeue would answer them with every job
	if [[ $idraw =~ ^([0-9]{1,10})(_([0-9]{1,7}))?$ ]]; then
		job=$((10#${BASH_REMATCH[1]})); [ -z "${BASH_REMATCH[3]}" ] || task=$((10#${BASH_REMATCH[3]}))
	elif [[ $idraw =~ ^([0-9]{1,10})[+]([0-9]{1,4})$ ]]; then
		job=$((10#${BASH_REMATCH[1]})) off=$((10#${BASH_REMATCH[2]}))
	else job=0
	fi
	if [ "$job" -lt 1 ] || [ "$job" -gt 4294967293 ] || { [ -n "$task" ] && [ "$task" -gt 4000000 ]; }; then
		log_usage "'$(printf '%s' "$idraw" | scrub 40)' is not a job id; e.g. sq log 12345, an array task 12345_4 or a het job's component 12345+1"
	fi
	log_label=$job${task:+_$task}${off:++$off}
	[ -z "${SLURM_CLUSTERS+set}" ] || log_refuse_cluster SLURM_CLUSTERS
	# following needs GNU tail: -F to wait out a file that is replaced,
	# --pid and --max-unchanged-stats (8.28 or newer)
	if [ $log_follow = 1 ]; then
		v=$(env LC_ALL=C tail --version 2>/dev/null); v=${v%%$'\n'*}
		[[ $v =~ ^tail\ \(GNU\ coreutils\)\ ([0-9]+)\.([0-9]+) ]] &&
			{ [ "${BASH_REMATCH[1]}" -gt 8 ] || { [ "${BASH_REMATCH[1]}" = 8 ] && [ "${BASH_REMATCH[2]}" -ge 28 ]; }; } ||
			log_fail "following needs GNU tail; use --no-follow"
	fi
	trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
	unset $(exported_names 'SQUEUE_*')
	nonce=$(mint_nonce) || die "no usable random field separator"
	export SQ_NONCE=$nonce
	log_fmt=
	for v in $log_fields; do log_fmt="$log_fmt${log_fmt:+,}$v:$nonce"; done
	# The clock: a tick a second is a read on a FIFO of its own, which nothing
	# writes, so no process sleeps.  The sentinel is what tail's --pid
	# watches: killing it ends the stream, and it ends itself, removing $tmp,
	# within a second of sq being killed outright, so it starts before the
	# first Slurm call
	make_tmp
	mkfifo "$tmp/nap" && exec {log_nap}<> "$tmp/nap" || log_fail "cannot make a timer FIFO in $tmp"
	{ while kill -0 $$ 2>/dev/null; do read -t 1 -u "$log_nap"; done; rm -rf "$tmp"; } &
	log_sentinel_pid=$! log_tail_pid=; log_pids=$log_sentinel_pid
	local doing=following; [ $log_follow = 1 ] || doing=showing

	# the first answer: the record to follow, or why there is none.  A het
	# job's output is its leader's (offset 0), the only component that runs
	# the script; a component named by its own id is asked about again by
	# its het job's id, as only that brings the leader along
	local asked=$job qid=$log_label how=job het=
	[ -z "$task" ] || how=task
	[ -z "$off" ] || { how=het; [ "$off" = 0 ] || het=$job; }
	log_ask "$qid" $how "$job" "$task"
	if [ "$log_verdict" = leader ]; then
		het=$log_leader qid=$log_leader how=het job=$log_leader
		log_ask "$qid" het "$job"
	fi
	case $log_verdict in
		notask)   # its array may be known: then which tasks it has
			log_ask "$asked" tasks "$asked"
			[ "$log_verdict" != tasks ] ||
				log_fail "Slurm does not know task $log_label; array $asked has tasks $log_list"
			[ "$log_verdict" = fail ] || log_verdict=none ;;
		array)  log_usage "$asked is an array; name a task, e.g. sq log ${asked}_$log_first (its tasks: $log_list)" ;;
		nothet) log_usage "$asked is not a het job, so $log_label names no component of one; e.g. sq log $asked" ;;
	esac
	[ "$log_verdict" != fail ] || log_fail "slurm unreachable · $log_why"
	[ "$log_verdict" = ok ] ||
		log_fail "Slurm does not know job $log_label (it ended more than about 5 minutes ago, or never existed), so its output path is unknown"
	case $log_via in
		last) log_note last "job $log_label is task ${asked}_$log_tid of an array; $doing it" ;;
		het)  het=$log_leader qid=$log_leader how=het job=$log_leader ;;
	esac
	[ -z "$het" ] ||
		log_note het "job $log_label belongs to het job $het, whose leader $het+0 writes its output; $doing that"
	log_resolve
	log_classify "$log_state"
	local baseline=$log_restart

	if [ $log_follow = 0 ]; then
		case $log_kind in
			wait|requeue|held) log_fail "job $log_label has not started yet" ;;
		esac
		if ! log_readable; then
			[ $log_kind = final ] && log_fail "job $log_label ended; $log_path was never written"
			log_fail "$log_path was not written yet (job $log_label runs on $log_host)"
		fi
		log_dump
		[ $log_kind != final ] || { log_state_name "$log_state"
			log_say "job $log_label ended: $log_sname${log_exit:+ (exit code $log_exit)}"; }
		exit 0
	fi
	[ $log_kind != final ] || log_finish final    # already over: shown as it is

	# The loop, Slurm asked every 5th tick
	local tick=0 started=0 waited=0 grace=-1 ending= reason
	while :; do
		if [ -z "$ending" ] && [ $tick -gt 0 ] && [ $((tick % 5)) = 0 ]; then
			log_ask "$qid" $how "$job" "$task"
			case $log_verdict in
				ok)   log_classify "$log_state"
				      # a requeue counts once the job has run in this follow, or
				      # when RestartCnt rose; seen pending, it is still waiting
				      if [ $log_kind = held ] && [ $started = 1 ]; then ending=held
				      elif [ "$log_restart" -gt "$baseline" ] 2>/dev/null; then ending=requeue
				      elif [ $log_kind = requeue ] && [ $started = 1 ]; then ending=requeue
				      elif [ $log_kind = final ]; then ending=final
				      fi ;;
				fail) log_note unreachable "slurm unreachable ($log_why); still following" ;;
				*)    ending=gone ;;
			esac
			[ -z "$ending" ] || grace=3
		fi
		if [ -z "$ending" ]; then
			case $log_kind in
				wait|requeue|held)   # a reason of None says nothing
				      case $log_reason in ''|None) reason= ;; *) reason=" ($log_reason)" ;; esac
				      log_note pending "job $log_label is pending$reason; waiting for it to start" ;;
				run)  if [ $started = 0 ]; then         # the path as the job computed it
				          started=1; log_resolve
				      fi
				      if [ -z "$log_tail_pid" ]; then
				          if log_readable; then
				              { tail "${log_lines[@]}" -F -s 1 --max-unchanged-stats=1 --pid="$log_sentinel_pid" \
				                  -- "$log_path" 2> "$tmp/tail.err" & } 2>/dev/null
				              log_tail_pid=$!; log_pids="$log_tail_pid $log_sentinel_pid"
				          elif [ $((waited += 1)) -ge 10 ]; then
				              log_note appear "waiting for $log_path to appear (job $log_label runs on $log_host)"
				          fi
				      fi ;;
			esac
		fi
		# tail gone on its own: a reader gone, a write error, a failure
		if [ -n "$log_tail_pid" ] && ! kill -0 "$log_tail_pid" 2>/dev/null; then
			{ wait "$log_tail_pid"; } 2>/dev/null; local rc=$?
			log_pids=$log_sentinel_pid log_tail_pid=   # reaped: its pid is no longer ours
			log_tail_verdict $rc; exit 0
		fi
		[ $grace != 0 ] || log_finish "$ending"
		[ $grace -lt 0 ] || grace=$((grace - 1))
		read -t 1 -u "$log_nap"
		tick=$((tick + 1))
	done
}

# ============================================================================
# sq job JOBID: one job, its efficiency once it ended; an array's summary
# ============================================================================
# Franz's decisions (2026-10-20): grouped sections (state and times,
# resources, files, efficiency), the efficiency as compact CPU and MEM bar
# lines; peak memory is the largest step's total; a bare array id is one
# summary over its COMPLETED tasks (median, min with its task, max); a running
# job shows memory only, and only the caller's own, as the dashboard's MEM
# reads it; CPU per step the larger of TotalCPU and Slurm's polled figure;
# SQ_PSS_SINCE a setting, off by default; het jobs refused for now.
# The facts: one squeue --jobs=ID -t all (the live state, reason, dependency,
# start estimate, time left and output paths, while Slurm knows the job), one
# sacct -j ID without -X (request, allocation, the steps' CPU time and memory,
# the exit, the time limit, the node lost, and the job itself once squeue
# forgot it), asked at once, then what the why section needs (job_why_start)
# while sacct is still asked, and for the caller's own running job JOBMEM's
# reading.  One source down: the other's view, with a dim line saying which;
# both: rc 1.
job_help() {
	cat <<'EOF'
usage: sq job [--color|--no-color] JOBID

One job in one report: its state and times, the CPUs and memory it asked for
and was given, its work directory and output files, and once it ended how
well it used them: its CPU time against CPUs x elapsed, and its peak memory
against its allocation.  While your own job runs, the memory it uses now, as
the dashboard's MEM reads it (? no reading yet, ! the reading failed).  JOBID
is 12345, an array task 12345_4, or an array 12345, which gets one summary
over its completed tasks: the median, the weakest task and the best.

Why: for a pending job, what holds it and who can act (it waits its turn,
needs action, waits for an admin, can never start, will never start, or is
stuck: a reason sq has no words for); for an ended one that did not
complete, its exit in plain words, who cancelled it, its time or memory
limit, the node it lost; for an array, its tasks that did not complete.  A
failed job's output ends the section with its last lines, for any job
whose file you can read, other users' too.

Exit 0 when shown, 1 when Slurm does not know the job or cannot be asked,
2 for a usage error, 128+N when stopped by signal N.

env: SQ_TIMEOUT    seconds to wait for Slurm (5); sq job waits 30 s for
                   accounting, which a big array keeps busy, unless
                   SQ_TIMEOUT is set to a valid number of seconds, which
                   then bounds that wait too.  Every call is done by that
                   wait and 5 s more
     SQ_PSS_SINCE  when this cluster's accounting moved from RSS to PSS
                   (JobAcctGatherParams=UsePss), as YYYY-MM-DD[ HH:MM[:SS]]
                   [ ZONE], YYYY-MM-DDTHH:MM[:SS]Z or @EPOCH, e.g.
                   SQ_PSS_SINCE="2026-10-19 15:59 CEST": a peak measured in a
                   step that started before it gets a note, as RSS counts
                   memory shared between processes once per process.  Unset,
                   or empty: no such note.

Good to know:
- CPU time per step is the larger of what its processes reported and what
  Slurm's sampling saw, so processes Slurm killed or never waited for count;
  sampled, it is still a lower bound.
- Peak memory is the largest step's: with several tasks, the sum of each
  task's own peak, an upper bound.  Sampling misses a short spike, so a job
  killed for its memory can read well below its limit.
- Efficiency comes from accounting, so it shows once accounting has recorded
  the job's end, a moment after squeue says it ended.
- Slurm forgets a job's output paths about 5 minutes after it ends, and its
  last lines with them.  They come from the last 4096 bytes of the file
  (its stderr when that has a file of its own), only from a regular file
  written while the job ran, and are cut to the terminal's width.
- That file is read by a process of its own, given 2 s: on a network mount
  that hangs, the process cannot be stopped, and it is the one process sq
  may leave behind.
- While accounting does not answer, an array's count is a floor (>=N): its
  done, failed and cancelled tasks are only known there.
EOF
}
# every message names sq job and is scrubbed whole: it carries ids, names and
# reasons, all of them outside text
job_say()   { printf 'sq job: %s\n' "$(printf '%s' "$1" | scrub)" >&2; }
job_usage() { job_say "$*"; exit 2; }          # the command line is wrong
job_fail()  { job_say "$*"; exit 1; }          # nothing to show
# SLURM_CLUSTERS, -M/--cluster(s), --federation and --sibling would ask another
# cluster, which neither sstat nor the snapshot JOBMEM shares can: one text
# per cause
job_refuse_cluster() {
	case $1 in
		SLURM_CLUSTERS) job_usage "sq job reads this cluster only; unset SLURM_CLUSTERS" ;;
		*) job_usage "sq job reads this cluster only; drop $1" ;;
	esac
}
# squeue -O fields: sq log's record (the path functions read theirs by these
# names) and what the report shows; sacct -o fields, the job name last
job_qfields="$log_fields Partition SubmitTime EndTime TimeLimit TimeLeft TimeUsed Dependency NumCPUs
	NumNodes tres-alloc NodeList UserID"
job_afields="JobID JobIDRaw UID User State ExitCode ElapsedRaw AllocCPUS ReqCPUS ReqTRES AllocTRES
	TotalCPU TRESUsageInTot TRESUsageInMax NTasks Submit Start End NodeList Partition WorkDir TimelimitRaw
	FailedNode JobName"
# SQ_PSS_SINCE, its epoch into job_pss (0: unset).  Only these forms, so a
# typo is an error, never a date GNU date makes of it ("1" is 01:00 today):
# YYYY-MM-DD[ HH:MM[:SS]][ ZONE], ZONE UTC, +HHMM or an abbreviation date
# knows; YYYY-MM-DDTHH:MM[:SS]Z; @EPOCH
job_pss_since() {
	local v=${SQ_PSS_SINCE:-} d='[0-9]{4}-[0-9]{2}-[0-9]{2}' t='[0-9]{2}:[0-9]{2}(:[0-9]{2})?'
	job_pss=0
	[ -n "$v" ] || return 0
	if [[ $v =~ ^$d(\ $t)?(\ (UTC|[+-][0-9]{4}|[A-Z]{2,5}))?$ || $v =~ ^${d}T${t}Z$ || $v =~ ^@[0-9]{1,12}$ ]] &&
		job_pss=$(env LC_ALL=C date -d "$v" +%s 2>/dev/null) && [[ $job_pss =~ ^[0-9]+$ ]]; then
		return 0
	fi
	job_pss=0
	job_usage "SQ_PSS_SINCE is no date sq job reads: '$(printf '%s' "$v" | scrub 40)'; e.g. SQ_PSS_SINCE=\"2026-10-19 15:59 CEST\", 2026-10-19T13:59Z or @1792418340"
}
# The report, a gawk program over the two answers (shared_awk and fname_awk
# before it)
read -r -d '' job_awk <<'JOBAWK'
function paint(c, s) { return (c == "") ? s : e(c) s e("0") }
function plural(n, w) { return n " " w (n == 1 ? "" : "s") }
function trim(s) { gsub(/^ +| +$/, "", s); return s }
function pct1(x) { return sprintf("%.1f%%", x) }
function stcode(st) { sub(/ .*/, "", st); return (st in SC) ? SC[st] : st }   # CANCELLED by 1025: CA
function stname(c) { return (c in LN) ? LN[c] : c }
function stcolour(c) { return (c == "R" || c == "CD") ? "32" : (c == "PD") ? "33" : (c in BAD) ? "31" : (c in DONE) ? "33" : "36" }
function isepoch(x) { return x ~ /^[0-9]+$/ && x + 0 > 0 }
function stamp(ep) { return strftime("%Y-%m-%d %H:%M", ep) }
function when(ep) { return stamp(ep) " (" (ep <= NOW ? ago(NOW - ep) " ago" : "in " ago(ep - NOW)) ")" }
# a number of a TRES text (cpu=2,mem=15600M,node=1, or a usage text in bytes):
# KEY= as a plain number, else -1
function tresnum(t, key,   m) { return match(t, "(^|,)" key "=([0-9]+)(,|$)", m) ? m[2] + 0 : -1 }
# the cpu= of a TRESUsageIn* text, D-HH:MM:SS, in seconds, else -1
function trescpu(t,   m) { return match(t, /(^|,)cpu=([^,]*)/, m) ? dur(m[2]) : -1 }
function stepname(id,   s) {
  s = substr(id, index(id, ".") + 1)
  return (s == "batch") ? "the batch script" : (s ~ /^[0-9]+$/) ? "step " s : s
}
# a bar of BARW cells, the dashboard's node bar over 0-100: █ to P (a share
# beyond 100 fills it), dim ▒ for the rest
function bar(p, hue) { return cells(100, p > 100 ? 100 : p, 100, BARW, hue) }
# CPU by waste, against what the CPUs allow (CAP, else 100): green from 70 % of
# it, yellow from 30 %, red below
function cpucolour(p, cap,   r) { r = p / (cap ? cap : 100); return (r >= 0.7) ? "32" : (r >= 0.3) ? "33" : "31" }
# one framed stream: records ending in NONCE "\n", the fields NAMES lists
# separated by NONCE, the first matching ANCHOR, into ARR[record, name] with
# every control character a "?" (they reach the terminal), and the field
# RAWNAME, when one is named, as it was before that into RAW[record]; the
# count, or -1 when a record is not whole (a field missing or too many, the
# end cut off)
function read_stream(file, nonce, names, ARR, anchor, RAW, rawname,   saved, n, nn, N, ln, f, i, bad) {
  nn = split(names, N, /[ \t\n]+/)
  saved = RS; RS = nonce "\n"
  while ((getline ln < file) > 0) {
    if (split(ln, f, nonce) != nn || RT == "" || f[1] !~ anchor) { bad = 1; break }
    n++; for (i = 1; i <= nn; i++) { if (N[i] == rawname) RAW[n] = f[i]; gsub(CNTRL, "?", f[i]); ARR[n, N[i]] = f[i] }
  }
  close(file); RS = saved
  return bad ? -1 : n + 0
}
# does a pending array's task expression (squeue's ArrayTaskID: a, a-b,
# a-b:step, comma-separated, maybe %throttle) hold task T?
function task_in(x, t,   p, np, i, m, a, b, s) {
  sub(/%[0-9]+$/, "", x); np = split(x, p, ",")
  for (i = 1; i <= np; i++) {
    if (!match(p[i], /^([0-9]+)(-([0-9]+)(:([0-9]+))?)?$/, m)) continue
    a = m[1] + 0; b = (m[3] != "") ? m[3] + 0 : a; s = (m[5] != "") ? m[5] + 0 : 1
    if (t >= a && t <= b && s >= 1 && (t - a) % s == 0) return 1
  }
  return 0
}

# ---- which records: the job's, a task's, or an array's -----------------------
# sacct: job_row[id] its job rows, row_by_unique_id[unique id] the same, step_row[id, k] / nsteps[id] the
# steps of each, task_row[k] / ntask_rows the rows of array JOB's tasks; squeue: array_record[k] / narray_records
# the records of array JOB.  The answer: het, array, none, or one (with qrow
# and arow, the job's squeue record and sacct row, either may be 0; inmeta
# when its record is a pending array's, which still holds the task)
function pick(   r, id, p, k) {
  for (r = 1; r <= na; r++) {
    id = A[r, "JobID"]
    if (index(id, "+")) het = 1
    if ((p = index(id, ".")) > 0) { k = substr(id, 1, p - 1); step_row[k, ++nsteps[k]] = r; continue }
    if (!(id in job_row)) job_row[id] = r
    if (!(A[r, "JobIDRaw"] in row_by_unique_id)) row_by_unique_id[A[r, "JobIDRaw"]] = r
    if (task == "" && index(id, job "_") == 1) task_row[++ntask_rows] = r
  }
  for (r = 1; r <= nq; r++) {
    if (R[r, "HetJobID"] != "N/A") het = 1
    if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] != "N/A") array_record[++narray_records] = r
  }
  if (het) return "het"
  if (task == "") {
    if (ntask_rows || narray_records) return "array"
    for (r = 1; r <= nq && !qrow; r++) if (R[r, "JobID"] == job) qrow = r
    arow = (job in job_row) ? job_row[job] : (job in row_by_unique_id) ? row_by_unique_id[job] : 0
  } else {
    for (r = 1; r <= nq && !qrow; r++)
      if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] == task) qrow = r
    for (r = 1; r <= nq && !qrow; r++)
      if (R[r, "ArrayJobID"] == job && task_in(R[r, "ArrayTaskID"], task)) { qrow = r; inmeta = 1 }
    arow = ((job "_" task) in job_row) ? job_row[job "_" task] : 0
  }
  if (!qrow && !arow) return "none"
  # the job as the title names it, its unique id (none for a task still in a
  # pending array's record), its state: squeue's while it knows the job
  if (arow) { jid = A[arow, "JobID"]; raw = A[arow, "JobIDRaw"] }
  else if (inmeta) { jid = job "_" task; raw = "" }
  else { jid = onetask(qrow) ? R[qrow, "ArrayJobID"] "_" R[qrow, "ArrayTaskID"] : R[qrow, "JobID"]; raw = R[qrow, "JobID"] }
  TASKS_EXPR = R[qrow, "ArrayTaskID"]               # the tasks its record holds (%N, a throttle)
  if (inmeta) R[qrow, "ArrayTaskID"] = task         # its paths are the task's
  STATE = qrow ? R[qrow, "StateCompact"] : stcode(A[arow, "State"])
  OWN = (myuid != "") && (qrow ? R[qrow, "UserID"] : A[arow, "UID"]) == myuid
  ALLOC = (qrow && !(STATE in DONE)) ? tres_mem(R[qrow, "tres-alloc"]) : arow ? tres_mem(A[arow, "AllocTRES"]) : qrow ? tres_mem(R[qrow, "tres-alloc"]) : -1
  NODES = qrow ? R[qrow, "NumNodes"] : tresnum(A[arow, "AllocTRES"], "node")
  return "one"
}

# ---- one job's efficiency, from its sacct row r and its steps, into eff_* -------
# CPU seconds of a step: the larger of TotalCPU (what the tasks' wait() and
# the last poll gave) and the polled TRESUsageInTot / TRESUsageInMax cpu=
# (Franz: "The larger of both"): TotalCPU misses processes Slurm killed or
# never waited for (11191: 0.008 s of a 12 h TIMEOUT, polled 2-19:40:01).
# eff_polled: a polled figure won somewhere
function stepcpu(s,   t, p) {
  t = dur(A[s, "TotalCPU"]); if (t < 0) t = 0
  p = trescpu(A[s, "TRESUsageInTot"]); if (trescpu(A[s, "TRESUsageInMax"]) > p) p = trescpu(A[s, "TRESUsageInMax"])
  if (p > t) { eff_polled = 1; return p }
  return t
}
# CPU efficiency = the steps' CPU seconds, summed and rounded to whole seconds
# as seff does, / (ElapsedRaw x AllocCPUS); no step rows: the job row's
# TotalCPU.  Memory efficiency = the largest step's TRESUsageInTot mem= (its
# tasks' peaks, summed: Franz's "Largest step total") / AllocTRES mem=.
# eff_cap: the share of the CPUs a program running one thread per requested CPU
# reaches, when more were allocated than requested; eff_rss: the peak step
# started before SQ_PSS_SINCE
function effcalc(id, r,   k, s, b) {
  eff_elapsed = A[r, "ElapsedRaw"] + 0; eff_cpus = A[r, "AllocCPUS"] + 0; eff_req_cpus = A[r, "ReqCPUS"] + 0
  eff_polled = 0
  if (nsteps[id]) { eff_cpu_sec = 0; for (k = 1; k <= nsteps[id]; k++) eff_cpu_sec += stepcpu(step_row[id, k]); eff_cpu_sec = int(eff_cpu_sec + 0.5) }
  else eff_cpu_sec = (dur(A[r, "TotalCPU"]) < 0) ? -1 : int(dur(A[r, "TotalCPU"]) + 0.5)
  eff_core_sec = eff_elapsed * eff_cpus
  eff_cpu_pct = (eff_core_sec > 0 && eff_cpu_sec >= 0) ? eff_cpu_sec / eff_core_sec * 100 : -1
  eff_alloc_mb = tres_mem(A[r, "AllocTRES"])
  eff_peak_bytes = -1; eff_peak_step = ""; eff_peak_tasks = 0; eff_peak_start = ""
  for (k = 1; k <= nsteps[id]; k++) {
    s = step_row[id, k]; b = tresnum(A[s, "TRESUsageInTot"], "mem")
    if (b > eff_peak_bytes) { eff_peak_bytes = b; eff_peak_step = A[s, "JobID"]; eff_peak_tasks = A[s, "NTasks"] + 0; eff_peak_start = A[s, "Start"] }
  }
  eff_rss = (pss > 0 && eff_peak_bytes >= 0 && isepoch(eff_peak_start) && eff_peak_start + 0 < pss)
  eff_mem_pct = (eff_alloc_mb > 0 && eff_peak_bytes >= 0) ? eff_peak_bytes / (eff_alloc_mb * 1048576) * 100 : -1
  eff_cap = (eff_req_cpus > 0 && eff_cpus > eff_req_cpus) ? eff_req_cpus / eff_cpus * 100 : 0
}
function captext(req, ncpu, cap) {
  return plural(req, "requested CPU") " became " ncpu ": a program running " plural(req, "thread") \
         " reaches at most " sprintf(cap >= 10 ? "%.0f" : "%.1f", cap) "%"
}
function pss_text() { return stamp(pss) " " strftime("%Z", pss) }
# the CPU and MEM lines: P as a bar and a share, then TAIL
function cpuline(p, cap, tail) { return "  CPU " bar(p, cpucolour(p, cap)) " " sprintf("%6s", pct1(p)) "  " tail }
function memline(p, hue, tail) { return "  MEM " bar(p, hue) " " sprintf("%6s", pct1(p)) "  " tail }
# accounting's failure, in place of what it would have shown
function acct_down() {
  if (astat == "timeout") return "accounting did not answer within " tmo "s"
  if (astat == "bad") return "accounting answered what cannot be read"
  return "accounting did not answer (" ENVIRON["SQJ_AWHY"] ")"
}

# ---- the model: key/value lines, raw lines and notes, by section -------------
function kv(sec, key, val) { M++; MT[M] = "kv"; MS[M] = sec; MK[M] = key; MV[M] = val }
function note(sec, text)   { M++; MT[M] = "note"; MS[M] = sec; MV[M] = text }
function line(sec, text)   { M++; MT[M] = "line"; MS[M] = sec; MV[M] = text }
# Franz's pick (2026-10-20): grouped sections, each under its dim caption, the
# keys aligned; the efficiency lines as they are, their notes at "  ↳", and a
# note elsewhere under the values
function print_sections(   i, w, cur) {
  printf "%s\n", TITLE
  for (i = 1; i <= M; i++) if (MT[i] == "kv" && length(MK[i]) > w) w = length(MK[i])
  for (i = 1; i <= M; i++) {
    if (MS[i] != cur) { cur = MS[i]; if (cur in SECNAME) printf "%s\n", paint("2", SECNAME[cur]) }
    if      (MT[i] == "kv")   printf "  %-*s  %s\n", w, MK[i], MV[i]
    else if (MT[i] == "line") printf "%s\n", MV[i]
    else if (MS[i] == "eff" || MS[i] == "arr" || MS[i] == "top" || MS[i] == "why") printf "  %s\n", paint("2", "↳ " MV[i])
    else                      printf "  %*s  %s\n", w, "", paint("2", "↳ " MV[i])
  }
}
# what one source being down means, under the title: the view is what the
# other one knows
function source_notes(final) {
  if (qstat == "fail") note("top", "squeue did not answer; shown from accounting")
  if (qstat == "bad")  note("top", "squeue answered what cannot be read; shown from accounting")
  if (astat != "ok" && !final) note("top", acct_down())
}

# ---- the efficiency section of one job -----------------------------------------
# None for a pending job; for a running one memory only, and only the caller's
# own (JOBMEM's reading: sstat answers only a job's owner); once it ended, CPU
# and memory from accounting, when accounting has recorded the end
function eff_job(c, q, r,   reading, use_pct, mark, cell, at) {
  if (c == "PD") return
  if (!(c in DONE)) {
    if (!OWN || c != "R") return
    reading = mem_outcome(raw, ALLOC, NODES)
    if (reading == "ok") {
      use_pct = job_bytes[raw] / (ALLOC * 1048576) * 100
      line("eff", memline(use_pct, memcolour(use_pct), trim(memcell(job_bytes[raw], ALLOC, "", 0)) " now"))
    } else {                                   # the mark, dim (no reading) or red (failed)
      mark = (reading == "failed") ? "!" : "?"
      cell = (ALLOC > 0) ? trim(memcell(0, ALLOC, mark, 0)) : mark; at = index(cell, mark)
      cell = substr(cell, 1, at - 1) paint(mark == "!" ? "31" : "2", mark) substr(cell, at + 1)
      line("eff", "  MEM " cells(0, -1, 100, BARW, "") " " sprintf("%6s", "") "  " cell " now")
    }
    note("eff", "CPU efficiency comes when the job ends")
    return
  }
  if (astat != "ok") { note("eff", acct_down()); return }
  if (never_started(q, r)) { note("eff", "it never started"); return }
  if (!r || !(stcode(A[r, "State"]) in DONE)) { note("eff", "accounting has not recorded its end yet"); return }
  effcalc(jid, r)
  if (eff_cpu_pct >= 0) line("eff", cpuline(eff_cpu_pct, eff_cap, elap(eff_cpu_sec) " of " elap(eff_core_sec)))
  if (eff_mem_pct >= 0)
    line("eff", memline(eff_mem_pct, c == "OOM" ? "1;31" : memcolour(eff_mem_pct), trim(memcell(eff_peak_bytes, eff_alloc_mb, "", 0)) " peak (" stepname(eff_peak_step) ")"))
  if (eff_cap) note("eff", captext(eff_req_cpus, eff_cpus, eff_cap))
  if (eff_polled) note("eff", POLLED)
  if (c == "OOM") note("eff", "OUT_OF_MEMORY: it hit its " memsize(eff_alloc_mb, 0) " limit between two samples; the peak shown is too low")
  if (eff_rss) note("eff", stepname(eff_peak_step) " started before " pss_text() \
                  " (RSS accounting): memory shared between processes counted once per process; the peak may read high")
  if (eff_peak_tasks > 1) note("eff", stepname(eff_peak_step) " ran " eff_peak_tasks " tasks: its peak adds up each task's own peak, an upper bound")
}
# a job that ended without ever running: no CPUs, no start (cancelled or
# failed while pending); with squeue alone, no node
function never_started(q, r) {
  if (r) return A[r, "AllocCPUS"] + 0 == 0 || A[r, "Start"] == "None" || A[r, "Start"] == "Unknown"
  return R[q, "NodeList"] == ""
}

# ---- sq job ID: one job, or one task -------------------------------------------
# the state line of an ended job: its exit, but for a NODE_FAIL job the node
# it lost, as a step Slurm killed with it (signal 9) would read as though the
# job had been killed
function ended_state(state, c, q, r) { return (c == "NF") ? state " on " failed_node(q, r) : state " · " exit_text(c) }
function failed_node(q, r) { return (r && A[r, "FailedNode"] != "") ? A[r, "FailedNode"] : q ? R[q, "NodeList"] : A[r, "NodeList"] }
function exit_text(c,   t, sg) {
  sg = JSG[jid] + 0; t = "exit " exlabel(JRC[jid] + 0, sg)
  if (sg == 0)   return t
  if (sg <= 31)  return t ": signal " sg ((sg in SIGNAME) ? " (" SIGNAME[sg] ")" : "")
  if (sg == 125) return t (c == "OOM" ? "" : ": out of memory")
  return t ": Slurm error" ((sg in SLERR) ? ", " SLERR[sg] : "")
}
function build_job(   q, r, c, final, never, name, user, unique, state, reason, dependency, start, submit,
                      left, ended, step, req_cpus, req_mb, req_text, alloc_cpus, limit, out, err) {
  q = qrow; r = arow; c = STATE
  final = (c in DONE); never = final && never_started(q, r)
  name = q ? R[q, "Name"] : A[r, "JobName"]; user = q ? R[q, "UserName"] : A[r, "User"]
  unique = (raw != "" && raw != jid) ? " " paint("2", "(unique id " raw ")") : ""
  TITLE = paint("1;36", "▌ ") paint("1", jid) unique "  " name " · " user
  source_notes(final)
  state = paint(stcolour(c), stname(c))
  if (c == "PD") {
    reason = q ? R[q, "Reason"] : ""
    kv("state", "state", state (reason != "" && reason != "None" ? " (" reason ")" : ""))
    dependency = q ? R[q, "Dependency"] : ""
    if (dependency != "" && dependency != "(null)") kv("state", "dependency", dependency)
    start = q ? R[q, "StartTime"] : ""             # a pending job's: Slurm's estimate
    kv("state", "start", (isepoch(start) && start + 0 > NOW) ? when(start) ", Slurm's estimate" : "no estimate yet")
    submit = q ? R[q, "SubmitTime"] : A[r, "Submit"]
    if (isepoch(submit)) kv("state", "submitted", when(submit))
  } else if (!final) {
    kv("state", "state", state " on " (q ? R[q, "NodeList"] : A[r, "NodeList"]) " (" (q ? R[q, "Partition"] : A[r, "Partition"]) ")")
    if (q) {
      left = R[q, "TimeLeft"]
      left = (left == "UNLIMITED") ? "no time limit" : (left == "INVALID") ? "past its time limit" \
           : elap(dur(left)) " left of " elap(dur(R[q, "TimeLimit"]))
      kv("state", "time", elap(dur(R[q, "TimeUsed"])) " elapsed · " left)
    } else kv("state", "time", elap(A[r, "ElapsedRaw"] + 0) " elapsed")
    start = q ? R[q, "StartTime"] : A[r, "Start"]
    if (isepoch(start)) kv("state", "started", when(start))
  } else {
    # the exit over the job row and its steps, as the finished block reads
    # it, while accounting has the end; else squeue's
    if (r && (stcode(A[r, "State"]) in DONE)) {
      xcm(jid, A[r, "ExitCode"]); for (step = 1; step <= nsteps[jid]; step++) xcm(jid, A[step_row[jid, step], "ExitCode"])
      kv("state", "state", ended_state(state, c, q, r))
      if (!never) kv("state", "ran", elap(A[r, "ElapsedRaw"] + 0) " on " A[r, "NodeList"] " (" A[r, "Partition"] ")")
      ended = A[r, "End"]
    } else {
      xcm(jid, R[q, "exit_code"], 1)
      kv("state", "state", ended_state(state, c, q, r))
      if (!never) kv("state", "ran", elap(dur(R[q, "TimeUsed"])) " on " R[q, "NodeList"] " (" R[q, "Partition"] ")")
      ended = R[q, "EndTime"]
    }
    if (isepoch(ended)) kv("state", "ended", when(ended))
  }
  OWNER = user; OWNER_UID = q ? R[q, "UserID"] : A[r, "UID"]
  build_why(c, q, r)

  # resources: a pending job's request (or one that never ran), else what it
  # was given and asked for.  The memory a running job uses is the
  # efficiency section's, not repeated here
  if (c == "PD" || never) {
    req_cpus = (r && (never || !q)) ? A[r, "ReqCPUS"] : R[q, "NumCPUs"]   # squeue's NumCPUs: the request, while pending
    kv("res", "CPUs", req_cpus " requested")
    req_mb = (r && (never || !q)) ? tres_mem(A[r, "ReqTRES"]) : tres_mem(R[q, "tres-alloc"])
    if (req_mb > 0) kv("res", "memory", memsize(req_mb, 0) " requested")
    limit = q ? R[q, "TimeLimit"] : ""
    if (c == "PD" && limit != "") kv("res", "time limit", (limit == "UNLIMITED") ? "none" : elap(dur(limit)))
  } else {
    alloc_cpus = r ? A[r, "AllocCPUS"] + 0 : R[q, "NumCPUs"] + 0; req_cpus = r ? A[r, "ReqCPUS"] + 0 : 0
    kv("res", "CPUs", alloc_cpus " allocated" ((req_cpus && req_cpus != alloc_cpus) ? " (" req_cpus " requested)" : ""))
    # the cap note: the efficiency section says it once the job ended
    if (req_cpus && alloc_cpus > req_cpus && !final) note("res", captext(req_cpus, alloc_cpus, req_cpus / alloc_cpus * 100))
    req_mb = r ? tres_mem(A[r, "ReqTRES"]) : -1
    req_text = (req_mb > 0 && req_mb != ALLOC) ? " (" memsize(req_mb, 0) " requested)" : ""
    if (!final && !OWN && ALLOC > 0) kv("res", "memory", memsize(ALLOC, 0) " allocated" req_text " · its use is shown to " user " only")
    else if (ALLOC > 0)              kv("res", "memory", memsize(ALLOC, 0) " allocated" req_text)
  }

  # files: from squeue's record while Slurm has it, else the work dir alone
  if (q) {
    kv("files", "work dir", R[q, "WorkDir"])
    if (R[q, "BatchFlag"] == "0") kv("files", "output", "its terminal (an interactive job)")
    else {
      out = fullpath(outpat(q), q); err = fullpath(errpat(q), q)
      kv("files", "stdout", out); kv("files", "stderr", (err == out) ? "into stdout" : err)
    }
  } else {
    kv("files", "work dir", A[r, "WorkDir"])
    kv("files", "output", (qstat == "none") ? "unknown: Slurm forgets a job's paths about 5 minutes after it ends" \
                                            : "unknown: squeue did not answer")
  }
  eff_job(c, q, r)
  print_sections()
}

# ---- sq job ARRAY: one summary over the tasks that completed -------------------
function median(V, n,   S, k) {
  k = asort(V, S, "@val_num_asc")
  return (k % 2) ? S[(k + 1) / 2] : (S[k / 2] + S[k / 2 + 1]) / 2
}
# a task, or K of them still in a pending array's record, counted by state C:
# done (COMPLETED), cancelled, failed (any other final state), pending, running
function count(c, k) {
  if (c == "CD") done += k; else if (c == "CA") canc += k; else if (c == "PD") pend += k
  else if (c in DONE) fail += k; else run += k
  total += k
}
function build_array(   i, r, id, c, k, ncv, nmv, CV, MV, cmin, cmax, mmin, mmax, cminid, mminid, rss, multi,
                        polled, name, user, cap, req, ncpu, mixed, st, cmed, mmed, why) {
  if (ntask_rows) {                                       # accounting: every task, and the figures
    for (i = 1; i <= ntask_rows; i++) {
      r = task_row[i]; id = A[r, "JobID"]
      if (name == "") { name = A[r, "JobName"]; user = A[r, "User"] }
      c = stcode(A[r, "State"])
      if (id ~ /\[/) {                             # tasks still in a pending array's record
        count((c == "CA") ? "CA" : (c in DONE) ? "F" : "PD", ntasks(id, ID)); continue
      }
      count(c, 1)
      if (c != "CD") continue                      # Franz: the statistics are the COMPLETED tasks'
      effcalc(id, r)
      if (eff_cpu_pct >= 0) {
        CV[++ncv] = eff_cpu_pct
        if (cmin == "" || eff_cpu_pct < cmin) { cmin = eff_cpu_pct; cminid = id }
        if (cmax == "" || eff_cpu_pct > cmax) cmax = eff_cpu_pct
      }
      if (eff_mem_pct >= 0) {
        MV[++nmv] = eff_mem_pct
        if (mmin == "" || eff_mem_pct < mmin) { mmin = eff_mem_pct; mminid = id }
        if (mmax == "" || eff_mem_pct > mmax) mmax = eff_mem_pct
      }
      rss += eff_rss; polled += eff_polled; multi += (eff_peak_tasks > 1)
      if (ncpu == "") { ncpu = eff_cpus; req = eff_req_cpus; cap = eff_cap }
      else if (ncpu != eff_cpus || req != eff_req_cpus) mixed = 1
    }
  } else                                           # the queue's records alone
    for (i = 1; i <= narray_records; i++) {
      r = array_record[i]
      if (name == "") { name = R[r, "Name"]; user = R[r, "UserName"] }
      k = onetask(r) ? 1 : ntasks(job "_[" R[r, "ArrayTaskID"] "]", ID)
      count(R[r, "StateCompact"], k)
    }
  for (i = 1; i <= narray_records && why == ""; i++)          # what the pending tasks wait for
    if (R[array_record[i], "StateCompact"] == "PD" && R[array_record[i], "Reason"] != "None") why = R[array_record[i], "Reason"]
  st = (done ? " · " done " done" : "") (fail ? " · " fail " failed" : "") (canc ? " · " canc " cancelled" : "") \
       (run ? " · " run " running" : "") (pend ? " · " pend " pending" : "")
  # Franz (#1): while accounting is missing, the done, failed and cancelled
  # tasks are, so the count is a floor and says why
  TITLE = paint("1;36", "▌ ") paint("1", job) "  " name " · " user " · array of " \
          ((!ntask_rows && astat != "ok") ? "≥" total " (accounting did not answer)" : total) (st != "" ? ": " substr(st, 4) : "")
  source_notes(1)
  if (ncv) cmed = median(CV, ncv)
  if (nmv) mmed = median(MV, nmv)
  if (ncv) line("arr", cpuline(cmed, cap, "median · min " pct1(cmin) " (" cminid ") · max " pct1(cmax) \
                ((!mixed && cap) ? " · " plural(ncpu, "CPU") " per task (" req " requested)" : "")))
  if (nmv) line("arr", memline(mmed, memcolour(mmed), "median · min " pct1(mmin) " (" mminid ") · max " pct1(mmax)))
  if (astat != "ok") note("arr", (!ntask_rows ? "done, failed and cancelled tasks are not counted: " : "") acct_down())
  else if (!done) note("arr", "no task has completed yet" (why != "" ? "; pending (" why ")" : ""))
  if (!mixed && cap) note("arr", captext(req, ncpu, cap))
  if (polled) note("arr", plural(polled, "task") ": " POLLED)
  if (done) note("arr", "over the " plural(done, "completed task") "; the weakest: sq job " cminid)
  if (rss) note("arr", plural(rss, "task") " started before " pss_text() \
                " (RSS accounting): shared memory counted once per process; their peaks may read high")
  if (multi) note("arr", plural(multi, "task") " peaked in a step of several tasks: that peak adds up each task's own, an upper bound")
  if (ntask_rows) why_array()
  print_sections()
}

# ---- why: plain words on why the job is where it is -----------------------------
# Franz's decisions (2026-10-21): a section of sq job for a pending job (what
# holds it) and an ended one (why it failed, who cancelled it), none for a
# running or a completed job, "Accept as rendered"; a failed job's last
# output lines for every job whose file is readable ("All jobs").  Under its
# dim caption the verdict comes first, its word coloured by who has to act,
# then rows indented 4 and notes at "  ↳"; only the output lines are cut to
# the width.  Beyond the two answers it reads what job_why_collect asked
# for: a dependency's parents, the nodes and the queue for a job waiting on
# resources, the names of who cancelled, and the output file's last lines
function wl(t)  { line("why", "  " t) }
function wl2(t) { line("why", "    " t) }
function wn(t)  { note("why", t) }
function put(key, value) { printf "%s=%s%c", key, value, 0 }
# the verdict, its word coloured: time alone fixes it (green), someone has to
# act or sq cannot tell (yellow), it never will (red)
function vword(kind, text,   word, hue) {
  word = (kind == "wait") ? "waits its turn" : (kind == "act") ? "needs action" : (kind == "admin") ? "waits for an admin" \
       : (kind == "never") ? "can never start" : (kind == "will") ? "will never start" : "stuck"
  hue = (kind == "wait") ? "32" : (kind == "never" || kind == "will") ? "31" : "33"
  return paint(hue, word) ": " text
}
# a uid as the reader knows it: you, root, a name (the owner's said so), the
# owner when getent named no one but the uid is the job's own, else the number
function who(uid, owner, owner_uid,   nm) {
  if (myuid != "" && uid == myuid) return "you"
  if (uid == "0") return "root (an admin, or Slurm itself)"
  nm = (uid in UMAP) ? UMAP[uid] : ""
  if (nm == "") return (owner_uid != "" && uid == owner_uid) ? "its owner" : "uid " uid
  return (nm == owner || uid == owner_uid) ? nm " (its owner)" : nm
}
function canceller(st,   m) { return match(st, /^CANCELLED by ([0-9]+)$/, m) ? m[1] : "" }
function signame(sg) {
  return "signal " sg ((sg in SIGNAME) ? " (" SIGNAME[sg] ((sg in SIGPLAIN) ? ", " SIGPLAIN[sg] : "") ")" : "")
}
function cancel_hint() {
  if (OWN) wn("Slurm keeps it pending all the same; remove it: scancel " jid)
  else     wn("Slurm keeps it pending all the same, until " OWNER " or an admin cancels it")
}
# a dependency clause, type:parent[_task|_*][+minutes](state), into m: 1 the
# type, 2 the parent, 4 its task or *, 6 the minutes, 7 the state
function depclause(c, m) { return match(c, /^([a-z]+):([0-9]+)(_([0-9]+|\*))?(\+([0-9]+))?\(([a-z]+)\)$/, m) }
# a job of the queue answer as the report names jobs: an array task N_T, a
# pending array's record N_[tasks], else its job id
function qjob(p,   t) {
  t = RQ[p, "ArrayTaskID"]
  if (t ~ /^[0-9]+$/) return RQ[p, "ArrayJobID"] "_" t
  if (t != "" && t != "N/A") return RQ[p, "ArrayJobID"] "_[" t "]"
  return RQ[p, "JobID"]
}

# ---- the plan, from squeue's record alone: which answers more the section
# needs, so the shell asks for them while accounting is still being asked
function why_plan(   q, reason, dep, n, cl, i, m, id, pl, pd, host, path, which) {
  if (verdict != "one" || !qrow) return
  q = qrow
  if (STATE == "PD") {
    reason = R[q, "Reason"]
    if (reason ~ /^(Resources|Priority|BadConstraints)$/) put("nodes", 1)
    if (reason ~ /^(Resources|Priority)$/) put("queue", 1)
    dep = R[q, "Dependency"]
    if (dep != "" && dep != "(null)") {
      n = split(dep, cl, /[,?]/)
      for (i = 1; i <= n; i++) if (depclause(cl[i], m)) {
        id = m[2] ((m[4] != "" && m[4] != "*") ? "_" m[4] : "")
        pl = pl (pl == "" ? "" : ",") id
        if (m[7] == "failed") pd = pd (pd == "" ? "" : ",") id
      }
      put("parents", pl); put("pdone", pd)
    }
  }
  # a failed batch job's output, its end: stderr when that has a file of its
  # own (errors land there), else stdout; only while squeue knows the paths,
  # and with the start and the end to judge the file's date by
  if (STATE != "F" || R[q, "BatchFlag"] == "0" || !isepoch(R[q, "StartTime"]) || !isepoch(R[q, "EndTime"])) return
  if (errpat(q) != outpat(q) && R[q, "STDERR"] != "/dev/null") { path = fullpath(errpat(q), q); which = "stderr" }
  else if (R[q, "STDOUT"] != "/dev/null") { path = fullpath(outpat(q), q); which = (R[q, "STDERR"] == "/dev/null") ? "stdout" : "output" }
  if (path == "") return
  host = R[q, "BatchHost"]; sub(/[.].*/, "", host)
  put("tail", path); put("which", which); put("start", R[q, "StartTime"]); put("end", R[q, "EndTime"]); put("host", host)
}
# the uids of who cancelled the job, a step or a task, for the shell to name
function why_uids(   r, by, seen, uids) {
  for (r = 1; r <= na; r++) if ((by = canceller(A[r, "State"])) != "" && !(by in seen)) { seen[by]; uids = uids " " by }
  put("uids", uids)
}

# ---- the extra answers, in the show phase
function why_load(   nu, um, i, mf, ln) {
  nu = split(ENVIRON["SQJ_UIDMAP"], um, ",")
  for (i = 1; i <= nu; i++) if (split(um[i], mf, "=") == 2) UMAP[mf[1]] = mf[2]
  npq = read_stream(ENVIRON["SQJ_WPARENTS"], NONCE, qfields, RP, "^[0-9]+$"); if (npq < 0) npq = 0
  npa = read_stream(ENVIRON["SQJ_WPACCT"], NONCE2, afields, AP, ID "([.][A-Za-z0-9_+.-]+)?$"); if (npa < 0) npa = 0
  nrq = read_stream(ENVIRON["SQJ_WQUEUE"], NONCE, ENVIRON["SQJ_WQFIELDS"], RQ, "^[0-9]+$"); if (nrq < 0) nrq = 0
  NODESTAT = ENVIRON["SQJ_WNODESTAT"]; NODEWHY = ENVIRON["SQJ_WNODEWHY"]; NODEFMT = ENVIRON["SQJ_WNODEFMT"]
  if (NODESTAT == "ok" && NODEFMT == "text") nodes_of_sinfo(ENVIRON["SQJ_WNODEFIG"], ENVIRON["SQJ_WNODES"], ENVIRON["SQJ_WNODEGATE"])
  else if (NODESTAT == "ok") node_json_read(ENVIRON["SQJ_WNODES"])
  while ((getline ln < ENVIRON["SQJ_WTAIL"]) > 0) TAIL[++ntail] = ln
  close(ENVIRON["SQJ_WTAIL"])
}

# Where Slurm has no usable --json: every figure sinfo can print from its
# own answer (FIG, read_stream, the dashboard's anchor), by name under the
# control rule, and from scontrol -o (FILE, node_read, about GATE's names)
# only CPUEfctv and MemSpecLimit.  A node's first row gives CPUAlloc and T
# (CPUsState's first and fourth figures), RealMemory (Memory), AllocMem and
# State (StateComplete in upper case, as scontrol prints it); every row adds
# its partition.  Rows of one name that differ outside PartitionName leave it
# "garbled", rows of two nodes that read as one name (their names differ
# before the control rule, as two such nodes are one name to scontrol too)
# "twice".  Its CPUs are CPUEfctv where scontrol's CPU run has one (above T:
# garbled), else T; a node scontrol gave no usable record of (none, not
# found, garbled, twice, the record before a forged one) is unknown
function nodes_of_sinfo(fig, file, gate,   SP_AT, SP_BAD, SP_CPUS, SP_EFCTV, SP_SPEC, SP_NF, n, nm, ns, SI, RAWN, r, i, j, c, T, RAW1, SIG1, sig, p) {
  node_read(file, gate)
  for (n = 1; n <= NN; n++) {
    nm = NODE_NAME[n]; SP_AT[nm] = n; SP_CPUS[n] = NODE_CPUS[n]; SP_EFCTV[n] = NODE_EFCTV[n]; SP_SPEC[n] = NODE_SPECMEM[n]
    if (n in NODE_BAD) SP_BAD[n] = NODE_BAD[n]
  }
  for (nm in NODE_NF) SP_NF[nm] = 1
  NN = 0; delete NODE_AT; delete NODE_BAD; delete NODE_NAME; delete NODE_CPUS; delete NODE_CPUALLOC; delete NODE_EFCTV
  delete NODE_REALMEM; delete NODE_ALLOCMEM; delete NODE_SPECMEM; delete NODE_STATE; delete NODE_PARTS
  ns = read_stream(fig, NONCE3, "CPUsState NodeList PartitionName Memory AllocMem StateComplete", SI, NODEID, RAWN, "NodeList")
  for (r = 1; r <= ns; r++) {
    nm = SI[r, "NodeList"]; p = SI[r, "PartitionName"]
    sig = SI[r, "CPUsState"] SUBSEP SI[r, "Memory"] SUBSEP SI[r, "AllocMem"] SUBSEP SI[r, "StateComplete"]
    if (!(nm in NODE_AT)) {
      i = NODE_AT[nm] = ++NN; NODE_NAME[i] = nm; RAW1[i] = RAWN[r]; SIG1[i] = sig
      split(SI[r, "CPUsState"], c, "/"); NODE_CPUALLOC[i] = node_num(c[1]); T[i] = node_num(c[4])
      NODE_REALMEM[i] = node_num(SI[r, "Memory"]); NODE_ALLOCMEM[i] = node_num(SI[r, "AllocMem"])
      NODE_STATE[i] = toupper(SI[r, "StateComplete"]); NODE_PARTS[i] = p
    } else {
      i = NODE_AT[nm]
      if (RAWN[r] != RAW1[i]) NODE_BAD[i] = "twice"
      else if (sig != SIG1[i] && !(i in NODE_BAD)) NODE_BAD[i] = "garbled"
      if (!index("," NODE_PARTS[i] ",", "," p ",")) NODE_PARTS[i] = NODE_PARTS[i] "," p
    }
    SIROW[nm, p] = 1
  }
  for (i = 1; i <= NN; i++) {
    nm = NODE_NAME[i]; NODE_CPUS[i] = NODE_SPECMEM[i] = -1
    if (!(nm in SP_AT) || (nm in SP_NF)) { if (!(i in NODE_BAD)) NODE_BAD[i] = "none"; continue }
    j = SP_AT[nm]
    if (j in SP_BAD) { if (SP_BAD[j] == "twice" || !(i in NODE_BAD)) NODE_BAD[i] = SP_BAD[j]; continue }
    NODE_SPECMEM[i] = SP_SPEC[j]
    NODE_CPUS[i] = SP_EFCTV[j] ? SP_CPUS[j] : T[i]
    if (SP_EFCTV[j] && SP_CPUS[j] > T[i] && !(i in NODE_BAD)) NODE_BAD[i] = "garbled"
  }
}
# The pair check (N6, the -o answer only): wherever a NodeName= line of
# scontrol's, a record or an unlisted line, holds a partitions run naming one
# of the job's partitions P, that line's node must have a row of sinfo's in P.
# A line that does not is forged (a node sinfo does not list, or not there),
# so none of the nodes is known: NODESTAT fail, NODEWHY naming the first such
# name in the answer's order, scrubbed and cut to 40 columns
function node_pair_fail(q,   P, np, k, PP, npp, j, x) {
  if (NODEFMT != "text" || NODESTAT != "ok") return 0
  np = split(R[q, "Partition"], P, ",")
  for (k = 1; k <= NODE_PAIRS; k++) {
    npp = split(NODE_PAIR_PARTS[k], PP, ",")
    for (j = 1; j <= npp; j++) for (x = 1; x <= np; x++)
      if (PP[j] == P[x] && !((NODE_PAIR_NAME[k], P[x]) in SIROW)) {
        NODESTAT = "fail"; NODEWHY = "scontrol lists " clip(NODE_PAIR_NAME[k], 40) " in " P[x] ", sinfo does not"
        NN = 0; return 1
      }
  }
  return 0
}

# ---- the section of one job, after its state and times
function build_why(c, q, r) {
  if (c == "PD") why_pending(q, r)
  else if (c == "RH" || c == "SE") why_requeue_held(c)
  else if (c in DONE) why_ended(c, q, r)
}
# a hold its owner can release: who can
function release_hint(v, text) {
  if (OWN) wl(vword(v, text "; it can start once you release it: scontrol release " jid))
  else     wl(vword(v, text "; only " OWNER " (or an admin) can release it"))
}
# a requeue that left the job held (RH) or in special exit (SE): its owner
# may release it, as a hold of their own (Slurm 23.11, job_mgr.c)
function why_requeue_held(c) {
  if (OWN) wl(vword("act", "held after a requeue" (c == "SE" ? " (special exit)" : "") ": scontrol release " jid))
  else     wl(vword("act", "held after a requeue" (c == "SE" ? " (special exit)" : "") "; only " OWNER " (or an admin) can release it"))
}

# ---- pending: the reason in plain words, and whether time alone fixes it.
# The verdict is the kind the dashboard files the reason under (pend_kind),
# its owner's hold "needs action", a fault of the cluster "waits for an
# admin"; the words only add the detail.  Dependency, Resources, Priority
# and BadConstraints look further: at the parents, the nodes and the queue
function why_pending(q, r,   reason, p, m, v) {
  if (!q) { wl(vword("stuck", "squeue did not answer, so its reason is unknown")); return }
  reason = R[q, "Reason"]; p = R[q, "Partition"]
  v = pend_kind(reason); v = (v == "own") ? "act" : (v == "fault") ? "admin" : v
  if (reason == "Dependency" || reason == "DependencyNeverSatisfied") why_dep(q, reason)
  else if (reason == "Resources" || reason == "Priority") why_res(q, reason)
  else if (reason == "BadConstraints") why_toobig(q)
  else if (reason == "JobHeldUser") release_hint(v, "on user hold")
  else if (reason ~ /requeued held$/) release_hint(v, "it failed to launch, so Slurm requeued it held")
  else if (reason ~ /^job requeued in /) release_hint(v, "it was requeued held")
  else if (reason == "JobHeldAdmin") wl(vword(v, "an admin held it; only an admin can release it"))
  else if (reason == "BeginTime")
    wl(vword(v, isepoch(R[q, "StartTime"]) && R[q, "StartTime"] > NOW ? "it asked not to start before " stamp(R[q, "StartTime"]) " (--begin)" \
                                                                      : "its begin time has passed; the scheduler starts it on a next pass"))
  else if (reason == "JobArrayTaskLimit")
    wl(vword(v, match(TASKS_EXPR, /%([0-9]+)$/, m) ? "its array runs at most " m[1] " tasks at once; this one starts when one of them ends" \
                                                   : "its array runs only so many tasks at once; this one starts when one of them ends"))
  else if (reason == "None")        wl(vword(v, "the scheduler has not looked at it yet"))
  else if (reason == "Prolog")      wl(vword(v, "its node runs the prolog; it is about to start"))
  else if (reason == "Cleaning")    wl(vword(v, "Slurm still cleans up after its previous run"))
  else if (reason == "SchedDefer")  wl(vword(v, "the scheduler defers new jobs to its next pass"))
  else if (reason == "Reservation") wl(vword(v, "its reservation has not begun"))
  else if (reason == "Licenses")    wl(vword(v, "the licenses it asks for are in use"))
  else if (reason in NEVERWHY)      wl(vword(v, sprintf(NEVERWHY[reason], p)))
  else if (reason ~ /^uid [0-9]+ not in group/) wl(vword(v, "its user may not use partition " p))
  else if (reason in FAULTWHY) wl(vword(v, sprintf(FAULTWHY[reason], p)))
  else if (reason ~ /^ReqNodeNotAvail/)
    wl(vword(v, "nodes it needs are not available" (match(reason, /UnavailableNodes:(.*)$/, m) ? ": " m[1] : (tolower(reason) ~ /reserved/ ? " (reserved)" : ""))))
  else if (reason ~ /^Nodes required for job are /) wl(vword(v, "nodes it needs are down, drained or reserved"))
  # a limit per job, or of minutes used, never frees up however many jobs end
  else if (reason ~ /^(QOS|Assoc)/ && v == "never") wl(vword(v, "it asks for more than a limit allows (" reason ")"))
  else if (reason ~ /^(QOS|Assoc)/) wl(vword(v, "a limit holds it (" reason ") until enough jobs under that limit end"))
  else wl(vword(v, "Slurm says " reason "; sq has no plain words for that"))
  if (v == "never" && reason !~ /^(Dependency|DependencyNeverSatisfied|BadConstraints)$/) cancel_hint()
  if (R[q, "RestartCnt"] + 0 > 0) wn("requeued " plural(R[q, "RestartCnt"] + 0, "time") " so far (a node failure, or scontrol requeue)")
}

# ---- Dependency: each parent, its condition and its state now
function depcond(i, form,   t, x, h) {      # FORM has, have (the lead line) or must (a row)
  t = DT[i]; h = (form == "must") ? "" : form " "
  if (form == "must")
    x = (t == "after") ? "start" : (t == "afterany") ? "end" : (t == "afterok") ? "complete successfully" : (t == "afternotok") ? "fail" \
      : (t == "aftercorr") ? "complete successfully, task by matching task" : (t == "afterburstbuffer") ? "end and stage out its burst buffer" : "meet " t
  else
    x = (t == "after") ? "started" : (t == "afterany") ? "ended" : (t == "afterok") ? "completed successfully" : (t == "afternotok") ? "failed" \
      : (t == "aftercorr") ? "completed successfully, task by matching task" : (t == "afterburstbuffer") ? "ended and staged out its burst buffer" : "met " t
  x = (form == "must" ? "must " : h) x
  if (DD[i] != "") x = x (form == "must" ? ", then " plural(DD[i] + 0, "minute") " more" : " and " plural(DD[i] + 0, "minute") " have passed")
  return x
}
function why_dep(q, reason,   dep, anyof, n, cl, i, m, nf, nu, never, same, ids, lead, idw, st) {
  dep = R[q, "Dependency"]
  if (dep == "" || dep == "(null)") {
    if (reason == "DependencyNeverSatisfied") { wl(vword("will", "a job it depends on ended the wrong way")); cancel_hint() }
    else wl(vword("wait", "its dependency is met now; the scheduler starts it on a next pass"))
    return
  }
  anyof = index(dep, "?") > 0
  n = split(dep, cl, /[,?]/); same = 1
  for (i = 1; i <= n; i++) {
    DT[i] = DP[i] = DD[i] = DS[i] = DSTAR[i] = ""
    if (depclause(cl[i], m)) {
      DT[i] = m[1]; DP[i] = m[2] ((m[4] != "" && m[4] != "*") ? "_" m[4] : ""); DD[i] = m[6]; DS[i] = m[7]
      DSTAR[i] = (m[4] == "*" || (m[4] == "" && is_array_parent(m[2])))
    } else if (match(cl[i], /^singleton\(([a-z]+)\)$/, m)) { DT[i] = "singleton"; DS[i] = m[1] }
    else { DT[i] = "raw"; DP[i] = cl[i] }
    if (DS[i] == "failed") nf++; else nu++
    if (DT[i] != DT[1] || DD[i] != DD[1] || DT[i] ~ /^(singleton|raw)$/) same = 0
    if (DT[i] != "raw" && length(DP[i]) > idw) idw = length(DP[i])
  }
  never = anyof ? (nu == 0) : (nf > 0)
  if (n == 1 && DT[1] == "singleton") {
    lead = "it may start once no other job of " (OWN ? "yours" : OWNER "'s") " named " R[q, "Name"] " runs or waits ahead of it"
    wl(vword(never ? "will" : "wait", lead)); if (never) cancel_hint(); return
  }
  if (same) {
    for (i = 1; i <= n; i++) ids = ids (i == 1 ? "" : (i == n ? (anyof ? " or " : " and ") : ", ")) (DSTAR[i] ? "every task of array " DP[i] : DP[i])
    lead = "it may start " (never ? "only " : "") "once " ids " " depcond(1, (n > 1 && !anyof) ? "have" : "has")
  } else lead = "it may start " (never ? "only " : "") "once " (anyof ? "one" : "all") " of these " (anyof ? "is" : "are") " met"
  wl(vword(never ? "will" : "wait", lead (never ? ", which can no longer happen" : "")))
  for (i = 1; i <= n; i++) {
    if (DT[i] == "singleton") { wl2(sprintf("%-*s  %s", idw, "", "no other job of " (OWN ? "yours" : OWNER "'s") " named " R[q, "Name"] " runs or waits ahead of it")); continue }
    if (DT[i] == "raw") { wl2(DP[i]); continue }
    st = DSTAR[i] ? array_state(DP[i]) : parent_state(DP[i])
    if (!same) st = depcond(i, "must") (DS[i] == "failed" ? ", which can no longer happen" : "") " · now " st
    wl2(sprintf("%-*s  %s", idw, DP[i], st))
  }
  if (never) cancel_hint()
}
# a parent's state now: squeue's record while it has one, else accounting's
function parent_state(pid,   p, a, c, x, left) {
  for (p = 1; p <= npq; p++)
    if (RP[p, "JobID"] == pid || (RP[p, "ArrayTaskID"] ~ /^[0-9]+$/ && RP[p, "ArrayJobID"] "_" RP[p, "ArrayTaskID"] == pid)) break
  if (p <= npq) {
    c = RP[p, "StateCompact"]
    if (c == "PD") return paint(stcolour(c), "PENDING") " (" RP[p, "Reason"] ")" (isepoch(RP[p, "StartTime"]) && RP[p, "StartTime"] > NOW ? " · Slurm's estimate: " when(RP[p, "StartTime"]) : " · no start estimate")
    if (c in DONE) {
      split(RP[p, "exit_code"], x, ":")
      return paint(stcolour(c), stname(c)) " · exit " exlabel(exfield(x[1]), exfield(x[2])) (isepoch(RP[p, "EndTime"]) ? " · ended " ago(NOW - RP[p, "EndTime"]) " ago" : "")
    }
    left = RP[p, "TimeLeft"]
    left = (left == "UNLIMITED") ? "no time limit" : (left == "INVALID") ? "past its time limit" : elap(dur(left)) " left of " elap(dur(RP[p, "TimeLimit"]))
    return paint(stcolour(c), stname(c)) " on " RP[p, "NodeList"] " · " left
  }
  for (a = 1; a <= npa; a++) if (AP[a, "JobID"] == pid) break
  if (a <= npa) {
    split(AP[a, "ExitCode"], x, ":"); c = stcode(AP[a, "State"])
    return paint(stcolour(c), stname(c)) ((c in DONE) ? " · exit " exlabel(exfield(x[1]), exfield(x[2])) (isepoch(AP[a, "End"]) ? " · ended " ago(NOW - AP[a, "End"]) " ago" : "") : "")
  }
  if (ENVIRON["SQJ_WPQ"] == "fail") return "unknown: squeue did not answer"
  return "Slurm no longer knows it"
}
# an array parent: does squeue answer task records for it?  Its tasks' states, counted
function is_array_parent(id,   p) {
  for (p = 1; p <= npq; p++) if (RP[p, "ArrayJobID"] == id && RP[p, "ArrayTaskID"] != "N/A") return 1
  return 0
}
function array_state(id,   p, c, k, N, ord, out, i) {
  for (p = 1; p <= npq; p++) {
    if (RP[p, "ArrayJobID"] != id || RP[p, "ArrayTaskID"] == "N/A") continue
    c = RP[p, "StateCompact"]; k = (RP[p, "ArrayTaskID"] ~ /^[0-9]+$/) ? 1 : ntasks(id "_[" RP[p, "ArrayTaskID"] "]", ID)
    if (!(c in N)) ord[++i] = c
    N[c] += k
  }
  for (k = 1; k <= i; k++) out = out (k == 1 ? "" : " · ") N[ord[k]] " " paint(stcolour(ord[k]), stname(ord[k]))
  if (out == "") return (ENVIRON["SQJ_WPQ"] == "fail") ? "unknown: squeue did not answer" : "Slurm no longer lists its tasks"
  return "its tasks now: " out
}

# ---- Resources, Priority, BadConstraints: the request against the nodes.
# A node's CPUs are CPUEfctv (CPUTot without it), its memory for jobs
# RealMemory less MemSpecLimit, and free is that less what is allocated
function node_jobmem(i) { return NODE_REALMEM[i] - NODE_SPECMEM[i] }
function node_cpufree(i) { return NODE_CPUS[i] - NODE_CPUALLOC[i] }
function node_memfree(i) { return node_jobmem(i) - NODE_ALLOCMEM[i] }
# the nodes its partitions hold, by index into the node answer, into USE[];
# none when the pair check finds a forged line
function usable_nodes(q,   i, k, nn, NP, pass) {
  nuse = 0
  if (node_pair_fail(q)) return
  for (i = 1; i <= NN; i++) {
    nn = split(NODE_PARTS[i], NP, ","); pass = 0
    for (k = 1; k <= nn; k++) if (index("," R[q, "Partition"] ",", "," NP[k] ",")) pass = 1
    if (pass) USE[++nuse] = i
  }
}
function node_down(i) { return NODE_STATE[i] ~ /DOWN|DRAIN|FAIL|NOT_RESPONDING|POWER/ }
function node_downword(i) { return (NODE_STATE[i] ~ /DRAIN/) ? "drained" : (NODE_STATE[i] ~ /DOWN|NOT_RESPONDING/) ? "down" : tolower(NODE_STATE[i]) }
# a node whose figures sq can use: listed once, with every number it reads
function node_known(i) {
  return !(i in NODE_BAD) && NODE_CPUS[i] >= 0 && NODE_CPUALLOC[i] >= 0 && NODE_REALMEM[i] >= 0 && NODE_ALLOCMEM[i] >= 0 && NODE_SPECMEM[i] >= 0
}
function node_big(i, rq_c, rq_m) { return NODE_CPUS[i] >= rq_c && (rq_m <= 0 || node_jobmem(i) >= rq_m) }
function node_fits(i, rq_c, rq_m) { return node_cpufree(i) >= rq_c && (rq_m <= 0 || node_memfree(i) >= rq_m) }
# the table: "free" (free now, of what jobs can get) or "total" (what jobs can get)
function node_table(q, how, rq_c, rq_m,   i, k, w, cw, mw, CT, MT, VT, hc, hm, fc, fm, fits_c, fits_m) {
  w = length("it asks")
  for (k = 1; k <= nuse; k++) { i = USE[k]; if (colw(NODE_NAME[i]) > w) w = colw(NODE_NAME[i]) }   # in columns
  CT[0] = rq_c ""; MT[0] = (rq_m > 0) ? memsize(rq_m, 0) : "-"; VT[0] = ""
  for (k = 1; k <= nuse; k++) {
    i = USE[k]
    if (!node_known(i)) { CT[k] = "?"; MT[k] = "?"; VT[k] = (i in NODE_BAD && NODE_BAD[i] == "twice") ? "unknown: scontrol listed it twice" : "unknown: scontrol did not say"; continue }
    fc = node_cpufree(i); fm = node_memfree(i)
    fits_c = (NODE_CPUS[i] >= rq_c); fits_m = (rq_m <= 0 || node_jobmem(i) >= rq_m)
    if (how == "total") { CT[k] = NODE_CPUS[i] ""; MT[k] = memsize(node_jobmem(i), 0) }
    else { CT[k] = fc " of " NODE_CPUS[i]; MT[k] = memsize(fm, 0) " of " memsize(node_jobmem(i), 0) }
    if (!fits_c || !fits_m) VT[k] = (how == "total" ? "" : "never fits: ") (!fits_c && !fits_m ? "too few CPUs, too little memory" : !fits_c ? "too few CPUs" : "too little memory")
    else if (node_down(i)) VT[k] = node_downword(i)
    else if (how == "total") VT[k] = "big enough"
    else if (fc >= rq_c && (rq_m <= 0 || fm >= rq_m)) VT[k] = "fits now"
    else VT[k] = (fc < rq_c && rq_m > 0 && fm < rq_m) ? "too few CPUs and too little memory free" : (fc < rq_c) ? "too few CPUs free" : "too little memory free"
    if (node_down(i) && (fits_c && fits_m)) { CT[k] = "-"; MT[k] = "-" }
  }
  for (k = 0; k <= nuse; k++) { if (length(CT[k]) > cw) cw = length(CT[k]); if (length(MT[k]) > mw) mw = length(MT[k]) }
  hc = (how == "total") ? "CPUs" : "CPUs free"; hm = (how == "total") ? "memory for jobs" : "memory free"
  if (length(hc) > cw) cw = length(hc); if (length(hm) > mw) mw = length(hm)
  wl2(paint("2", sprintf("%-*s  %*s  %*s", w, "", cw, hc, mw, hm)))
  wl2(sprintf("%-*s  %*s  %*s", w, "it asks", cw, CT[0], mw, MT[0]))
  for (k = 1; k <= nuse; k++) wl2(sprintf("%s  %*s  %*s  %s", colpad(NODE_NAME[USE[k]], -w), cw, CT[k], mw, MT[k], VT[k]))
}
# no node to show: why.  With an answer, none is in the partition; under -o
# that rests on sinfo's rows alone, and the note says so
function nodes_unknown_note(q) {
  if (NODESTAT != "ok") wn("the nodes are unknown: " NODEWHY)
  else if (NODEFMT == "text") wn("sinfo lists no node in partition " R[q, "Partition"])
  else wn("no node is in partition " R[q, "Partition"])
}
# Slurm's queue order (V9): the higher priority first, then the earlier
# submit, then the lower job id
function before(p, prio, submit, id) {
  if (RQ[p, "PriorityLong"] + 0 != prio) return RQ[p, "PriorityLong"] + 0 > prio
  if (RQ[p, "SubmitTime"] + 0 != submit) return RQ[p, "SubmitTime"] + 0 < submit
  return RQ[p, "JobID"] + 0 < id + 0
}
function why_res(q, reason,   rq_c, rq_m, k, i, ahead, AH, p, a, b, t, me, prio, submit, later, lead, nbig, nbigdown, nunknown, fitnow, idw, uw) {
  rq_c = R[q, "NumCPUs"] + 0; rq_m = tres_mem(R[q, "tres-alloc"])
  usable_nodes(q)
  if (reason == "Priority") {
    # its own priority as the queue answer gives it; submit time from its record
    for (me = 1; me <= nrq; me++) if (RQ[me, "JobID"] == raw) break
    prio = (me <= nrq) ? RQ[me, "PriorityLong"] + 0 : 0; submit = R[q, "SubmitTime"] + 0
    for (p = 1; p <= nrq; p++) {
      if (p == me || RQ[p, "StateCompact"] != "PD" || RQ[p, "Reason"] !~ /^(Resources|Priority)$/) continue
      if (!before(p, prio, submit, raw) || !share_nodes(RQ[p, "Partition"])) continue
      AH[++ahead] = p
    }
    for (a = 2; a <= ahead; a++)              # in that order
      for (b = a; b > 1 && before(AH[b], RQ[AH[b - 1], "PriorityLong"] + 0, RQ[AH[b - 1], "SubmitTime"] + 0, RQ[AH[b - 1], "JobID"]); b--) {
        t = AH[b]; AH[b] = AH[b - 1]; AH[b - 1] = t
      }
    # "submitted before it" while that is the whole story, the queue order
    # once a higher priority put a later job ahead
    for (k = 1; k <= ahead; k++) if (RQ[AH[k], "SubmitTime"] + 0 > submit) later = 1
    if (ahead) wl(vword("wait", plural(ahead, "job") (later ? " ahead of it in the queue " : " submitted before it ") (ahead == 1 ? "comes" : "come") " first"))
    else wl(vword("wait", "a job ahead of it in the queue comes first"))
    uw = 9                                      # the user: 9 columns, or its widest
    for (k = 1; k <= ahead && k <= 3; k++) {
      if (length(qjob(AH[k])) > idw) idw = length(qjob(AH[k]))
      if (colw(RQ[AH[k], "UserName"]) > uw) uw = colw(RQ[AH[k], "UserName"])
    }
    for (k = 1; k <= ahead && k <= 3; k++) {
      p = AH[k]
      wl2(sprintf("%-*s  %s %3s CPUs  %6s  %s (%s), submitted %s ago", idw, qjob(p), colpad(RQ[p, "UserName"], -uw), RQ[p, "NumCPUs"],
                  memsize(tres_mem(RQ[p, "tres-alloc"]), 0), paint(stcolour("PD"), "PENDING"), RQ[p, "Reason"], ago(NOW - RQ[p, "SubmitTime"])))
    }
    if (ahead > 3) wl2("… and " (ahead - 3) " more")
    if (ENVIRON["SQJ_WQUEUESTAT"] != "ok") wn("the jobs ahead are unknown: squeue did not answer")
    lead = "what the nodes it may use (" R[q, "Partition"] ") have free now:"
  } else {
    # a verdict of sq's own needs the figures: with a node it may use
    # unknown, or none known, what is free is Slurm's word, not sq's
    for (k = 1; k <= nuse; k++) {
      i = USE[k]
      if (!node_known(i)) { nunknown++; continue }
      if (!node_big(i, rq_c, rq_m)) continue
      if (node_down(i)) { nbigdown++; continue }
      nbig++
      if (node_fits(i, rq_c, rq_m)) fitnow = NODE_NAME[i]
    }
    if (fitnow != "") wl(vword("wait", "enough is free now on " fitnow "; Slurm should start it on a next pass"))
    else if (!nbig && nbigdown && !nunknown) wl(vword("admin", "every node big enough for it is down or drained"))
    else if (nunknown || NODESTAT != "ok") wl(vword("wait", "Slurm finds too little free now on the nodes it may use (" R[q, "Partition"] ")"))
    else wl(vword("wait", "too little is free now on the nodes it may use (" R[q, "Partition"] ")"))
  }
  if (!nuse) { nodes_unknown_note(q); return }
  if (lead != "") wl(lead)
  node_table(q, "free", rq_c, rq_m)
  if (R[q, "NumNodes"] + 0 > 1) wn("it asks for " R[q, "NumNodes"] " nodes; the table compares one")
  if (reason == "Resources") why_blockers(q, rq_c, rq_m)
}
function share_nodes(parts,   k, i, NP, nn, j) {
  for (k = 1; k <= nuse; k++) {
    i = USE[k]; nn = split(NODE_PARTS[i], NP, ",")
    for (j = 1; j <= nn; j++) if (index("," parts ",", "," NP[j] ",")) return 1
  }
  return 0
}
# which running jobs have to end first: on each node that can ever hold it,
# its jobs by end time (none: a year, as Slurm plans one without a limit)
# until enough is free; the node where that comes first.  sq's own
# reckoning, not Slurm's: it leaves out the jobs ahead and backfill
function why_blockers(q, rq_c, rq_m,   k, i, p, nj, J, E, a, b, t, fc, fm, best, bestt, BL, nbl, fin, end, est, unl, unlend, w, idw) {
  if (ENVIRON["SQJ_WQUEUESTAT"] != "ok") { wn("which jobs must end first is unknown: squeue did not answer"); return }
  for (k = 1; k <= nuse; k++) {
    i = USE[k]
    if (!node_known(i) || node_down(i) || !node_big(i, rq_c, rq_m)) continue
    if (node_fits(i, rq_c, rq_m)) return                          # it fits now: nothing to wait for
    fc = node_cpufree(i); fm = node_memfree(i)
    nj = 0; delete J; delete E
    for (p = 1; p <= nrq; p++)
      if (RQ[p, "StateCompact"] != "PD" && index("," RQ[p, "NodeList"] ",", "," NODE_NAME[i] ",")) {
        J[++nj] = p; end = RQ[p, "EndTime"]; E[nj] = isepoch(end) ? end + 0 : NOW + 365 * 86400
      }
    for (a = 2; a <= nj; a++) for (b = a; b > 1 && E[b] < E[b - 1]; b--) { t = E[b]; E[b] = E[b - 1]; E[b - 1] = t; t = J[b]; J[b] = J[b - 1]; J[b - 1] = t }
    fin = 0
    for (a = 1; a <= nj; a++) {
      fc += RQ[J[a], "NumCPUs"]; t = tres_mem(RQ[J[a], "tres-alloc"]); if (t > 0) fm += t
      if (fc >= rq_c && (rq_m <= 0 || fm >= rq_m)) { fin = a; break }
    }
    if (fin && (best == "" || E[fin] < bestt)) {
      best = i; bestt = E[fin]; nbl = fin; for (a = 1; a <= fin; a++) BL[a] = J[a]
    }
  }
  if (best == "") return
  wl("it needs " (nbl == 1 ? "this job" : "these jobs") " to end first, on " NODE_NAME[best] ":")
  for (a = 1; a <= nbl; a++) {
    p = BL[a]; if (colw(RQ[p, "UserName"]) > w) w = colw(RQ[p, "UserName"]); if (length(qjob(p)) > idw) idw = length(qjob(p))
  }
  for (a = 1; a <= nbl; a++) {
    p = BL[a]
    if (RQ[p, "TimeLimit"] == "UNLIMITED") { unl = unl (unl == "" ? "" : ", ") qjob(p); if (isepoch(RQ[p, "EndTime"]) && (unlend == "" || RQ[p, "EndTime"] + 0 < unlend)) unlend = RQ[p, "EndTime"] + 0 }
    wl2(sprintf("%-*s  %s %3s CPUs  %6s  %s", idw, qjob(p), colpad(RQ[p, "UserName"], -w), RQ[p, "NumCPUs"], memsize(tres_mem(RQ[p, "tres-alloc"]), 0),
                RQ[p, "TimeLimit"] == "UNLIMITED" ? "no time limit" : elap(dur(RQ[p, "TimeLeft"])) " left"))
  }
  est = R[q, "StartTime"]
  if (unl != "") wn((isepoch(est) && est > NOW && unlend != "" && est + 86400 >= unlend ? "Slurm's estimate is that far out because " : "") \
                    unl (index(unl, ",") ? " have" : " has") " no time limit: Slurm plans such a job to run for a year")
}
function why_toobig(q,   rq_c, rq_m, k, i, any, memshort, nunknown) {
  rq_c = R[q, "NumCPUs"] + 0; rq_m = tres_mem(R[q, "tres-alloc"])
  usable_nodes(q)
  for (k = 1; k <= nuse; k++) {
    i = USE[k]; if (!node_known(i)) { nunknown++; continue }
    if (node_big(i, rq_c, rq_m)) any = 1
    if (rq_m > 0 && node_jobmem(i) < rq_m && NODE_SPECMEM[i] > 0 && (!memshort || node_jobmem(i) > node_jobmem(memshort))) memshort = i
  }
  if (!nuse) {
    wl(vword("never", "no node it may use (" R[q, "Partition"] ") meets what it asks for"))
    nodes_unknown_note(q); cancel_hint(); return
  }
  if (any) wl(vword("never", "no node it may use (" R[q, "Partition"] ") meets its constraints (--constraint, --gres or the like)"))
  else     wl(vword("never", "no node it may use (" R[q, "Partition"] ")" (nunknown ? " whose figures are known" : "") " is that big"))
  node_table(q, "total", rq_c, rq_m)
  if (memshort) wn("memory for jobs is a node's RealMemory less what Slurm keeps for the system (MemSpecLimit): " \
                   memsize(NODE_REALMEM[memshort], 0) " less " memsize(NODE_SPECMEM[memshort], 0) " on " NODE_NAME[memshort])
  cancel_hint()
}

# ---- an ended job: who cancelled it, the exit in plain words, its last lines
function why_ended(c, q, r,   lim, el) {
  if (c == "CD") return
  if (c == "CA") { why_cancelled(q, r); return }
  if (c == "TO") {
    lim = q ? R[q, "TimeLimit"] : (r && A[r, "TimelimitRaw"] ~ /^[0-9]+$/) ? A[r, "TimelimitRaw"] * 60 "" : ""
    if (q && lim != "") lim = dur(lim) ""
    el = r ? A[r, "ElapsedRaw"] + 0 : dur(R[q, "TimeUsed"])
    wl("it reached its time limit" (lim != "" && lim + 0 >= 0 ? " of " elap(lim + 0) : "") " after " elap(el))
    return
  }
  if (c == "OOM") { wl("it used more than its " (ALLOC > 0 ? memsize(ALLOC, 0) " " : "") "memory limit, so the kernel killed it"); return }
  if (c == "NF") {
    wl("its node " failed_node(q, r) " failed while it ran")
    if (q && R[q, "BatchFlag"] == "0") wn("an interactive job is never requeued")
    else if (q && R[q, "RestartCnt"] + 0 > 0) wn("Slurm had requeued it " plural(R[q, "RestartCnt"] + 0, "time") " before")
    return
  }
  if (c == "DL") { wl("Slurm ended it: its deadline (--deadline) could no longer be met"); return }
  if (c == "PR") { wl("preempted: a job with a higher priority took its resources"); return }
  if (c == "BF") { wl("its node failed to boot"); return }
  if (c == "F")  why_failed(q, r)
}
function why_cancelled(q, r,   by, how, sub_, end) {
  by = r ? canceller(A[r, "State"]) : ""
  if (never_started(q, r)) {
    sub_ = r ? A[r, "Submit"] : R[q, "SubmitTime"]; end = r ? A[r, "End"] : R[q, "EndTime"]
    how = "while it was pending" (isepoch(sub_) && isepoch(end) && end >= sub_ ? ", " elap(end - sub_) " after it was submitted" : "")
  } else how = "after it ran " elap(r ? A[r, "ElapsedRaw"] + 0 : dur(R[q, "TimeUsed"]))
  if (by != "") wl("cancelled by " who(by, OWNER, OWNER_UID) " " how)
  else if (r && (stcode(A[r, "State"]) in DONE)) {
    wl("cancelled " how "; Slurm recorded no one")
    wn("it records no one when it cancels a job itself (a dependency that can never be met, with --kill-on-invalid-dep; a disabled scrontab entry)")
  } else wl("cancelled " how "; who did it shows once accounting has recorded the end")
}
function why_failed(q, r,   rc, sg, k, s, by, sname, rawrc, m, node) {
  rc = JRC[jid] + 0; sg = JSG[jid] + 0
  node = q ? R[q, "NodeList"] : r ? A[r, "NodeList"] : ""
  for (k = 1; k <= nsteps[jid] && by == ""; k++) { s = step_row[jid, k]; by = canceller(A[s, "State"]); sname = stepname(A[s, "JobID"]) }
  if (q && match(R[q, "exit_code"], /^([0-9]+):([0-9]+)$/, m) && m[2] + 0 == 0) rawrc = m[1] + 0
  if (by != "") wl(sname " was cancelled by " who(by, OWNER, OWNER_UID) (sg ? ", which ended the job with " signame(sg) : ""))
  else if (sg >= 1 && sg <= 31) wl("killed by " signame(sg))
  else if (sg > 31 && sg != 125) {
    wl(sg == 53 ? "its script never started: Slurm could not open its output file" : "Slurm error " sg ((sg in SLERR) ? ": " SLERR[sg] : ""))
    if (sg == 53) wn("e.g. -o or -e names a directory that does not exist, or one it may not write to")
  }
  else if (rawrc != "" && rawrc >= 129 && rawrc <= 159) {
    wl("exit " rawrc ": a command in it was killed by " signame(rawrc - 128))
    wn("a shell reports a command killed by signal N as exit 128+N; sacct will print exit " rawrc - 128 ", as it prints any exit above 128 less 128")
    if (rawrc == 132) wn("an illegal instruction often means a program built for a newer CPU than " node "'s")
  }
  else if (rawrc != "" && rawrc > 159) wl("exit " rawrc ": the program's own code" (rawrc == 255 ? " (exit(-1) is 255)" : "") "; its output may say what it means")
  else if (rc == 1)   wl("exit 1: the program reported an error itself; its output should say which")
  else if (rc == 2)   wl("exit 2: often a usage error (a wrong option or argument) or a shell syntax error")
  else if (rc == 126 || rc == 127) {
    wl(rc == 127 ? "exit 127: a command was not found (a typo, a module not loaded, or not on PATH)" : "exit 126: a command was found but could not be run (not executable)")
    if (rawrc == "") wn("or exit " rc + 128 ", the program's own code (exit(-1) is 255): sacct prints an exit above 128 less 128, so it cannot tell the two apart")
  }
  else if (rc >= 3 && rc <= 31 && rawrc == "") {
    wl("exit " rc " (or " rc + 128 ": a command killed by " ((rc in SIGNAME) ? SIGNAME[rc] ((rc in SIGPLAIN) ? ", " SIGPLAIN[rc] : "") : "signal " rc) ")")
    wn("sacct prints an exit above 128 less 128, so it cannot tell the two apart")
    if (rc == 4) wn("an illegal instruction often means a program built for a newer CPU than " node "'s")
  }
  else if (rc)        wl("exit " rc ": the program's own code; its output may say what it means")
  else                wl("Slurm marked it FAILED, but neither the job nor a step recorded an exit code")
  why_tail()
}
# its output's last lines, as the shell read them (bounded, scrubbed), or why
# there are none
function why_tail(   info, which, me, host, k) {
  info = ENVIRON["SQJ_WTAILINFO"]; which = ENVIRON["SQJ_WWHICH"]; me = ENVIRON["SQJ_WME"]; host = ENVIRON["SQJ_WHOST"]
  if (info == "") return
  if (info == "ok") {
    wl(paint("2", "its " which " ends with:"))
    for (k = 1; k <= ntail; k++) wl2(clip(TAIL[k], COLS - 4))
  }
  else if (info == "empty")      wn("its " which " is empty")
  else if (info == "blank")      wn("its " which " holds only blank lines")
  else if (info == "older")      wn("its " which " was last written before the job started, so it is not this run's; not shown")
  else if (info == "later")      wn("its " which " file was written after the job ended (a later run?)")
  else if (info == "notregular") wn("its " which " is not a regular file")
  else if (info == "hung")       wn("its " which " file did not answer within 2s")
  else if (info == "missing")    wn("its " which " is not there" (host != "" && host != me ? "; the job wrote it on " host : ""))
  else if (info == "unreadable") wn("its " which " cannot be read here")
  if ((info == "ok" || info == "empty" || info == "blank") && host != "" && me != "" && host != me) wn("read here on " me "; the job wrote it on " host)
}

# ---- an array: its tasks that did not complete, grouped by why
function why_array(   i, r, id, c, by, never, key, k, s, n, GN, GI, GK, a, b, t, first, x, m) {
  for (i = 1; i <= ntask_rows; i++) {
    r = task_row[i]; id = A[r, "JobID"]; c = stcode(A[r, "State"])
    if (c == "CD" || !(c in DONE)) continue
    if (c == "CA") {
      by = canceller(A[r, "State"]); never = (A[r, "AllocCPUS"] + 0 == 0 || A[r, "Start"] == "None" || A[r, "Start"] == "Unknown")
      key = "cancelled" (by != "" ? " by " who(by, A[r, "User"], A[r, "UID"]) : "") (never ? " while pending" : " while running")
    } else if (c == "F") {
      xcm(id, A[r, "ExitCode"])
      for (s = 1; s <= nsteps[id]; s++) xcm(id, A[step_row[id, s], "ExitCode"])
      x = JSG[id] + 0
      key = (x >= 1 && x <= 31) ? "failed by " signame(x) : (x > 31 && x != 125) ? "failed by Slurm error " x : "failed with exit " (JRC[id] + 0)
      if (first == "") first = id
    } else {
      key = (c == "OOM") ? "ran out of memory" : (c == "TO") ? "reached the time limit" : (c == "NF") ? "lost their node" : "ended " stname(c)
      if (first == "") first = id
    }
    if (!(key in GN)) GK[++n] = key
    GN[key] += ntasks(id, ID); if (GN[key] - ntasks(id, ID) < 3 || GI[key] == "") GI[key] = GI[key] (GI[key] == "" ? "" : ", ") id
    else if (GI[key] !~ /…$/) GI[key] = GI[key] ", …"
  }
  for (a = 2; a <= n; a++) for (b = a; b > 1 && (GK[b] !~ /^cancelled/ && GK[b - 1] ~ /^cancelled/ || \
                                               (GK[b] ~ /^cancelled/) == (GK[b - 1] ~ /^cancelled/) && GN[GK[b]] > GN[GK[b - 1]]); b--) {
    t = GK[b]; GK[b] = GK[b - 1]; GK[b - 1] = t
  }
  for (k = 1; k <= n; k++) wl(GN[GK[k]] " " GK[k] ": " GI[GK[k]])
  for (i = 1; i <= narray_records; i++) {          # the pending tasks, by the record that holds them
    r = array_record[i]
    if (R[r, "StateCompact"] != "PD" || onetask(r)) continue
    x = R[r, "Reason"]
    wl(ntasks(job "_[" R[r, "ArrayTaskID"] "]", ID) " pending: " \
       ((x == "JobArrayTaskLimit" && match(R[r, "ArrayTaskID"], /%([0-9]+)$/, m)) ? "the array runs at most " m[1] " tasks at once" : "Slurm's reason: " x))
  }
  if (first != "") wn("sq job " first " says more about one of them")
}

