# the columns S takes; under UTF-8 a string of ASCII and the glyphs of sq at
# once, its length
function colw(s,   t, n) {
  if (UTF8) {
    if (s !~ W_FAST) return length(s)
    n = length(s)
  } else { t = s; n = length(s) - gsub(W_CONT, "", t) }    # its lead bytes
  if (W_WIDE != "") { t = s; n += gsub(W_WIDE, "", t) }
  if (W_ZERO != "") { t = s; n -= gsub(W_ZERO, "", t) }
  return n
}
# S cut to COLS columns: S when it fits; "…" when COLS <= 1 (1 column even at
# COLS <= 0); else the longest start of whole units of at most COLS - 1
# columns, then "…", and nothing after it, so the text is COLS - g wide with
# g below the width of the first unit left out.  A unit starts at every
# character but a 0-width one, U+FE0F, an emoji modifier (U+1F3FB-1F3FF) and
# the one right after a ZWJ; the first always starts one.  A start of
# characters, so a split by characters of what it cut stays one
function clip(s, cols,   n, C, CW, i, j, k, w, uw, out, lead) {
  if (colw(s) <= cols) return s
  if (cols <= 1) return "…"
  if (UTF8 && s !~ W_FAST) return substr(s, 1, cols - 1) "…"
  if (UTF8) n = split(s, C, "")
  else for (i = 1; i <= length(s); i += length(C[n])) {
    lead = substr(s, i, 1)
    C[++n] = substr(s, i, lead < "\300" ? 1 : lead < "\340" ? 2 : lead < "\360" ? 3 : 4)
  }
  for (i = 1; i <= n; i++) CW[i] = colw(C[i])
  w = 0; out = ""
  for (i = 1; i <= n; i = j) {
    uw = CW[i]
    for (j = i + 1; j <= n; j++) {
      if (!(CW[j] == 0 || C[j] == W_VS16 || (C[j] >= W_MODLO && C[j] <= W_MODHI) || C[j - 1] == W_ZWJ)) break
      uw += CW[j]
    }
    if (w + uw > cols - 1) break
    w += uw
    for (k = i; k < j; k++) out = out C[k]
  }
  return out "…"
}
function spaces(k) { return (k > 0) ? sprintf("%*s", k, "") : "" }
