  if (grp_alloc_text[g] == "") grp_alloc_text[g] = row_alloc_text[r]
  if (row_outcome[r] == "failed") grp_failed[g] = 1
  if (row_outcome[r] == "ok") {
    grp_read_bytes[g] += row_bytes[r]; grp_read_alloc_mb[g] += row_alloc_mb[r]
    p = row_bytes[r] / (row_alloc_mb[r] * 1048576) * 100
