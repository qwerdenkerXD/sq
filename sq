function memform_cell(g, form,   mark, markcolour, colour, text, at) {
  mark = (g in grp_worst_pct) ? "" : grp_failed[g] ? "!" : "?"
  markcolour = (mark == "!") ? "31" : "2"
  if (mark == "") {
    colour = memcolour(grp_worst_pct[g])
    text = (form == "alloc") ? grp_alloc_text[g] \
         : memcell(grp_read_bytes[g], grp_read_alloc_mb[g], "", form == "whole")
    cell_text[g, form] = text; cell_coloured[g, form] = e(colour) text e("0")
  } else if (!grp_alloc_unknown[g] && grp_alloc_mb[g] > 0) {   # known: after the mark
    text = (form == "alloc") ? mark grp_alloc_text[g] : memcell(0, grp_alloc_mb[g], mark, form == "whole")
    at = index(text, mark)
    cell_text[g, form] = text
    cell_coloured[g, form] = substr(text, 1, at - 1) e(markcolour) mark e("0") substr(text, at + 1)
  } else {                                      # unknown: the mark, then MEM as ever
    cell_text[g, form] = mark mem_as_ever[g]
