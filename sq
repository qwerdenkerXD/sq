  tenths = int(alloc_mb * 10 / mb_per_unit)    # the allocation in tenths, cut
  if (alloc_mb % mb_per_unit == 0)  alloc_shown = sprintf("%d", alloc_mb / mb_per_unit)
  else if (whole && tenths >= 100) { alloc_shown = sprintf("%d", int(tenths / 10)); cut = 1 }
  else                              { alloc_shown = sprintf("%.1f", tenths / 10); decimal = 1 }
  pad = length(alloc_shown) + (decimal ? 1 : 2)
