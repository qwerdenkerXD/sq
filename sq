#!/usr/bin/env bash
# sq - auto-fitting Slurm dashboard
#
#   sq                      default columns
#   sq -o i,j,T,M,P,N       custom columns (squeue field letters, %/widths ignored)
#   sq -u "$USER" -p gpu    filters go to squeue, by the names squeue documents
#                           also forwarded: --all --hide --array --noconvert
#                           --noheader --priority --federation --local --sibling
#                           refused: -O --Format -s --steps -i --iterate -l -v
#                           -V --json --yaml, each of which would replace or
#                           defeat the output sq parses
#   sq -c / -C              centre horizontally / in both axes; vertically
#                           only on a screen (a terminal, or watch), and only
#                           while the dashboard is at least two lines shorter
#   sq -x                   expand array tasks instead of folding them; a pending
#                           bracket squeue prints (9008_[4-9] x6) stays one row,
#                           which only --array splits
#   sq --no-recent          hide the recently-finished block
#   sq --no-bell            never ring the terminal bell on a new failure
#   sq --color / --no-color force colour on or off
#   sq --compact / --full   fit the screen / show everything (see below)
#   sq --reserve N          COMPACT leaves N lines of the screen unused
#   watch -tc -n 5 sq       live dashboard; keep -t, or watch's own header
#                           pushes the footer off screen (or --reserve 2)
#   sq log JOBID            a job's output file, followed while the job runs
#                           (sq log -h)
#   sq job JOBID            one job: state, why it is where it is, resources,
#                           files, and its CPU and memory efficiency once it
#                           ended; an array's summary (sq job -h).  A subcommand
#                           comes first: only options that take no value may
#                           stand before it
#
# Two modes.  FULL shows every job.  COMPACT fits the screen's height: rows
# that do not fit collapse into lines like "… 42 jobs running".  Stuck jobs
# (pending for a reason other than plain waiting), jobs blocked by a node or
# partition fault and jobs held by an admin keep their rows longest, within
# half the table while running jobs are hidden; running jobs come next, your
# own near their memory limit first (from 90 %, then from 70 %), then the
# longest-running, and ordinary pending jobs last.  The finished block
# shrinks to one line, the newest failure, else the newest job, and on the
# smallest screens the nodes to one summary line.  Below about 60 columns
# some lines are wider than the screen and wrap, so COMPACT can still run
# over its height there.
# COMPACT is chosen when stdout is a terminal or COLUMNS and LINES are both
# exported (watch does that), FULL in a pipe or a file; --compact, --full and
# SQ_COMPACT decide instead, the flags first.
#
# env: SQ_FMT    default column list (same syntax as -o)
#      SQ_CENTER 1 = horizontal, 2 = both axes
#      SQ_FOLD   0 = never fold array tasks
#      SQ_RECENT 0 = never show finished jobs
#      SQ_BELL   0 = never ring; the bell covers only your own jobs unless
#                SQ_BELL_ALL=1.  SQ_ETA 0 = no pending start estimates
#      SQ_BELL_HORIZON  a failure only rings while it is this fresh (600s; 0 mutes)
#      SQ_COLOR  0 = never colour, 1 = always
#      SQ_TIMEOUT seconds to wait for slurm before declaring it unreachable (5;
#                 sq job waits 30 s for accounting unless it is set)
#      SQ_SINCE  how far back the finished block looks (sacct -S; now-2hours)
#      SQ_RECENT_MAX  finished rows (default: every one in FULL, the space
#                     left up to 25 in COMPACT; a value you set is used as
#                     given in FULL, and is an upper limit in COMPACT, never
#                     pushing the footer off)
#      SQ_COMPACT 1 = always COMPACT, 0 = always FULL, else auto-detect
#      SQ_WIDTH / SQ_HEIGHT  force terminal size instead of auto-detect; they
#                     never choose the mode
#
# Array tasks agreeing on every displayed column collapse to 9008_[0-3] x4,
# and a bracket Slurm prints reads 9008_[4-9] x6 with or without -x: the
# footer and "+N more" count every task in it, not the row.
# EXIT: rc/sigN signal N, rc/oom out of memory, rc/errN low 7 bits of a Slurm error
# Finished jobs come from the accounting DB, so the window is SQ_SINCE and not
# MinJobAge: a job that ended while nobody watched is still seen.  Step rows
# are read along with it, because the allocation row of a signalled job
# reports plain success and only its step carries the signal.  With no
# accounting, or with a filter that has no sacct equivalent, the block falls
# back to squeue -t all and its caption says so.  A state filter (-t) filters
# the queue only: the block shows every finished job either way.
# A new failure rings the bell once, and only while it is
# younger than SQ_BELL_HORIZON, so a first run, a cleared cache and a week of
# downtime all stay quiet.  The state kept is "<jobid><tab><end epoch>" lines
# in ~/.cache/sq/alerted: add-only and aged out after 24h, never pruned just
# because one run queried less, and replaced by an atomic rename so two
# instances cannot tear it.  A row with an unknown user never rings and is
# never remembered, and with no controlling terminal the bell is skipped.
# TIME LEFT turns yellow under 10% of the limit and red under 2%.  Pending
# jobs show the backfill start estimate; down nodes show their reason.

set -u
# POSIXLY_CORRECT in the caller's environment puts bash in POSIX mode (no
# process substitution) and makes every gawk sq starts a --posix one, which
# refuses gawk's own extensions and a newline in a string.  Unset, it turns
# bash's POSIX mode off again and reaches no child.
unset POSIXLY_CORRECT
# COLUMNS must only ever mean "my caller told me the size" (watch exports it):
# bash's checkwinsize, on even in a script, would otherwise set it from the
# terminal after the first external command whenever stderr is a tty, and
# "sq > file" would then write colour escapes into the file.
shopt -u checkwinsize

die() { printf 'sq: %s\n' "$*" >&2; exit 2; }   # a usage error, never a table

# ---- the scrub (tests/run.sh and tests/faithfulness.sh run the text from here
# to "scrub end" on their own input)
# The characters sq takes out of every text it draws, Slurm's tables too, as
# whole characters: BIDI, the 12 bidi controls (Unicode's Bidi_Control set:
# U+061C, U+200E, U+200F, U+202A-U+202E, U+2066-U+2069), which reorder what a
# terminal shows after them, and C1, U+0080-U+009F (\302\233 is CSI, \302\235
# OSC); CNTRL, the tables' control rule, each match of which reads "?": C0, DEL
# and C1, the last in every locale, as [[:cntrl:]] holds it only under UTF-8.
# Each an alternation of whole characters, never a byte class, which a gawk
# under a UTF-8 locale refuses ("Invalid collation character"), so the text is
# the same for the scrub's gawk (LC_ALL=C) and for those of shared_awk (gloc);
# and only ever matched on text that is whole characters already, so taking
# one out joins no bytes into a new one
chars_awk='
# ---- the character classes (tests/faithfulness.sh runs them with the node readers)
BEGIN {
  BIDI = "\330\234|\342\200\216|\342\200\217|\342\200\252|\342\200\253|\342\200\254|\342\200\255|\342\200\256|\342\201\246|\342\201\247|\342\201\250|\342\201\251"
  C1 = "\302\200|\302\201|\302\202|\302\203|\302\204|\302\205|\302\206|\302\207|\302\210|\302\211|\302\212|\302\213|\302\214|\302\215|\302\216|\302\217|" \
       "\302\220|\302\221|\302\222|\302\223|\302\224|\302\225|\302\226|\302\227|\302\230|\302\231|\302\232|\302\233|\302\234|\302\235|\302\236|\302\237"
  CNTRL = "[[:cntrl:]]|" C1
}
# ---- character classes end
'
# Outside text - a filter, a setting, the host name, a collector's stderr - is
# decoded as UTF-8 before it reaches the screen or a message, as bytes and never
# by the locale: a control character (C0 and DEL, and C1) and a bidi control
# go, any other character stays as it is, and each piece that is no UTF-8 at
# all (a Latin-1 byte, a halved character: one "maximal subpart", Unicode
# §3.9) becomes one ␚, U+241A.  So the terminal and gawk only ever get whole
# characters, and as only whole ones are taken out, nothing new can join where
# one went: a single pass, its work linear.
# At most MAX characters are kept, 4096 by default, counted once those are
# out: more than a screen line shows, while each text reaches gawk as an
# environment string, which Linux refuses beyond 128 KiB.  The rest is still
# read, so a writer never meets a closed pipe.  With FILE only its first line
# is read, at most 1 MiB of it, and a character that bound cut in half goes, as
# the cut made it, not the text.
# -s, the stream mode, is the same decoding for an answer of Slurm's (a table,
# its JSON), all of it, line by line: each line keeps its newline (and a last
# one its absence), NUL passes, and no ASCII byte is changed, taken out or
# added, controls included (the tables' own rule makes those "?" later, after
# the names are compared); each broken piece becomes one ␚ and the bidi
# controls go, as decoded characters; C1 stays, a whole character.  No MAX.
# Under env, so bash itself never switches locale for it.
scrub() (   # scrub [-s | -f FILE] [MAX]: stdin, or the first line of FILE, onto stdout
	bound=0 stream=0
	[ "${1-}" != -s ] || { stream=1; shift; }
	[ "${1-}" != -f ] || { bound=1048576; exec < <(head -c $((bound + 1)) -- "$2"); shift 2; }
	exec env LC_ALL=C gawk -v max="${1:-4096}" -v bound=$bound -v stream=$stream "$chars_awk"'
	BEGIN {
		CONT = "[\200-\277]"; BAD = "\342\220\232"     # a continuation byte; U+241A
		CTL = "[^\040-\176\200-\377]"                 # C0 and DEL
		# every unit that is not ASCII, the longest at each place (no group
		# anywhere: one makes gawk track submatches, 40 times slower): a
		# sequence of Unicode Table 3-7, else the longest start of one, else a
		# byte that starts none
		UNIT = "[\302-\337]" CONT \
		    "|\340[\240-\277]" CONT "|[\341-\354\356\357]" CONT CONT "|\355[\200-\237]" CONT \
		    "|\360[\220-\277]" CONT CONT "|[\361-\363]" CONT CONT CONT "|\364[\200-\217]" CONT CONT \
		    "|[\302-\337]|\340[\240-\277]?|[\341-\354\356\357]" CONT "?|\355[\200-\237]?" \
		    "|\360|\360[\220-\277]" CONT "?|[\361-\363]" CONT "?" CONT "?|\364|\364[\200-\217]" CONT "?" \
		    "|[\200-\301\365-\377]"
		# of those, wrapped in \001 \002, the ill-formed ones, no character: a
		# byte that leads none, or a lead with fewer bytes than it needs
		ILL = "\001[\200-\337]\002|\001[\340-\357]" CONT "?\002|\001[\360-\377]" CONT "?" CONT "?\002"
		GONE = BIDI "|" C1                            # once each piece is decoded
	}
	# the stream mode: a line with a byte above 127 is decoded, any other passes
	# as it is.  Its own \001 \002 become a newline (which no line holds)
	# and a digit while the units are wrapped, and come back after
	stream {
		s = $0
		if (s ~ /[\200-\377]/) {
			if (esc = (s ~ /[\001\002]/)) { gsub(/\001/, "\n1", s); gsub(/\002/, "\n2", s) }
			gsub(UNIT, "\001&\002", s); gsub(ILL, BAD, s); gsub(/[\001\002]+/, "", s)
			gsub(BIDI, "", s)
			if (esc) { gsub(/\n1/, "\001", s); gsub(/\n2/, "\002", s) }
		}
		printf "%s%s", s, RT
		next
	}
	# globals, kept from line to line: kept, the characters printed so far, and
	# done, set once nothing more is printed (max reached, or the one line of FILE)
	function emit(s,   len, i, lead) {   # s, as much of it as max still allows
		len = length(s)
		for (i = 1; i <= len && kept < max; kept++)      # a lead byte tells the length
			i += (lead = substr(s, i, 1)) < "\300" ? 1 : lead < "\340" ? 2 : lead < "\360" ? 3 : 4
		printf "%s", substr(s, 1, i - 1); if (i <= len) done = 1
	}
	done { next }
	# a line at a time, as a newline ends every sequence (and goes itself)
	{	s = $0; cut = bound && length(s) > bound
		if (!cut && s !~ /[\200-\377]/) gsub(CTL "+", "", s)
		else {
			gsub(CTL, "\r", s)                          # each a \r, so \001 \002 are free
			gsub(UNIT, "\001&\002", s)
			if (cut) {   # the unit the bound ran through, or the byte past it
				tail = substr(s, length(s) - 5)        # room for \001, 4 bytes, \002
				s = substr(s, 1, length(s) - (match(tail, /\001[\200-\377]+\002$/) ? length(tail) - RSTART + 1 : 1))
			}
			gsub(/\r+/, "", s)
			gsub(ILL, BAD, s)
			gsub(/[\001\002]+/, "", s)
			gsub(GONE, "", s)
		}
		emit(s); if (bound) done = 1
	}'
)
# ---- scrub end

# The field separator is a nonce minted per run, never per session: a job name
# is fixed at submit time and a node's drain reason when the admin sets it, so
# neither can contain a separator minted afterwards.  That is what makes a record
# boundary unforgeable - a field holding "|", a tab or a newline can then neither
# inject a row nor steal a field.
# A nonce is usable only if it is letter-led (squeue's -O grammar is
# type[:[.][size][suffix]], so a suffix starting with digits is read as a FIELD
# WIDTH: "JobID:1234567890" segfaults squeue, "JobID:0" drops the separator),
# alphanumeric (no ERE metacharacter, so gawk takes it as FS verbatim) and long
# enough that no name can hold it by chance.
nonce_ok() {
	case ${1:-} in
		''|[!A-Za-z]*|*[!A-Za-z0-9]*) return 1 ;;
	esac
	[ "${#1}" -ge 17 ]
}
mint_nonce() {
	local n=
	[ -z "${SRANDOM:-}" ] ||                              # bash >= 5.1
		printf -v n 'N%08x%08x%08x' "$SRANDOM" "$SRANDOM" "$SRANDOM" 2>/dev/null
	nonce_ok "$n" ||                                      # never "tr -dc </dev/urandom":
		n=N$(LC_ALL=C od -An -tx1 -N12 /dev/urandom 2>/dev/null | LC_ALL=C tr -d ' \n')
	nonce_ok "$n" || return 1
	printf '%s' "$n"
}

# The helpers from here to the dashboard are shared with the subcommands, so
# they come before either.  The tmp dir is made only once the command line
# has been read (make_tmp), so -h and a usage error behave the same with an
# unusable TMPDIR; the EXIT trap holds under set -u for a run that never named
# the dashboard's files or the tmp dir.
tmp=
make_tmp() { tmp=$(mktemp -d) || exit 1; }
memtmp=                                         # the memuse snapshot being written
statetmp=                                       # the bell's state being written
collect_pid= log_pids=                          # the clients collect -w and -b wait for;
                                                # sq log's tail and its sentinel
collect_pidfile= job_sentinel_pid=              # where collect names those clients for
                                                # a sentinel; sq job's sentinel
job_reader_pid=                                 # sq job's reader of an output file
declare -A collect_bg=()                        # collect -b's clients, by NAME
# The processes first, by pid (each ended with TERM and waited for, so none
# outlives sq), then the files.  The output file's reader alone is killed
# outright and never waited for: it may hang in the kernel (sq job says why)
cleanup() {
	local pid
	[ -z "$job_reader_pid" ] || kill -KILL "$job_reader_pid" 2>/dev/null
	for pid in $collect_pid $log_pids $job_sentinel_pid; do kill "$pid" 2>/dev/null; done
	for pid in $collect_pid $log_pids $job_sentinel_pid; do wait "$pid" 2>/dev/null; done
	[ -z "$tmp" ] || rm -rf "$tmp"; rm -f ${statetmp:+"$statetmp"} ${memtmp:+"$memtmp"}
}
trap cleanup EXIT

# an unreachable controller makes sinfo/squeue block, not fail, so bound them.
# timeout reads 0 as "no limit" and errors out on anything non-numeric, so both
# fall back to the default; -k kills a client that ignores SIGTERM
tmo=${SQ_TIMEOUT:-5}
case $tmo in ''|*[!0-9.]*|*.*.*) tmo=5 ;; esac          # 2.5 is valid to timeout
[ -n "$(printf '%s' "$tmo" | tr -d '0.')" ] || tmo=5    # 0, 0.0 mean "no limit"
# A caller's SQUEUE_* and SACCT_* settings filter, sort or reformat, even
# under --jobs / -j (SACCT_FEDERATION and SACCT_LOCAL too), so a question sq
# asks for itself must not inherit them.  exported_names PATTERN...: the
# exported variables whose names match one of these shell patterns, one a line
exported_names() {
	local name pattern
	for name in $(compgen -e); do
		for pattern; do case $name in $pattern) printf '%s
' "$name"; break ;; esac; done
	done
}
# Every collector runs through collect, so its own stderr (NAME.err) and
# timeout's (NAME.tmo) land apart: the client's fd 3 becomes its stderr, and
# timeout keeps fd 2.  sh -c exec keeps the pid, so TERM and KILL reach the
# client itself, and passing the tool as $0 lets sh say "sinfo: ... not found".
# Wrapped in 2>/dev/null, so bash prints no "Killed" or "Segmentation fault"
# notice of its own on the screen.  Environment prefixes on the call reach the
# client.
# -w runs timeout in the background and waits for it, its pid in collect_pid:
# a trapped signal then acts at once instead of when the client is done, and
# the EXIT cleanup can end the client through timeout, which sits in a process
# group of its own that a Ctrl-C never reaches.  The dashboard does not use it,
# as a Ctrl-C there is left to what bash makes of a foreground client.  -b
# starts it the same way and returns at once, so several calls run together;
# collect_join NAME then waits for it and returns its status.  With
# collect_pidfile set, the pids waited for are written there (an empty file
# once none is left), so a sentinel can end the clients once sq is gone.
# -r has the call note its own start and end in NAME.run, as /proc/uptime has
# them (seconds to 1/100, a clock no step of the wall clock moves; read by a
# builtin, no process started), so what is left of its bound is known even
# when it ran in the background: sh then waits for the client instead of
# becoming it, and leaves a TERM for once the client is gone (timeout signals
# the whole process group, the client too), so the exit status stays the
# client's and a client that ignores TERM is still killed 2s past the
# deadline; its notice of a client killed by a signal goes nowhere.  sh, not
# bash: bash warns on an LC_ALL naming no installed locale, into NAME.tmo,
# which reads as timeout's
collect_timed='trap "exit 143" TERM; f=$1; shift; read s x < /proc/uptime; { "$@" 2>&3 3>&-; } 2>/dev/null; r=$?; read e x < /proc/uptime; echo "$s $e" > "$f"; exit $r'
collect() {   # collect [-t SECONDS] [-r] [-w|-b] NAME TOOL ARGS...: stdout into $tmp/NAME,
	local limit=$tmo name how=fg timed=   # bounded by SECONDS, SQ_TIMEOUT's by default
	[ "$1" != -t ] || { limit=$2; shift 2; }
	[ "$1" != -r ] || { timed=1; shift; }
	case $1 in -w) how=wait; shift ;; -b) how=bg; shift ;; esac
	name=$1; shift
	if [ -n "$timed" ]; then
		set -- timeout $verbose -k 2 "$limit" sh -c "$collect_timed" "$1" "$tmp/$name.run" "$@"
	else
		set -- timeout $verbose -k 2 "$limit" sh -c 'exec "$@" 2>&3 3>&-' "$1" "$@"
	fi
	if [ $how = fg ]; then
		{ "$@" > "$tmp/$name" 3> "$tmp/$name.err" 2> "$tmp/$name.tmo"; } 2>/dev/null
		return
	fi
	{ "$@" > "$tmp/$name" 3> "$tmp/$name.err" 2> "$tmp/$name.tmo" & } 2>/dev/null
	collect_bg[$name]=$!; collect_pid="$collect_pid${collect_pid:+ }$!"; collect_inflight
	[ $how = bg ] || collect_join "$name"
}
collect_join() {   # collect_join NAME: wait for collect -b NAME, its status
	local pid=${collect_bg[$1]} rc p left=
	{ wait "$pid"; } 2>/dev/null; rc=$?
	for p in $collect_pid; do [ "$p" = "$pid" ] || left="$left${left:+ }$p"; done
	collect_pid=$left; unset 'collect_bg[$1]'; collect_inflight
	return $rc
}
# what a sentinel must end once sq is gone: the clients waited for, and sq
# job's reader of an output file
collect_inflight() {
	[ -z "$collect_pidfile" ] || printf '%s\n' "$collect_pid${job_reader_pid:+ $job_reader_pid}" > "$collect_pidfile"
}
# Is there a byte above 127 in FILE, or on stdin?  grep alone answers: rc 0
# yes, 1 no, 2 it could not tell.  Under env, never as "LC_ALL=C grep": bash
# would warn of a caller's LC_ALL that names no installed locale; GREP_OPTIONS
# unset, as a grep up to 3.5 reads it
high_bytes() {   # high_bytes [FILE]
	env -u GREP_OPTIONS LC_ALL=C grep -q $'[\200-\377]' "$@" 2>/dev/null
}
# The pass every text answer of Slurm's takes before anything reads it: $tmp/NAME,
# as its call left it, through scrub -s into NAME.tmp, renamed over it; the raw
# answer stays when the scrub fails, and its stderr goes nowhere.  An answer
# with no byte above 127 (grep's rc 1) is left as it is, with no gawk started.
# It runs once the call has ended, never inside collect: the call's exit
# status, its timeout and NAME.run stay the call's, and no pass stands between
# a call and the read of its status
scrub_answer() {   # scrub_answer NAME
	local f=$tmp/$1
	high_bytes "$f"; [ $? != 1 ] || return 0
	{ scrub -s < "$f" > "$f.tmp" && mv -f "$f.tmp" "$f"; } 2>/dev/null || rm -f "$f.tmp"
}
# the same pass on a value of Slurm's that bash holds, VAR in place, kept as it
# is when it has no byte above 127 or the scrub fails
scrub_var() {   # scrub_var VAR
	local v=${!1} out
	printf '%s' "$v" | high_bytes; [ $? != 1 ] || return 0
	out=$(printf '%s' "$v" | scrub -s 2>/dev/null; printf '.%s' $?)
	[ "${out##*.}" != 0 ] || printf -v "$1" '%s' "${out%.*}"
}
# --verbose makes timeout say "sending signal ..." before it signals; it exists
# since coreutils 8.29, and an older timeout refuses it (rc 125) without running
# anything, so it is asked for only where a silent probe accepts it
verbose=
timeout --verbose 1 true > /dev/null 2>&1 && verbose=--verbose
# Why a collector failed, into NAME (empty: it did not), and into NAME_real the
# part of that which is real text: the timeout, or the first line of its
# stderr, which can echo what the user typed and so loses its control
# characters like every other outside text.  With nothing readable there (a
# crash prints nothing) NAME is made up from the exit status, because an empty
# reason reads as success: "queue is empty" and a footer of 0 jobs from a
# squeue that never answered.
# A client that ignores SIGTERM is killed 2s past the deadline, and timeout
# then exits 137 like any SIGKILL; it is the timeout when timeout said it
# signalled (NAME.tmo is not empty - only its existence is read, never its
# translatable text), or when this timeout cannot say so (no --verbose).  That
# also counts a rare start-up warning of timeout's, or timeout itself killed
# from outside, as the timeout.  A 137 that timeout kept quiet about is a SIGKILL
# from elsewhere: a crash.  Otherwise NAME.tmo is shown only for rc 125 with
# an empty NAME.err, timeout's own failure (an unknown option, no fork); its
# "dumped core" after a crash never is.
why_of() {   # why_of NAME RC OUTPUT TOOL [SECONDS]: OUTPUT as collect left it, e.g. $tmp/nodes,
	local rc=$2 real= why=                 # SECONDS its bound if not SQ_TIMEOUT's
	if [ "$rc" = 124 ] || { [ "$rc" = 137 ] && { [ -s "$3.tmo" ] || [ -z "$verbose" ]; }; }; then
		real="no response after ${5:-$tmo}s"
	elif [ "$rc" != 0 ]; then
		real=$(scrub -f "$3.err")
		[ -n "$real" ] || [ "$rc" != 125 ] || real=$(scrub -f "$3.tmo")
	fi
	if [ "$rc" != 0 ]; then
		if   [ -n "$real" ];    then why=$real
		elif [ "$rc" -gt 128 ]; then why="$4 crashed (signal $((rc - 128)))"
		else                         why="$4 failed (exit $rc)"
		fi
	fi
	printf -v "$1" '%s' "$why"; printf -v "$1_real" '%s' "$real"
}
# The nodes, asked of scontrol as `scontrol --json show node` (collect -r
# NAME, bounded by BOUND, its exit status RC), whose answer is used when it
# exits 0 and node_json_read accepts it: FMTVAR json.  Any other answer but a
# timeout gets `scontrol -o show node` once, under the same NAME, within what
# is left of BOUND once the JSON call's own run time is off (NAME.run; none
# read counts as none), through job_limit, so not past sq job's deadline:
# Slurm 22.05 has no --json, a Slurm without json-c or the data_parser fails
# it, and a dump that failed half-way exits 0 with the nodes cut short.  Its
# answer, for node_read (FMTVAR text), is used when it exits 0.  Into WHYVAR the reason when no answer was used, from the last
# call: a timeout's "no response after SHOWN s" (SHOWN the first call's bound,
# as the line prints it, also when the second ran out), else its first line
# of stderr, else "exit N" or "signal N"; "" when one was used.  $tmp/NAME is
# empty when none was.  OPTION... go to the second call's collect
node_answer() {   # node_answer WHYVAR FMTVAR RC NAME BOUND SHOWN [OPTION...]
	local why_var=$1 fmt_var=$2 rc=$3 name=$4 bound=$5 shown=$6 start= end= run=0 left nwhy nwhy_real
	shift 6
	printf -v "$why_var" ''; printf -v "$fmt_var" json
	scrub_answer "$name"
	[ "$rc" = 0 ] && node_json_ok "$tmp/$name" && return
	why_of nwhy "$rc" "$tmp/$name" scontrol "$shown"
	if [ "$nwhy_real" != "no response after ${shown}s" ]; then
		read -r start end < "$tmp/$name.run" 2>/dev/null
		[[ $start =~ ^[0-9]+\.[0-9][0-9]$ && $end =~ ^[0-9]+\.[0-9][0-9]$ ]] &&
			run=$(( (10#${end/./} - 10#${start/./}) * 10000 ))
		[ "$run" -ge 0 ] || run=0
		us_of left "$bound"; left=$((left - run)); [ "$left" -ge 0 ] || left=0
		printf -v left '%d.%06d' $((left / 1000000)) $((left % 1000000))
		job_limit left "$left"
		printf -v "$fmt_var" text
		collect -t "$left" "$@" "$name" scontrol -o show node; rc=$?
		[ "$rc" != 0 ] || { scrub_answer "$name"; return 0; }
		why_of nwhy "$rc" "$tmp/$name" scontrol "$shown"
	fi
	if   [ -n "$nwhy_real" ];  then printf -v "$why_var" '%s' "$nwhy_real"
	elif [ "$rc" -gt 128 ];    then printf -v "$why_var" 'signal %s' $((rc - 128))
	else                            printf -v "$why_var" 'exit %s' "$rc"
	fi
	: > "$tmp/$name"
}
# node_json_read's verdict on FILE, in a gawk of its own, as the report's
# gawk will read it (gloc set)
node_json_ok() {   # node_json_ok FILE
	[ "$(env LC_ALL="$gloc" SQ_NODEFILE="$1" gawk "$shared_awk"'
		BEGIN { print node_json_read(ENVIRON["SQ_NODEFILE"]) ? "ok" : "no" }' 2>/dev/null)" = ok ]
}
# the reason a line names where several could: any real one beats one made up
# from an exit status, and within each kind the first NAME given wins
first_why() {   # first_why NAME... (each set like why_of sets it)
	local v r
	for v in "$@"; do r=${v}_real; [ -z "${!r}" ] || { printf '%s' "${!r}"; return; }; done
	for v in "$@"; do [ -z "${!v}" ] || { printf '%s' "${!v}"; return; }; done
}

# The login names of uids, as "uid=name," pairs into VAR, from one getent
# call through collect, so a name service that hangs is bounded as Slurm is
# (OPTIONs go to collect, before the call's name).  getent says nothing of
# a uid it does not know (exit 2, the others still printed); a name keeps
# only the characters a login name has
uid_names() {   # uid_names VAR "UID..." [OPTION...]
	local var=$1 uids=$2; shift 2
	printf -v "$var" '%s' ''
	[ -n "${uids//[[:space:]]/}" ] || return 0
	collect "$@" passwd getent passwd $uids
	printf -v "$var" '%s' "$(env LC_ALL=C gawk -F: 'NF >= 3 && $3 ~ /^[0-9]+$/ && !($3 in seen) {
		seen[$3]; name = $1; gsub(/[^A-Za-z0-9._-]/, "", name); if (name != "") printf "%s=%s,", $3, name }' "$tmp/passwd" 2>/dev/null)"
}

# gawk functions shared by the programs below (the dashboard's, its memory
# and allocation readers, sq job's), prepended to each; the character classes
# of the scrub (chars_awk) first
shared_awk=$chars_awk'
# a size as Slurm prints it MB-based (%m, the mem= of tres-alloc), an exact
# M/G/T/P suffix and maybe a fraction (1.50G), in MB; -1 for anything else
# (%m prints 0 for --mem=0)
function size_mb(x,   u) {
  if (x !~ /^[0-9]+([.][0-9]+)?[MGTP]$/) return -1
  u = substr(x, length(x))
  return substr(x, 1, length(x) - 1) * (u == "G" ? 1024 : u == "T" ? 1048576 : u == "P" ? 1073741824 : 1)
}
# mem= of a tres-alloc text in MB, -1 when there is none
function tres_mem(tres,   x) {
  if (!match(tres, /(^|,)mem=[0-9]+([.][0-9]+)?[MGTP](,|$)/)) return -1
  x = substr(tres, RSTART, RLENGTH); sub(/^,?mem=/, "", x); sub(/,$/, "", x)
  return size_mb(x)
}
# Every shape squeue prints for %i / JobID, anchored at the start: plain, het
# component (10646+0), array task (10646_3) and pending array
# (10646_[0-9,12%2], 10646_[0-12:2]).  The bracket is the grammar Slurm prints
# and nothing looser, because the anchor is what a forged record has to get
# past: term ("," term)* ("%" N)?, term = N | N-N | N-N:N.  N is at most 7
# digits (MaxArraySize cannot exceed 4000001), so no row can count 1e20 or
# NaN, which passes every "< 1" test
function id_anchor(   an, at) {
  an = "[0-9]{1,7}"; at = an "(-" an "(:" an ")?)?"
  return "^[0-9]+([+][0-9]+)?(_([0-9]+|\\[" at "(," at ")*(%" an ")?\\]))?"
}
# How many jobs an id stands for: a Slurm bracket its tasks, any other id one.
# 0 means it is no id, and the record gate skips it: the anchor cannot say
# a<=b or step>0, and a bracket counted 0 or 1 would be a wrong number nobody
# can see is wrong.  Each term is ONE anchored match, because a split on "-"
# then ":" lets gawk read "12:2" as 12 and count 0-12:2 as 13.
function ntasks(id, anchor,   br, t, nt, i, m, sum) {
  if (id !~ anchor) return 0
  if (!match(id, /_\[([^]]*)\]/, br)) return 1
  sub(/%[0-9]+$/, "", br[1])              # a throttle limits concurrency, not membership
  nt = split(br[1], t, ",")
  for (i=1; i<=nt; i++) {
    if (!match(t[i], /^([0-9]+)(-([0-9]+)(:([0-9]+))?)?$/, m)) return 0
    if (m[2] == "") { sum++; continue }
    if (m[3]+0 < m[1]+0 || (m[4] != "" && m[5]+0 < 1)) return 0
    sum += int((m[3] - m[1]) / (m[4] != "" ? m[5] : 1)) + 1
  }
  return sum
}
# the colours: an SGR escape, or nothing when colour is off
function e(c) { return color ? "\033[" c "m" : "" }       # colour, or nothing
# an age or a time to come, coarsely: from 48 h on in days and hours, as
# elap() prints them (3d05h), as hours alone ran to 8736h for a start a year out
function ago(s) {
  if (s < 0)      return "-"
  if (s < 60)     return s "s"
  if (s < 3600)   return int(s/60) "m"
  if (s < 172800) return int(s/3600) "h"
  return elap(s)
}
function dur(s,   a, b, m, sec) {                         # 3-12:04:05 -> seconds
  if (s !~ /[0-9]/) return -1
  sec = 0
  if (match(s, /^([0-9]+)-(.*)$/, a)) { sec += a[1]*86400; s = a[2] }
  m = split(s, b, ":")
  if      (m == 3) sec += b[1]*3600 + b[2]*60 + b[3]
  else if (m == 2) sec += b[1]*60 + b[2]
  else if (m == 1) sec += b[1]
  return sec
}
function elap(s) {                        # 3-12:04:05 -> 3d12h.  The zero-padded
  if (s < 0)     return "-"               # HH:MM:SS the collectors print costs a
  if (s < 60)    return s "s"             # folded range up to 11 columns, which is
  if (s < 3600)  return int(s/60) "m" sprintf("%02ds", s % 60)     # what used to
  if (s < 86400) return int(s/3600) "h" sprintf("%02dm", int(s % 3600 / 60))
  return int(s/86400) "d" sprintf("%02dh", int(s % 86400 / 3600))   # overrun the edge
}
function exlabel(rc, sg) {                # the second field of an ExitCode is a
  if (sg == 0)   return rc ""             # signal only up to 31: Slurm stores its
  if (sg <= 31)  return rc "/sig" sg      # own errors (53 = task I/O setup failed)
  if (sg == 125) return rc "/oom"         # and its OOM marker, 125, in that slot too
  return rc "/err" sg
}
# one field of an ExitCode: sacct prints 0-127 and the squeue fallback up to
# 255 in the first, so anything but 1-3 digits ("1e3", "53.9", "+inf", "-1",
# empty) reads as 0 instead of leaking through
function exfield(s) { return (s ~ /^[0-9]{1,3}$/) ? s+0 : 0 }
# squeue decodes the raw exit_code of slurmctld, which sets 1 for a job it
# ended itself (a deadline, a lost batch script, a node gone): squeue calls
# that signal 1, so in the fallback (fb) 0:1 is read as 1:0, as slurmdbd stores it
function xcm(id, x, fb,   a, rc, sg) {    # per job, over its allocation row and its
  split(x, a, ":")                        # steps ("sacct -X" would say 0:0): the
  rc = exfield(a[1]); sg = exfield(a[2])  # first non-zero return code and the first
  if (fb && rc == 0 && sg == 1) { rc = 1; sg = 0 }
  if (JRC[id] == 0 && rc != 0) JRC[id] = rc               # non-zero second field,
  if (JSG[id] == 0 && sg != 0 || sg == 125) JSG[id] = sg  # but an OOM always wins,
}                                         # never hidden behind an earlier 15
# one node bar of wd cells: a allocated and u in use, of tot.  █ in use within
# the allocation (hue), ▒ allocated but idle (dim hue), ▓ in use beyond the
# allocation (magenta), ░ free (dim), or · when the use is not known (u < 0).
# Both counts round to the nearest cell; a load above the core count simply
# fills the bar.  No cells, no escapes either
function cells(a, u, tot, wd, hue,   na, nu, i, x) {
  if (wd <= 0) return ""
  na = tot ? int(a*wd/tot + 0.5) : 0
  nu = (u < 0) ? -1 : tot ? int(u*wd/tot + 0.5) : 0
  for (i=0; i<wd; i++)
    if      (i < na && i < nu) x = x e(hue) "█"
    else if (i < na)           x = x e("2;" hue) "▒"
    else if (i < nu)           x = x e("35") "▓"
    else                       x = x e("2") (nu < 0 ? "·" : "░")
  return x e("0")
}
# ---- the MEM cell of the running jobs of the caller -------------------------
# Form b, the default: used/allocated, both in the unit of the allocation,
# binary: M below 1000 MiB, T from 1 TiB, else G.  A whole allocation prints
# whole and its use as ever: from 10 up whole, below that with one decimal and
# no ".0".  An allocation that is not whole prints with one decimal, cut, never
# rounded up (15600M is 15.2G), and its use with one decimal too.  Within that
# decimal form a job under its allocation never reads as much (one step, 0.1,
# below it), nor one at or over it less.  The used part is padded to the
# allocated figure + 2 (+ 1 with a decimal: either way a use up to ten times the
# allocation), so a cell is as wide as its allocation makes it, whatever the
# reading, and nothing moves under watch.  WHOLE is the narrower fallback for a
# screen: an allocation from 10 up that is not whole is cut to a whole number
# (one below 10 keeps its decimal), and every use is cut to a whole number,
# with no guard: 7.66 of 15.23 is 7/15G, 7.7 of 16 is 7/16G, under 1G is 0,
# and 15/15G at 99 % leaves the rest to the colour.  MARK ("?" no reading,
# "!" a failed one) stands in for the use.
function memnum(x,   s) {
  if (x >= 9.95) return sprintf("%d", int(x + 0.5))
  s = sprintf("%.1f", x); sub(/[.]0$/, "", s); return s
}
function memunit(mb) { return (mb >= 1048576) ? "T" : (mb >= 1000) ? "G" : "M" }
function mb_per(unit) { return (unit == "T") ? 1048576 : (unit == "G") ? 1024 : 1 }
# MB in that unit rule, as form b prints an allocation: whole, or one
# decimal, cut (15600M is 15.2G); WHOLE cuts one from 10 up to a whole number
function memsize(mb, whole,   unit, tenths) {
  unit = memunit(mb)
  tenths = int(mb * 10 / mb_per(unit))         # in tenths, cut
  if (mb % mb_per(unit) == 0)      return sprintf("%d", mb / mb_per(unit)) unit
  if (whole && tenths >= 100)      return sprintf("%d", int(tenths / 10)) unit
  return sprintf("%.1f", tenths / 10) unit
}
function memcell(used_bytes, alloc_mb, mark, whole,   unit, mb_per_unit, alloc_shown, decimal, used, pct, pad) {
  unit = memunit(alloc_mb); mb_per_unit = mb_per(unit)
  alloc_shown = memsize(alloc_mb, whole); sub(/[MGT]$/, "", alloc_shown)
  decimal = (index(alloc_shown, ".") > 0)
  pad = length(alloc_shown) + (decimal ? 1 : 2)
  if (mark != "") used = mark
  else {
    used = used_bytes / 1048576 / mb_per_unit; pct = used_bytes / (alloc_mb * 1048576) * 100
    if (whole) used = sprintf("%d", int(used))
    else {
      used = decimal ? sprintf("%.1f", used) : memnum(used)
      if (pct < 100 && used + 0 >= alloc_shown + 0) used = sprintf("%.1f", alloc_shown - 0.1)
      else if (pct >= 100 && used + 0 < alloc_shown + 0) used = alloc_shown
    }
  }
  return sprintf("%*s", pad, used) "/" alloc_shown unit
}
function memcolour(p) { return (p >= 100) ? "1;31" : (p >= 90) ? "31" : (p >= 70) ? "33" : "32" }
# JOBMEM readings: the snapshot lines, "<id> TAB ok|none|failed TAB
# <bytes>", into job_outcome and job_bytes, by unique job id
function mem_load(file,   ln, mf) {
  while ((getline ln < file) > 0) { split(ln, mf, "\t"); job_outcome[mf[1]] = mf[2]; job_bytes[mf[1]] = mf[3] + 0 }
  close(file)
}
# what a running job of the caller reads, by its unique id, its allocation in
# MB and its node count: "failed" when the allocation call failed, else the
# snapshot outcome where it is measured (an allocation, one node) and in
# the snapshot (not started since), else "none"
function mem_outcome(id, alloc_mb, nodes) {
  if (memfail) return "failed"
  return (alloc_mb > 0 && nodes == "1" && (id in job_outcome)) ? job_outcome[id] : "none"
}
# Why a job is pending, one table for the sections of the dashboard (jclass)
# and the why section of sq job: the kind of its reason.  wait: time alone
# frees it (plain waiting, a dependency, a throttled array); own: a hold its
# owner can release (JobHeldUser, and the holds Slurm sets on a requeue,
# which leave the job held by its user: job_mgr.c, 23.11); fault: a node or
# partition is down or out of reach, for an admin to mend; admin: a hold by
# an admin; never: a request no node or limit can ever meet; stuck: anything
# else, also every reason sq does not know, so it stays visible, and a QOS
# or association limit (but one per job, or on minutes used, never frees
# up: never).  Only a CLOSED list of reasons is plain waiting, and by
# whole-string equality, never a prefix: "Dependency" must not swallow
# "DependencyNeverSatisfied"; the texts with a free part (ReqNodeNotAvail,
# ...) by their fixed start
function pend_tables(   x, i) {
  split("None Priority Resources Dependency BeginTime Prolog Cleaning SchedDefer Reservation Licenses JobArrayTaskLimit", x, " ")
  for (i in x) PEND_KIND[x[i]] = "wait"
  PEND_KIND["JobHeldUser"] = "own"; PEND_KIND["JobHeldAdmin"] = "admin"
  split("NodeDown PartitionDown PartitionInactive FrontEndDown PowerNotAvail PowerReserved", x, " ")
  for (i in x) PEND_KIND[x[i]] = "fault"
  split("BadConstraints PartitionConfig PartitionNodeLimit PartitionTimeLimit InvalidAccount InvalidQOS " \
        "AccountNotAllowed QOSNotAllowed JobHoldMaxRequeue", x, " ")
  for (i in x) PEND_KIND[x[i]] = "never"
}
function pend_kind(why) {
  if (why in PEND_KIND) return PEND_KIND[why]
  if (why ~ /^ReqNodeNotAvail/ || why ~ /^Nodes required for job are /) return "fault"
  if (why ~ /requeued held$/ || why ~ /^job requeued in /) return "own"
  if (why ~ /^uid [0-9]+ not in group/) return "never"
  if (why ~ /^(QOS|Assoc)/) return (why ~ /PerJob|Minutes/) ? "never" : "stuck"
  return "stuck"
}
# ---- the node readers (tests/faithfulness.sh runs the text from here to
# "node readers end" on real answers)
# ---- scontrol -o show node: one node a line, as Slurm 23.11 prints it
# (slurm_sprint_node_table): NodeName first, the figures, then free text an
# admin sets (Reason=, Comment=, Extra=), which may hold anything: a
# "MemSpecLimit=" of its own, or a newline and a whole forged line.  So a key
# is read only before the first " Reason=", " Comment=" or " Extra=", the
# first one of its name counts (MemSpecLimit and Partitions are printed only
# when set, so a later one would be the text), and a NodeName seen twice
# leaves that node unknown (NODE_BAD "twice").  By index 1..NN: NODE_NAME, NODE_CPUS
# (CPUEfctv, else CPUTot), NODE_CPUALLOC, NODE_REALMEM, NODE_ALLOCMEM and
# NODE_SPECMEM (MemSpecLimit, 0 when absent) in MB, NODE_STATE, NODE_PARTS
# (its partitions, comma-separated); a number missing or garbled is -1
function node_read(file,   ln, KV, s, m, name, n) {
  while ((getline ln < file) > 0) {
    if (ln !~ /^NodeName=/) continue
    if (match(ln, / (Reason|Comment|Extra)=/)) ln = substr(ln, 1, RSTART - 1)
    delete KV; s = ln
    while (match(s, /(^| )([A-Za-z_]+)=([^ ]*)/, m)) { if (!(m[2] in KV)) KV[m[2]] = m[3]; s = substr(s, RSTART + RLENGTH) }
    name = KV["NodeName"]
    if (name in NODE_AT) { NODE_BAD[NODE_AT[name]] = "twice"; continue }
    n = NODE_AT[name] = ++NN; NODE_NAME[n] = name
    NODE_CPUS[n] = node_num(("CPUEfctv" in KV) ? KV["CPUEfctv"] : KV["CPUTot"])
    NODE_CPUALLOC[n] = node_num(KV["CPUAlloc"]); NODE_REALMEM[n] = node_num(KV["RealMemory"])
    NODE_ALLOCMEM[n] = node_num(KV["AllocMem"]); NODE_SPECMEM[n] = ("MemSpecLimit" in KV) ? node_num(KV["MemSpecLimit"]) : 0
    NODE_STATE[n] = KV["State"]; NODE_PARTS[n] = KV["Partitions"]
  }
  close(file)
}
function node_num(x) { return (x ~ /^[0-9]{1,12}$/) ? x + 0 : -1 }
# ---- scontrol --json show node: the same arrays, from the pretty layout of
# json-c (Slurm 23.02 and later prints every member on a line of its own, a string
# with every quote, backslash and control character escaped, so no string
# holds a newline or ends a line in a bracket).  Read line by line, the depth
# from the structure, never from the indentation (json-c 0.13 indents by
# 2d+1, 0.14-0.16 print an empty [] on two lines): a line ending in { or [
# opens a level, one of only } or ] (and a comma) closes one.  A line is told
# apart by anchored tests on its start alone, and cut by anchored sub only: a
# value can hold invalid UTF-8, on which gawk warns for index, substr, length
# and match, and which "." does not match.  Accepted only as one object with
# one member "nodes", an array of objects, and one member "errors", an empty
# array (a dump that failed half-way cuts the nodes short and says so there),
# balanced, nothing but blank lines after it; else nothing is kept (NN 0) and
# 0 is returned.  Read of each node, its direct members only: name, cpus,
# effective_cpus (NODE_CPUS when present), alloc_cpus, real_memory,
# alloc_memory and specialized_memory (-1 when absent), a number as node_num
# reads it, state (its flags joined by "+") and partitions (by ","), each a
# string.  A name not decodable is not accepted; a member read twice, a state
# or partitions not an array of strings leave that node unknown (NODE_BAD
# "garbled"), a name in two nodes the first one ("twice")
function node_json_read(file,   ln, d, T, K, done, bad, nodes, errs, k, key, val, nm, seen, V, arrkey, arr, arrn) {
  NN = 0; d = 0; done = 0; bad = 0; nodes = errs = 0
  while ((getline ln < file) > 0) {
    if (done) { if (ln ~ /^[ \t]*$/) continue; bad = 1; break }
    if (!d) { if (ln !~ /^\{$/) { bad = 1; break } ; d = 1; T[1] = "{"; K[1] = "top"; continue }
    k = K[d]
    if (ln ~ /^[ \t]*[]}],?$/) {                                   # a closer, of the right kind
      if ((ln ~ /^[ \t]*\],?$/) != (T[d] == "[")) { bad = 1; break }
      if (k == "node" && !node_json_add(nm, seen, V)) { bad = 1; break }
      if (k == "arr") V[arrkey] = arr
      if (!--d) done = 1
      continue
    }
    if (k == "skip") { if (ln ~ /[[{]$/) { T[++d] = (ln ~ /\[$/) ? "[" : "{"; K[d] = "skip" } ; continue }
    if (k == "nodes") {                                            # an element: a node object
      if (ln !~ /^[ \t]*\{$/) { bad = 1; break }
      T[++d] = "{"; K[d] = "node"; nm = ""; delete seen; delete V; continue
    }
    if (k == "errors") { bad = 1; break }                         # an error
    if (k == "arr") {                                              # a state flag, a partition
      if (ln ~ /[[{]$/) { V["bad"] = 1; T[++d] = (ln ~ /\[$/) ? "[" : "{"; K[d] = "skip"; continue }
      val = ln; sub(/^[ \t]*/, "", val); sub(/,$/, "", val); val = json_str(val)
      if (JSTR_BAD) V["bad"] = 1
      else if (arrn++) arr = arr (arrkey == "state" ? "+" : ",") val
      else arr = val
      continue
    }
    if (ln !~ /^[ \t]*"/) { bad = 1; break }                       # top or node: a member
    if (k == "top") {
      if (ln ~ /^[ \t]*"(nodes|errors)": /) {
        key = (ln ~ /^[ \t]*"nodes": /) ? "nodes" : "errors"
        if (key == "nodes" ? nodes++ : errs++) { bad = 1; break }
        if (ln ~ /^[ \t]*"[a-z]+": \[$/) { T[++d] = "["; K[d] = key; continue }
        if (ln !~ /^[ \t]*"[a-z]+": \[\],?$/) { bad = 1; break }
        continue
      }
    } else if ((key = node_json_key(ln)) != "") {
      val = ln; sub(/^[ \t]*"[a-z_]+": /, "", val)
      if (key in seen) V["bad"] = 1
      else if (key == "state" || key == "partitions") {
        seen[key] = 1
        if (val ~ /^\[$/) { T[++d] = "["; K[d] = "arr"; arrkey = key; arr = ""; arrn = 0; continue }
        V[key] = ""; if (val !~ /^\[\],?$/) V["bad"] = 1
      } else {
        seen[key] = 1; sub(/,$/, "", val); V[key] = val
        if (key == "name") { nm = json_str(val); if (JSTR_BAD) { bad = 1; break } }
      }
    }
    if (ln ~ /[[{]$/) { T[++d] = (ln ~ /\[$/) ? "[" : "{"; K[d] = "skip" }
  }
  close(file)
  if (bad || !done || nodes != 1 || errs != 1) {
    NN = 0; delete NODE_AT; delete NODE_BAD; delete NODE_NAME; delete NODE_CPUS; delete NODE_CPUALLOC
    delete NODE_REALMEM; delete NODE_ALLOCMEM; delete NODE_SPECMEM; delete NODE_STATE; delete NODE_PARTS
    return 0
  }
  return 1
}
# the member of a node object that line LN starts, if it is one read
function node_json_key(ln) {
  if (ln !~ /^[ \t]*"(name|cpus|effective_cpus|alloc_cpus|real_memory|alloc_memory|specialized_memory|state|partitions)": /) return ""
  if (ln ~ /^[ \t]*"name": /) return "name"
  if (ln ~ /^[ \t]*"cpus": /) return "cpus"
  if (ln ~ /^[ \t]*"effective_cpus": /) return "effective_cpus"
  if (ln ~ /^[ \t]*"alloc_cpus": /) return "alloc_cpus"
  if (ln ~ /^[ \t]*"real_memory": /) return "real_memory"
  if (ln ~ /^[ \t]*"alloc_memory": /) return "alloc_memory"
  if (ln ~ /^[ \t]*"specialized_memory": /) return "specialized_memory"
  if (ln ~ /^[ \t]*"state": /) return "state"
  return "partitions"
}
# a node object read whole: 0 when it has no name
function node_json_add(nm, seen, V,   n) {
  if (!("name" in seen)) return 0
  if (nm in NODE_AT) { NODE_BAD[NODE_AT[nm]] = "twice"; return 1 }
  n = NODE_AT[nm] = ++NN; NODE_NAME[n] = nm
  NODE_CPUS[n] = node_num(("effective_cpus" in seen) ? V["effective_cpus"] : V["cpus"])
  NODE_CPUALLOC[n] = node_num(V["alloc_cpus"]); NODE_REALMEM[n] = node_num(V["real_memory"])
  NODE_ALLOCMEM[n] = node_num(V["alloc_memory"])
  NODE_SPECMEM[n] = ("specialized_memory" in seen) ? node_num(V["specialized_memory"]) : -1
  NODE_STATE[n] = V["state"]; NODE_PARTS[n] = V["partitions"]
  if (V["bad"]) NODE_BAD[n] = "garbled"
  return 1
}
# A JSON string token, decoded into a plain string; JSTR_BAD 1 when it is no
# string or holds an escape JSON does not have (a backslash before anything
# but " \\ / b f n r t, or \u without 4 hex digits).  Its control characters
# become "?", as on the sinfo side; invalid UTF-8 stays as it is.  Only gsub works on
# it, so a 128 KB run of backslashes costs a few passes, not one per escape
function json_str(tok,   s, t) {
  JSTR_BAD = 1
  if (tok !~ /^"/ || tok !~ /"$/ || tok == "\"") return ""
  s = tok; sub(/^"/, "", s); sub(/"$/, "", s)
  gsub(/[[:cntrl:]]/, "?", s)                 # none in a string of json-c; frees \001 as a mark
  gsub(/\\\\/, "\001", s)                     # each \\ out of the way first
  t = s; gsub(/\\"/, "", t); if (t ~ /"/) return ""      # a quote no backslash escapes
  gsub(/\\"/, "\"", s); gsub(/\\\//, "/", s); gsub(/\\[bfnrt]/, "?", s)
  if (s ~ /\\/) {
    t = s; gsub(/\\u[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/, "", t); if (t ~ /\\/) return ""
    s = json_u(s)
  }
  gsub(/\001/, "\\", s); gsub(/[[:cntrl:]]/, "?", s)
  JSTR_BAD = 0
  return s
}
# its \uXXXX escapes as UTF-8, built byte by byte (%c would print a character
# of the locale): a surrogate pair as its code point, a lone surrogate as
# U+FFFD.  json-c writes \u only for a control character, "?" at once; any
# other escape (never from json-c) is replaced by a gsub of its own, one per
# distinct escape, the ones there are named by split
function json_u(s,   n, P, E, i, h, cp, did) {
  gsub(/\\u00[01][0-9A-Fa-f]/, "?", s); gsub(/\\u007[Ff]/, "?", s)
  n = split(s, P, /\\u[Dd][89ABab][0-9A-Fa-f][0-9A-Fa-f]\\u[Dd][C-Fc-f][0-9A-Fa-f][0-9A-Fa-f]/, E)
  for (i = 1; i < n; i++) if (!(E[i] in did)) {    # E[i] is ASCII: \uD8xx\uDCxx
    did[E[i]]
    split(E[i], h, "\\")
    sub(/^u/, "", h[2]); sub(/^u/, "", h[3])
    cp = 65536 + (strtonum("0x" h[2]) - 55296) * 1024 + strtonum("0x" h[3]) - 56320
    gsub("\\\\u" h[2] "\\\\u" h[3], json_utf8(cp), s)
  }
  gsub(/\\u[Dd][89A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/, "\357\277\275", s)
  n = split(s, P, /\\u[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/, E)
  for (i = 1; i < n; i++) if (!(E[i] in did)) {
    did[E[i]]
    h[1] = E[i]; sub(/^\\u/, "", h[1])
    gsub("\\\\u" h[1], json_utf8(strtonum("0x" h[1])), s)
  }
  return s
}
# code point CP as UTF-8 bytes, as a gsub replacement: & escaped, a backslash
# as the \001 mark json_str turns back
function json_utf8(cp) {
  if (!(128 in JSON_BYTE)) json_bytes()
  if (cp == 92) return "\001"
  if (cp == 38) return "\\&"
  if (cp < 128) return sprintf("%c", cp)
  if (cp < 2048) return JSON_BYTE[192 + int(cp / 64)] JSON_BYTE[128 + cp % 64]
  if (cp < 65536) return JSON_BYTE[224 + int(cp / 4096)] JSON_BYTE[128 + int(cp / 64) % 64] JSON_BYTE[128 + cp % 64]
  return JSON_BYTE[240 + int(cp / 262144)] JSON_BYTE[128 + int(cp / 4096) % 64] JSON_BYTE[128 + int(cp / 64) % 64] JSON_BYTE[128 + cp % 64]
}
# the bytes 128..255, from octal escapes, which are bytes in every locale
function json_bytes(   b, i) {
  split("\200,\201,\202,\203,\204,\205,\206,\207,\210,\211,\212,\213,\214,\215,\216,\217,\220,\221,\222,\223,\224,\225,\226,\227,\230,\231,\232,\233,\234,\235,\236,\237," \
        "\240,\241,\242,\243,\244,\245,\246,\247,\250,\251,\252,\253,\254,\255,\256,\257,\260,\261,\262,\263,\264,\265,\266,\267,\270,\271,\272,\273,\274,\275,\276,\277," \
        "\300,\301,\302,\303,\304,\305,\306,\307,\310,\311,\312,\313,\314,\315,\316,\317,\320,\321,\322,\323,\324,\325,\326,\327,\330,\331,\332,\333,\334,\335,\336,\337," \
        "\340,\341,\342,\343,\344,\345,\346,\347,\350,\351,\352,\353,\354,\355,\356,\357,\360,\361,\362,\363,\364,\365,\366,\367,\370,\371,\372,\373,\374,\375,\376,\377", b, ",")
  for (i = 1; i <= 128; i++) JSON_BYTE[127 + i] = b[i]
}
