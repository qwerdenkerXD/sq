# The terminal's size, into tty_lines and tty_cols, from stty, which needs no
# terminfo entry for $TERM as tput does (xterm-kitty, xterm-ghostty).  No
# controlling terminal leaves both empty, silently; a pty not sized yet says
# 0 0.  For the dashboard and sq job
tty_size() {
	local size
	size=$({ stty size </dev/tty; } 2>/dev/null) || size=
	tty_lines=${size% *} tty_cols=${size#* }
}
# colour: honour NO_COLOR, else auto-detect.  A pipe with COLUMNS set is
# watch, which wants the escapes; a bare pipe or redirect does not.  For the
# dashboard and sq job, from --color/--no-color and SQ_COLOR
color_resolve() {
	[ "$color" = auto ] || return 0
	if   [ -n "${NO_COLOR:-}" ]; then color=0
	elif [ -t 1 ];               then color=1
	elif [ -n "${COLUMNS:-}" ];  then color=1
	else color=0
	fi
}

# gawk counts characters with length() only under a UTF-8 locale: under
# LC_ALL=C (cron, systemd, containers) it counts bytes.  So gawk runs under the
# caller's locale if that is UTF-8, else C.UTF-8, else the first UTF-8 locale
# installed; with none at all, under C, where wide_awk measures by the bytes
# themselves (a caller's eucJP or Latin-1 would take UTF-8 bytes for its own
# characters, and its [[:cntrl:]] eat a byte of "…").  A locale is UTF-8 when its
# charmap says so and gawk, which does the counting, counts "…█" as two
# characters (ja_JP.eucJP counts "…" as one, but "█" as two) and writes
# U+2026 U+2588 as "…█", their UTF-8.  Without a locale tool that answers
# (musl, a minimal image) gawk alone decides: under C the count is 6, under
# eucJP 3; BIG5, BIG5-HKSCS, CP949 and JOHAB count 2 but write other bytes
# (of every charmap glibc ships, UTF-8 alone passes both).
# Set through env, never as "LC_ALL=x cmd": bash applies that to itself too,
# and restoring a caller's LC_ALL that names no installed locale puts a
# setlocale warning on the screen each time.
utf8_ok() {
	local charmap
	if charmap=$(env LC_ALL="$1" locale charmap 2>/dev/null); then
		[ "$charmap" = UTF-8 ] || return 1
	fi
	env LC_ALL="$1" gawk 'BEGIN { exit !(length("…█") == 2 && sprintf("%c", 8230) sprintf("%c", 9608) == "…█") }' 2>/dev/null
}
gawk_locale() {   # the locale gawk runs in, into gloc
	gloc=${LC_ALL:-}                 # empty: gawk reads LC_CTYPE and LANG as before
	if ! utf8_ok "$gloc"; then
		gloc=C.UTF-8
		utf8_ok "$gloc" || gloc=$(locale -a 2>/dev/null | LC_ALL=C grep -i '\.utf-\{0,1\}8' |
			while read -r l; do utf8_ok "$l" && { printf '%s' "$l"; break; }; done)
		[ -n "$gloc" ] || gloc=C
	fi
}

# ---- memory use of the caller's own running jobs (JOBMEM) ------------------
# The dashboard asks only when the queue holds one: a running row whose %U is
# `id -u`; sq job when the job it shows is one.  Then the allocation of every
# job of the caller's, unfiltered by the screen's filters, on every refresh
# (cheap, and it must match this refresh), and sstat's reading of the running
# ones that have an allocation and one node (sstat answers only a job's owner,
# and a multi-node reading is not measured): one call for all of them, at most
# every 30 s, whatever the filters, so every sq of a user's shares it, sq job
# too.  The last call's result is a snapshot in memuse beside the bell's
# state: the epoch of the call, then "<id> TAB ok|none|failed TAB <bytes>".
# For gawk: $tmp/memalloc "<id> TAB <state> TAB <MB> TAB <nodes>",
# $tmp/memread the snapshot's job lines, memfail=1 when the allocation call
# failed (every own running row then reads "!").  myuid is the caller's uid,
# set by whoever calls these.
memfail=0 myuid=
# The directory sq keeps its state in, the bell's and the snapshot's, into
# VAR: XDG_CACHE_HOME/sq, but only when XDG_CACHE_HOME is absolute, as a
# relative one would put the state wherever sq happens to run; else
# HOME/.cache/sq, only when HOME is set and absolute; else empty, no state
cache_dir() {   # cache_dir VAR
	local dir=
	case ${XDG_CACHE_HOME:-} in
		/*) dir=$XDG_CACHE_HOME/sq ;;
		*)  case ${HOME:-} in /*) dir=$HOME/.cache/sq ;; esac ;;
	esac
	printf -v "$1" '%s' "$dir"
}
# the snapshot in use: whole and well-formed, and taken in the last 30 s, its
# job lines into memread (rc 0); anything else (missing, garbled, from the
# future) empties memread (rc 1), and is a call.  memdir is the snapshot's
# directory, empty when there is none to use, memnow the epoch it is judged by
jobmem_snapshot() {
	# No usable directory, or a memuse there that is no regular file,
	# means a call on every run, silently, and nothing written
	cache_dir memdir
	[ -z "$memdir" ] || mkdir -p "$memdir" 2>/dev/null || memdir=
	[ -z "$memdir" ] || ! [ -e "$memdir/memuse" ] || [ -f "$memdir/memuse" ] || memdir=
	printf -v memnow '%(%s)T' -1
	if [ -n "$memdir" ] && env LC_ALL=C gawk -v now="$memnow" '
		NR == 1 { if ($0 !~ /^[0-9]+$/ || now - $0 < 0 || now - $0 >= 30) bad = 1; next }
		$0 !~ /^[0-9]+\t(ok|none|failed)\t[0-9]+$/ { bad = 1 }
		{ print }
		END { exit (NR == 0 || bad) }' "$memdir/memuse" > "$tmp/memread" 2>/dev/null
	then return 0
	fi
	: > "$tmp/memread"; return 1
}
# The allocation call, then the snapshot if it is fresh, else sstat's reading,
# written as the new snapshot.  -w: every call through collect -w, as a
# subcommand makes them
jobmem_collect() {   # jobmem_collect [-w]
	local w=${1-} memids memrc sstat_limit allocrc inherited
	: > "$tmp/memalloc"; : > "$tmp/memread"
	# framed like the fallback's call: the format in SQUEUE_FORMAT2, so the
	# queue nonce never reaches a command line.  StateCompact is %t's letter.
	# The caller's SQUEUE_* filters (SQUEUE_STATES, SQUEUE_PARTITION, ...)
	# would narrow it as the screen's options would: unexported for this
	# call alone, as the screen's calls after it still take them
	inherited=$(exported_names 'SQUEUE_*')
	[ -z "$inherited" ] || export -n $inherited
	SQUEUE_FORMAT2="JobID:$nonce,StateCompact:$nonce,tres-alloc:$nonce,NumNodes:$nonce" \
		collect $w alloc squeue -h -u "$myuid"
	allocrc=$?
