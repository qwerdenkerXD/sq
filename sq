#!/usr/bin/env bash
# sq - auto-fitting Slurm dashboard
#
#   sq                      default columns
#   sq -o i,j,T,M,P,N       custom columns (squeue field letters, %/widths ignored)
#   sq -u "$USER" -p gpu    filters go to squeue, by the names squeue documents
#                           also forwarded: --all --hide --array --noconvert
#                           --noheader --priority --federation --local --sibling
#                           refused: -O --Format -s --steps -i --iterate -l -v
#                           -V --json --yaml, each of which would replace or
#                           defeat the output sq parses
#   sq -c / -C              centre horizontally / in both axes; vertically
#                           only on a screen (a terminal, or watch), and only
#                           while the dashboard is at least two lines shorter
#   sq -x                   expand array tasks instead of folding them; a pending
#                           bracket squeue prints (9008_[4-9] x6) stays one row,
#                           which only --array splits
#   sq --no-recent          hide the recently-finished block
#   sq --no-bell            never ring the terminal bell on a new failure
#   sq --color / --no-color force colour on or off
#   sq --compact / --full   fit the screen / show everything (see below)
#   sq --reserve N          COMPACT leaves N lines of the screen unused
#   watch -tc -n 5 sq       live dashboard; keep -t, or watch's own header
#                           pushes the footer off screen (or --reserve 2)
#   sq log JOBID            a job's output file, followed while the job runs
#                           (sq log -h)
#   sq job JOBID            one job: state, resources, files, and its CPU and
#                           memory efficiency once it ended; an array's summary
#                           (sq job -h).  A subcommand comes first: only options
#                           that take no value may stand before it
#
# Two modes.  FULL shows every job.  COMPACT fits the screen's height: rows
# that do not fit collapse into lines like "… 42 jobs running".  Stuck jobs
# (pending for a reason other than plain waiting), jobs blocked by a node or
# partition fault and jobs held by an admin keep their rows longest, within
# half the table while running jobs are hidden; running jobs come next, your
# own near their memory limit first (from 90 %, then from 70 %), then the
# longest-running, and ordinary pending jobs last.  The finished block
# shrinks to one line, the newest failure, else the newest job, and on the
# smallest screens the nodes to one summary line.  Below about 60 columns
# some lines are wider than the screen and wrap, so COMPACT can still run
# over its height there.
# COMPACT is chosen when stdout is a terminal or COLUMNS and LINES are both
# exported (watch does that), FULL in a pipe or a file; --compact, --full and
# SQ_COMPACT decide instead, the flags first.
#
# env: SQ_FMT    default column list (same syntax as -o)
#      SQ_CENTER 1 = horizontal, 2 = both axes
#      SQ_FOLD   0 = never fold array tasks
#      SQ_RECENT 0 = never show finished jobs
#      SQ_BELL   0 = never ring; the bell covers only your own jobs unless
#                SQ_BELL_ALL=1.  SQ_ETA 0 = no pending start estimates
#      SQ_BELL_HORIZON  a failure only rings while it is this fresh (600s; 0 mutes)
#      SQ_COLOR  0 = never colour, 1 = always
#      SQ_TIMEOUT seconds to wait for slurm before declaring it unreachable (5)
#      SQ_SINCE  how far back the finished block looks (sacct -S; now-2hours)
#      SQ_RECENT_MAX  finished rows (default: every one in FULL, the space
#                     left up to 25 in COMPACT; a value you set is used as
#                     given in FULL, and is an upper limit in COMPACT, never
#                     pushing the footer off)
#      SQ_COMPACT 1 = always COMPACT, 0 = always FULL, else auto-detect
#      SQ_WIDTH / SQ_HEIGHT  force terminal size instead of auto-detect; they
#                     never choose the mode
#
# Array tasks agreeing on every displayed column collapse to 9008_[0-3] x4,
# and a bracket Slurm prints reads 9008_[4-9] x6 with or without -x: the
# footer and "+N more" count every task in it, not the row.
# EXIT: rc/sigN signal N, rc/oom out of memory, rc/errN low 7 bits of a Slurm error
# Finished jobs come from the accounting DB, so the window is SQ_SINCE and not
# MinJobAge: a job that ended while nobody watched is still seen.  Step rows
# are read along with it, because the allocation row of a signalled job
# reports plain success and only its step carries the signal.  With no
# accounting, or with a filter that has no sacct equivalent, the block falls
# back to squeue -t all and its caption says so.
# A new failure rings the bell once, and only while it is
# younger than SQ_BELL_HORIZON, so a first run, a cleared cache and a week of
# downtime all stay quiet.  The state kept is "<jobid><tab><end epoch>" lines
# in ~/.cache/sq/alerted: add-only and aged out after 24h, never pruned just
# because one run queried less, and replaced by an atomic rename so two
# instances cannot tear it.  A row with an unknown user never rings and is
# never remembered, and with no controlling terminal the bell is skipped.
# TIME LEFT turns yellow under 10% of the limit and red under 2%.  Pending
# jobs show the backfill start estimate; down nodes show their reason.

set -u
# COLUMNS must only ever mean "my caller told me the size" (watch exports it):
# bash's checkwinsize, on even in a script, would otherwise set it from the
# terminal after the first external command whenever stderr is a tty, and
# "sq > file" would then write colour escapes into the file.
shopt -u checkwinsize

die() { printf 'sq: %s\n' "$*" >&2; exit 2; }   # a usage error, never a table

# Outside text - a filter, a setting, the host name, a collector's stderr - is
# decoded as UTF-8 before it reaches the screen or a message, as bytes and never
# by the locale: a control character (C0 and DEL, and C1, U+0080-U+009F, whose
# \302\233 is CSI and \302\235 OSC) goes, any other character stays as it is, and
# each piece that is no UTF-8 at all (a Latin-1 byte, a halved character: one
# "maximal subpart", Unicode §3.9) becomes one ␚, U+241A.  So the terminal and
# gawk only ever get whole characters, and as only whole ones are taken out,
# nothing new can join where one went: a single pass, its work linear.
# At most MAX characters are kept, 4096 by default: more than a screen line
# shows, while each text reaches gawk as an environment string, which Linux
# refuses beyond 128 KiB.  The rest is still read, so a writer never meets a
# closed pipe.  With FILE only its first line is read, at most 1 MiB of it, and
# a character that bound cut in half goes, as the cut made it, not the text.
# Under env, so bash itself never switches locale for it.
scrub() (   # scrub [-f FILE] [MAX]: stdin, or the first line of FILE, onto stdout
	bound=0
	[ "${1-}" != -f ] || { bound=1048576; exec < <(head -c $((bound + 1)) -- "$2"); shift 2; }
	exec env LC_ALL=C gawk -v max="${1:-4096}" -v bound=$bound '
	BEGIN {
		CONT = "[\200-\277]"; BAD = "\342\220\232"     # a continuation byte; U+241A
		CTL = "[^\040-\176\200-\377]"                 # C0 and DEL
		# every unit that is not ASCII, the longest at each place (no group
		# anywhere: one makes gawk track submatches, 40 times slower): a
		# sequence of Unicode Table 3-7, else the longest start of one, else a
		# byte that starts none
		UNIT = "[\302-\337]" CONT \
		    "|\340[\240-\277]" CONT "|[\341-\354\356\357]" CONT CONT "|\355[\200-\237]" CONT \
		    "|\360[\220-\277]" CONT CONT "|[\361-\363]" CONT CONT CONT "|\364[\200-\217]" CONT CONT \
		    "|[\302-\337]|\340[\240-\277]?|[\341-\354\356\357]" CONT "?|\355[\200-\237]?" \
		    "|\360|\360[\220-\277]" CONT "?|[\361-\363]" CONT "?" CONT "?|\364|\364[\200-\217]" CONT "?" \
		    "|[\200-\301\365-\377]"
		# of those, wrapped in \001 \002, the ill-formed ones, no character: a
		# byte that leads none, or a lead with fewer bytes than it needs
		ILL = "\001[\200-\337]\002|\001[\340-\357]" CONT "?\002|\001[\360-\377]" CONT "?" CONT "?\002"
	}
	# globals, kept from line to line: kept, the characters printed so far, and
	# done, set once nothing more is printed (max reached, or the one line of FILE)
	function emit(s,   len, i, lead) {   # s, as much of it as max still allows
		len = length(s)
		for (i = 1; i <= len && kept < max; kept++)      # a lead byte tells the length
			i += (lead = substr(s, i, 1)) < "\300" ? 1 : lead < "\340" ? 2 : lead < "\360" ? 3 : 4
		printf "%s", substr(s, 1, i - 1); if (i <= len) done = 1
	}
	done { next }
	# a line at a time, as a newline ends every sequence (and goes itself)
	{	s = $0; cut = bound && length(s) > bound
		if (!cut && s !~ /[\200-\377]/) gsub(CTL "+", "", s)
		else {
			gsub(CTL, "\r", s)                          # each a \r, so \001 \002 are free
			gsub(UNIT, "\001&\002", s)
			if (cut) {   # the unit the bound ran through, or the byte past it
				tail = substr(s, length(s) - 5)        # room for \001, 4 bytes, \002
				s = substr(s, 1, length(s) - (match(tail, /\001[\200-\377]+\002$/) ? length(tail) - RSTART + 1 : 1))
			}
			gsub(/\r+|\001\302[\200-\237]\002/, "", s)
			gsub(ILL, BAD, s)
			gsub(/[\001\002]+/, "", s)
		}
		emit(s); if (bound) done = 1
	}'
)

# The field separator is a nonce minted per run, never per session: a job name
# is fixed at submit time and a node's drain reason when the admin sets it, so
# neither can contain a separator minted afterwards.  That is what makes a record
# boundary unforgeable - a field holding "|", a tab or a newline can then neither
# inject a row nor steal a field.
# A nonce is usable only if it is letter-led (squeue's -O grammar is
# type[:[.][size][suffix]], so a suffix starting with digits is read as a FIELD
# WIDTH: "JobID:1234567890" segfaults squeue, "JobID:0" drops the separator),
# alphanumeric (no ERE metacharacter, so gawk takes it as FS verbatim) and long
# enough that no name can hold it by chance.
nonce_ok() {
	case ${1:-} in
		''|[!A-Za-z]*|*[!A-Za-z0-9]*) return 1 ;;
	esac
	[ "${#1}" -ge 17 ]
}
mint_nonce() {
	local n=
	[ -z "${SRANDOM:-}" ] ||                              # bash >= 5.1
		printf -v n 'N%08x%08x%08x' "$SRANDOM" "$SRANDOM" "$SRANDOM" 2>/dev/null
	nonce_ok "$n" ||                                      # never "tr -dc </dev/urandom":
		n=N$(LC_ALL=C od -An -tx1 -N12 /dev/urandom 2>/dev/null | LC_ALL=C tr -d ' \n')
	nonce_ok "$n" || return 1
	printf '%s' "$n"
}

# The helpers from here to the dashboard are shared with the subcommands, so
# they come before either.  The tmp dir is made only once the command line
# has been read (make_tmp), so -h and a usage error behave the same with an
# unusable TMPDIR; the EXIT trap holds under set -u for a run that never named
# the dashboard's files or the tmp dir.
tmp=
make_tmp() { tmp=$(mktemp -d) || exit 1; }
memtmp=                                         # the memuse snapshot being written
statetmp=                                       # the bell's state being written
collect_pid= log_pids=                          # a client collect -w waits for; sq log's
                                                # tail and its sentinel
collect_pidfile= job_sentinel_pid=              # where collect -w names that client for
                                                # a sentinel; sq job's sentinel
# The processes first, by pid (each ended with TERM and waited for, so none
# outlives sq), then the files
cleanup() {
	local pid
	for pid in $collect_pid $log_pids $job_sentinel_pid; do kill "$pid" 2>/dev/null; done
	for pid in $collect_pid $log_pids $job_sentinel_pid; do wait "$pid" 2>/dev/null; done
	[ -z "$tmp" ] || rm -rf "$tmp"; rm -f ${statetmp:+"$statetmp"} ${memtmp:+"$memtmp"}
}
trap cleanup EXIT

# an unreachable controller makes sinfo/squeue block, not fail, so bound them.
# timeout reads 0 as "no limit" and errors out on anything non-numeric, so both
# fall back to the default; -k kills a client that ignores SIGTERM
tmo=${SQ_TIMEOUT:-5}
case $tmo in ''|*[!0-9.]*|*.*.*) tmo=5 ;; esac          # 2.5 is valid to timeout
[ -n "$(printf '%s' "$tmo" | tr -d '0.')" ] || tmo=5    # 0, 0.0 mean "no limit"
# Every collector runs through collect, so its own stderr (NAME.err) and
# timeout's (NAME.tmo) land apart: the client's fd 3 becomes its stderr, and
# timeout keeps fd 2.  sh -c exec keeps the pid, so TERM and KILL reach the
# client itself, and passing the tool as $0 lets sh say "sinfo: ... not found".
# Wrapped in 2>/dev/null, so bash prints no "Killed" or "Segmentation fault"
# notice of its own on the screen.  Environment prefixes on the call reach the
# client.
# -w runs timeout in the background and waits for it, its pid in collect_pid:
# a trapped signal then acts at once instead of when the client is done, and
# the EXIT cleanup can end the client through timeout, which sits in a process
# group of its own that a Ctrl-C never reaches.  The dashboard does not use it,
# as a Ctrl-C there is left to what bash makes of a foreground client.  With
# collect_pidfile set, -w also writes that pid there while it waits (and
# empties the file after), so a sentinel can end the client once sq is gone.
collect() {   # collect [-t SECONDS] [-w] NAME TOOL ARGS...: stdout into $tmp/NAME,
	local limit=$tmo name bg=0 rc   # bounded by SECONDS, SQ_TIMEOUT's by default
	[ "$1" != -t ] || { limit=$2; shift 2; }
	[ "$1" != -w ] || { bg=1; shift; }
	name=$1; shift
	set -- timeout $verbose -k 2 "$limit" sh -c 'exec "$@" 2>&3 3>&-' "$1" "$@"
	if [ $bg = 0 ]; then
		{ "$@" > "$tmp/$name" 3> "$tmp/$name.err" 2> "$tmp/$name.tmo"; } 2>/dev/null
	else
		{ "$@" > "$tmp/$name" 3> "$tmp/$name.err" 2> "$tmp/$name.tmo" &
		  collect_pid=$!; [ -z "$collect_pidfile" ] || printf '%s\n' "$collect_pid" > "$collect_pidfile"
		  wait "$collect_pid"; rc=$?; collect_pid=
		  [ -z "$collect_pidfile" ] || : > "$collect_pidfile"; return $rc; } 2>/dev/null
	fi
}
# --verbose makes timeout say "sending signal ..." before it signals; it exists
# since coreutils 8.29, and an older timeout refuses it (rc 125) without running
# anything, so it is asked for only where a silent probe accepts it
verbose=
timeout --verbose 1 true > /dev/null 2>&1 && verbose=--verbose
# Why a collector failed, into NAME (empty: it did not), and into NAME_real the
# part of that which is real text: the timeout, or the first line of its
# stderr, which can echo what the user typed and so loses its control
# characters like every other outside text.  With nothing readable there (a
# crash prints nothing) NAME is made up from the exit status, because an empty
# reason reads as success: "queue is empty" and a footer of 0 jobs from a
# squeue that never answered.
# A client that ignores SIGTERM is killed 2s past the deadline, and timeout
# then exits 137 like any SIGKILL; it is the timeout when timeout said it
# signalled (NAME.tmo is not empty - only its existence is read, never its
# translatable text), or when this timeout cannot say so (no --verbose).  That
# also counts a rare start-up warning of timeout's, or timeout itself killed
# from outside, as the timeout.  A 137 that timeout kept quiet about is a SIGKILL
# from elsewhere: a crash.  Otherwise NAME.tmo is shown only for rc 125 with
# an empty NAME.err, timeout's own failure (an unknown option, no fork); its
# "dumped core" after a crash never is.
why_of() {   # why_of NAME RC OUTPUT TOOL: OUTPUT as collect left it, e.g. $tmp/nodes
	local rc=$2 real= why=
	if [ "$rc" = 124 ] || { [ "$rc" = 137 ] && { [ -s "$3.tmo" ] || [ -z "$verbose" ]; }; }; then
		real="no response after ${tmo}s"
	elif [ "$rc" != 0 ]; then
		real=$(scrub -f "$3.err")
		[ -n "$real" ] || [ "$rc" != 125 ] || real=$(scrub -f "$3.tmo")
	fi
	if [ "$rc" != 0 ]; then
		if   [ -n "$real" ];    then why=$real
		elif [ "$rc" -gt 128 ]; then why="$4 crashed (signal $((rc - 128)))"
		else                         why="$4 failed (exit $rc)"
		fi
	fi
	printf -v "$1" '%s' "$why"; printf -v "$1_real" '%s' "$real"
}
# the reason a line names where several could: any real one beats one made up
# from an exit status, and within each kind the first NAME given wins
first_why() {   # first_why NAME... (each set like why_of sets it)
	local v r
	for v in "$@"; do r=${v}_real; [ -z "${!r}" ] || { printf '%s' "${!r}"; return; }; done
	for v in "$@"; do [ -z "${!v}" ] || { printf '%s' "${!v}"; return; }; done
}

# gawk functions shared by the programs below (the dashboard's, its memory
# and allocation readers, sq job's), prepended to each
shared_awk='
# a size as Slurm prints it MB-based (%m, the mem= of tres-alloc), an exact
# M/G/T/P suffix and maybe a fraction (1.50G), in MB; -1 for anything else
# (%m prints 0 for --mem=0)
function size_mb(x,   u) {
  if (x !~ /^[0-9]+([.][0-9]+)?[MGTP]$/) return -1
  u = substr(x, length(x))
  return substr(x, 1, length(x) - 1) * (u == "G" ? 1024 : u == "T" ? 1048576 : u == "P" ? 1073741824 : 1)
}
# mem= of a tres-alloc text in MB, -1 when there is none
function tres_mem(tres,   x) {
  if (!match(tres, /(^|,)mem=[0-9]+([.][0-9]+)?[MGTP](,|$)/)) return -1
  x = substr(tres, RSTART, RLENGTH); sub(/^,?mem=/, "", x); sub(/,$/, "", x)
  return size_mb(x)
}
# Every shape squeue prints for %i / JobID, anchored at the start: plain, het
# component (10646+0), array task (10646_3) and pending array
# (10646_[0-9,12%2], 10646_[0-12:2]).  The bracket is the grammar Slurm prints
# and nothing looser, because the anchor is what a forged record has to get
# past: term ("," term)* ("%" N)?, term = N | N-N | N-N:N.  N is at most 7
# digits (MaxArraySize cannot exceed 4000001), so no row can count 1e20 or
# NaN, which passes every "< 1" test
function id_anchor(   an, at) {
  an = "[0-9]{1,7}"; at = an "(-" an "(:" an ")?)?"
  return "^[0-9]+([+][0-9]+)?(_([0-9]+|\\[" at "(," at ")*(%" an ")?\\]))?"
}
# How many jobs an id stands for: a Slurm bracket its tasks, any other id one.
# 0 means it is no id, and the record gate skips it: the anchor cannot say
# a<=b or step>0, and a bracket counted 0 or 1 would be a wrong number nobody
# can see is wrong.  Each term is ONE anchored match, because a split on "-"
# then ":" lets gawk read "12:2" as 12 and count 0-12:2 as 13.
function ntasks(id, anchor,   br, t, nt, i, m, sum) {
  if (id !~ anchor) return 0
  if (!match(id, /_\[([^]]*)\]/, br)) return 1
  sub(/%[0-9]+$/, "", br[1])              # a throttle limits concurrency, not membership
  nt = split(br[1], t, ",")
  for (i=1; i<=nt; i++) {
    if (!match(t[i], /^([0-9]+)(-([0-9]+)(:([0-9]+))?)?$/, m)) return 0
    if (m[2] == "") { sum++; continue }
    if (m[3]+0 < m[1]+0 || (m[4] != "" && m[5]+0 < 1)) return 0
    sum += int((m[3] - m[1]) / (m[4] != "" ? m[5] : 1)) + 1
  }
  return sum
}
# the colours: an SGR escape, or nothing when colour is off
function e(c) { return color ? "\033[" c "m" : "" }       # colour, or nothing
function ago(s) {
  if (s < 0)    return "-"
  if (s < 60)   return s "s"
  if (s < 3600) return int(s/60) "m"
  return int(s/3600) "h"
}
function dur(s,   a, b, m, sec) {                         # 3-12:04:05 -> seconds
  if (s !~ /[0-9]/) return -1
  sec = 0
  if (match(s, /^([0-9]+)-(.*)$/, a)) { sec += a[1]*86400; s = a[2] }
  m = split(s, b, ":")
  if      (m == 3) sec += b[1]*3600 + b[2]*60 + b[3]
  else if (m == 2) sec += b[1]*60 + b[2]
  else if (m == 1) sec += b[1]
  return sec
}
function elap(s) {                        # 3-12:04:05 -> 3d12h.  The zero-padded
  if (s < 0)     return "-"               # HH:MM:SS the collectors print costs a
  if (s < 60)    return s "s"             # folded range up to 11 columns, which is
  if (s < 3600)  return int(s/60) "m" sprintf("%02ds", s % 60)     # what used to
  if (s < 86400) return int(s/3600) "h" sprintf("%02dm", int(s % 3600 / 60))
  return int(s/86400) "d" sprintf("%02dh", int(s % 86400 / 3600))   # overrun the edge
}
function exlabel(rc, sg) {                # the second field of an ExitCode is a
  if (sg == 0)   return rc ""             # signal only up to 31: Slurm stores its
  if (sg <= 31)  return rc "/sig" sg      # own errors (53 = task I/O setup failed)
  if (sg == 125) return rc "/oom"         # and its OOM marker, 125, in that slot too
  return rc "/err" sg
}
# one field of an ExitCode: sacct prints 0-127 and the squeue fallback up to
# 255 in the first, so anything but 1-3 digits ("1e3", "53.9", "+inf", "-1",
# empty) reads as 0 instead of leaking through
function exfield(s) { return (s ~ /^[0-9]{1,3}$/) ? s+0 : 0 }
# squeue decodes the raw exit_code of slurmctld, which sets 1 for a job it
# ended itself (a deadline, a lost batch script, a node gone): squeue calls
# that signal 1, so in the fallback (fb) 0:1 is read as 1:0, as slurmdbd stores it
function xcm(id, x, fb,   a, rc, sg) {    # per job, over its allocation row and its
  split(x, a, ":")                        # steps ("sacct -X" would say 0:0): the
  rc = exfield(a[1]); sg = exfield(a[2])  # first non-zero return code and the first
  if (fb && rc == 0 && sg == 1) { rc = 1; sg = 0 }
  if (JRC[id] == 0 && rc != 0) JRC[id] = rc               # non-zero second field,
  if (JSG[id] == 0 && sg != 0 || sg == 125) JSG[id] = sg  # but an OOM always wins,
}                                         # never hidden behind an earlier 15
# one node bar of wd cells: a allocated and u in use, of tot.  █ in use within
# the allocation (hue), ▒ allocated but idle (dim hue), ▓ in use beyond the
# allocation (magenta), ░ free (dim), or · when the use is not known (u < 0).
# Both counts round to the nearest cell; a load above the core count simply
# fills the bar.  No cells, no escapes either
function cells(a, u, tot, wd, hue,   na, nu, i, x) {
  if (wd <= 0) return ""
  na = tot ? int(a*wd/tot + 0.5) : 0
  nu = (u < 0) ? -1 : tot ? int(u*wd/tot + 0.5) : 0
  for (i=0; i<wd; i++)
    if      (i < na && i < nu) x = x e(hue) "█"
    else if (i < na)           x = x e("2;" hue) "▒"
    else if (i < nu)           x = x e("35") "▓"
    else                       x = x e("2") (nu < 0 ? "·" : "░")
  return x e("0")
}
# ---- the MEM cell of the running jobs of the caller -------------------------
# Form b, the default: used/allocated, both in the unit of the allocation,
# binary: M below 1000 MiB, T from 1 TiB, else G.  A whole allocation prints
# whole and its use as ever: from 10 up whole, below that with one decimal and
# no ".0".  An allocation that is not whole prints with one decimal, cut, never
# rounded up (15600M is 15.2G), and its use with one decimal too.  Within that
# decimal form a job under its allocation never reads as much (one step, 0.1,
# below it), nor one at or over it less.  The used part is padded to the
# allocated figure + 2 (+ 1 with a decimal: either way a use up to ten times the
# allocation), so a cell is as wide as its allocation makes it, whatever the
# reading, and nothing moves under watch.  WHOLE is the narrower fallback for a
# screen: an allocation from 10 up that is not whole is cut to a whole number
# (one below 10 keeps its decimal), and every use is cut to a whole number,
# with no guard: 7.66 of 15.23 is 7/15G, 7.7 of 16 is 7/16G, under 1G is 0,
# and 15/15G at 99 % leaves the rest to the colour.  MARK ("?" no reading,
# "!" a failed one) stands in for the use.
function memnum(x,   s) {
  if (x >= 9.95) return sprintf("%d", int(x + 0.5))
  s = sprintf("%.1f", x); sub(/[.]0$/, "", s); return s
}
function memunit(mb) { return (mb >= 1048576) ? "T" : (mb >= 1000) ? "G" : "M" }
function mb_per(unit) { return (unit == "T") ? 1048576 : (unit == "G") ? 1024 : 1 }
# MB in that unit rule, as form b prints an allocation: whole, or one
# decimal, cut (15600M is 15.2G); WHOLE cuts one from 10 up to a whole number
function memsize(mb, whole,   unit, tenths) {
  unit = memunit(mb)
  tenths = int(mb * 10 / mb_per(unit))         # in tenths, cut
  if (mb % mb_per(unit) == 0)      return sprintf("%d", mb / mb_per(unit)) unit
  if (whole && tenths >= 100)      return sprintf("%d", int(tenths / 10)) unit
  return sprintf("%.1f", tenths / 10) unit
}
function memcell(used_bytes, alloc_mb, mark, whole,   unit, mb_per_unit, alloc_shown, decimal, used, pct, pad) {
  unit = memunit(alloc_mb); mb_per_unit = mb_per(unit)
  alloc_shown = memsize(alloc_mb, whole); sub(/[MGT]$/, "", alloc_shown)
  decimal = (index(alloc_shown, ".") > 0)
  pad = length(alloc_shown) + (decimal ? 1 : 2)
  if (mark != "") used = mark
  else {
    used = used_bytes / 1048576 / mb_per_unit; pct = used_bytes / (alloc_mb * 1048576) * 100
    if (whole) used = sprintf("%d", int(used))
    else {
      used = decimal ? sprintf("%.1f", used) : memnum(used)
      if (pct < 100 && used + 0 >= alloc_shown + 0) used = sprintf("%.1f", alloc_shown - 0.1)
      else if (pct >= 100 && used + 0 < alloc_shown + 0) used = alloc_shown
    }
  }
  return sprintf("%*s", pad, used) "/" alloc_shown unit
}
function memcolour(p) { return (p >= 100) ? "1;31" : (p >= 90) ? "31" : (p >= 70) ? "33" : "32" }
# JOBMEM readings: the snapshot lines, "<id> TAB ok|none|failed TAB
# <bytes>", into job_outcome and job_bytes, by unique job id
function mem_load(file,   ln, mf) {
  while ((getline ln < file) > 0) { split(ln, mf, "\t"); job_outcome[mf[1]] = mf[2]; job_bytes[mf[1]] = mf[3] + 0 }
  close(file)
}
# what a running job of the caller reads, by its unique id, its allocation in
# MB and its node count: "failed" when the allocation call failed, else the
# snapshot outcome where it is measured (an allocation, one node) and in
# the snapshot (not started since), else "none"
function mem_outcome(id, alloc_mb, nodes) {
  if (memfail) return "failed"
  return (alloc_mb > 0 && nodes == "1" && (id in job_outcome)) ? job_outcome[id] : "none"
}
# the final states, by squeue code, into DONE, and those that are failures
# (worth a bell, red) into BAD
function final_states(   ts, i) {
  split("CD F CA TO NF OOM DL PR BF RV SE", ts, " "); for (i in ts) DONE[ts[i]] = 1
  split("F TO NF OOM DL BF", ts, " "); for (i in ts) BAD[ts[i]] = 1
}
'
# colour: honour NO_COLOR, else auto-detect.  A pipe with COLUMNS set is
# watch, which wants the escapes; a bare pipe or redirect does not.  For the
# dashboard and sq job, from --color/--no-color and SQ_COLOR
color_resolve() {
	[ "$color" = auto ] || return 0
	if   [ -n "${NO_COLOR:-}" ]; then color=0
	elif [ -t 1 ];               then color=1
	elif [ -n "${COLUMNS:-}" ];  then color=1
	else color=0
	fi
}

# gawk measures every width with length(), which counts characters only under
# a UTF-8 locale: under LC_ALL=C (cron, systemd, containers) it counts bytes,
# and the whole layout changes meaning.  So gawk runs under the caller's locale
# if that is UTF-8, else C.UTF-8, else the first UTF-8 locale installed; with
# none at all, under the caller's as before.  A locale is UTF-8 when its
# charmap says so (ja_JP.eucJP counts "…" as one character too, but "█" as
# two) and gawk, which does the counting, agrees.
# Set through env, never as "LC_ALL=x cmd": bash applies that to itself too,
# and restoring a caller's LC_ALL that names no installed locale puts a
# setlocale warning on the screen each time.
utf8_ok() {
	[ "$(env LC_ALL="$1" locale charmap 2>/dev/null)" = UTF-8 ] &&
	env LC_ALL="$1" gawk 'BEGIN { exit length("…") != 1 }' 2>/dev/null
}
gawk_locale() {   # the locale gawk runs in, into gloc
	gloc=${LC_ALL:-}                 # empty: gawk reads LC_CTYPE and LANG as before
	if ! utf8_ok "$gloc"; then
		gloc=C.UTF-8
		utf8_ok "$gloc" || gloc=$(locale -a 2>/dev/null | LC_ALL=C grep -i '\.utf-\{0,1\}8' |
			while read -r l; do utf8_ok "$l" && { printf '%s' "$l"; break; }; done)
		[ -n "$gloc" ] || gloc=${LC_ALL:-}
	fi
}

# ---- memory use of the caller's own running jobs (JOBMEM) ------------------
# The dashboard asks only when the queue holds one: a running row whose %U is
# `id -u`; sq job when the job it shows is one.  Then the allocation of every
# job of the caller's, unfiltered by the screen's filters, on every refresh
# (cheap, and it must match this refresh), and sstat's reading of the running
# ones that have an allocation and one node (sstat answers only a job's owner,
# and a multi-node reading is not measured): one call for all of them, at most
# every 30 s, whatever the filters, so every sq of a user's shares it, sq job
# too.  The last call's result is a snapshot in memuse beside the bell's
# state: the epoch of the call, then "<id> TAB ok|none|failed TAB <bytes>".
# For gawk: $tmp/memalloc "<id> TAB <state> TAB <MB> TAB <nodes>",
# $tmp/memread the snapshot's job lines, memfail=1 when the allocation call
# failed (every own running row then reads "!").  myuid is the caller's uid,
# set by whoever calls these.
memfail=0 myuid=
# the snapshot in use: whole and well-formed, and taken in the last 30 s, its
# job lines into memread (rc 0); anything else (missing, garbled, from the
# future) empties memread (rc 1), and is a call.  memdir is the snapshot's
# directory, empty when there is none to use, memnow the epoch it is judged by
jobmem_snapshot() {
	# XDG_CACHE_HOME counts only when absolute, as a relative one would
	# put the snapshot wherever sq happens to run.  No usable directory,
	# or a memuse there that is no regular file, means a call on every
	# run, silently, and nothing written
	memdir=
	case ${XDG_CACHE_HOME:-} in
		/*) memdir=$XDG_CACHE_HOME/sq ;;
		*)  case ${HOME:-} in /*) memdir=$HOME/.cache/sq ;; esac ;;
	esac
	[ -z "$memdir" ] || mkdir -p "$memdir" 2>/dev/null || memdir=
	[ -z "$memdir" ] || ! [ -e "$memdir/memuse" ] || [ -f "$memdir/memuse" ] || memdir=
	printf -v memnow '%(%s)T' -1
	if [ -n "$memdir" ] && env LC_ALL=C gawk -v now="$memnow" '
		NR == 1 { if ($0 !~ /^[0-9]+$/ || now - $0 < 0 || now - $0 >= 30) bad = 1; next }
		$0 !~ /^[0-9]+\t(ok|none|failed)\t[0-9]+$/ { bad = 1 }
		{ print }
		END { exit (NR == 0 || bad) }' "$memdir/memuse" > "$tmp/memread" 2>/dev/null
	then return 0
	fi
	: > "$tmp/memread"; return 1
}
# The allocation call, then the snapshot if it is fresh, else sstat's reading,
# written as the new snapshot.  -w: every call through collect -w, as a
# subcommand makes them
jobmem_collect() {   # jobmem_collect [-w]
	local w=${1-} memids memrc sstat_limit
	: > "$tmp/memalloc"; : > "$tmp/memread"
	# framed like the fallback's call: the format in SQUEUE_FORMAT2, so the
	# queue nonce never reaches a command line.  StateCompact is %t's letter
	SQUEUE_FORMAT2="JobID:$nonce,StateCompact:$nonce,tres-alloc:$nonce,NumNodes:$nonce" \
		collect $w alloc squeue -h -u "$myuid"
	# a job without mem= has no known allocation (0).  Output that is not
	# every record whole fails the call as a non-zero exit does
	if [ $? -ne 0 ] || ! env LC_ALL=C gawk "$shared_awk"'
		BEGIN { RS = ENVIRON["SQ_NONCE"] "\n"; FS = ENVIRON["SQ_NONCE"] }
		NF != 4 || $1 !~ /^[0-9]+$/ || RT == "" { bad = 1; exit }
		{ mb = tres_mem($3); printf "%s\t%s\t%.0f\t%s\n", $1, $2, (mb < 0) ? 0 : mb, $4 }
		END { exit bad }' "$tmp/alloc" > "$tmp/memalloc"
	then memfail=1; : > "$tmp/memalloc"; return
	fi
	memids=$(env LC_ALL=C gawk -F '\t' '$2 == "R" && $3 > 0 && $4 == "1" { printf "%s%s", (n++ ? "," : ""), $1 }' "$tmp/memalloc")
	jobmem_snapshot && return
	[ -n "$memids" ] || return 0
	# its own budget, min(SQ_TIMEOUT, 2) s: a node that does not
	# answer must not hold every refresh for the whole timeout
	sstat_limit=$(env LC_ALL=C gawk -v t="$tmo" 'BEGIN { print (t + 0 < 2) ? t : 2 }')
	collect -t "$sstat_limit" $w sstat sstat -n -p -a --noconvert -j "$memids" -o JobID,TRESUsageInTot
	memrc=$?
	# A job reads "ok" with a complete row of its own (-p ends every
	# row in "|"), each step once, as the id of an array's base task
	# also returns its other tasks' steps; its bytes are the sum of
	# mem= over them.  "failed" when the call failed, a stderr line
	# names the job ("job N", "StepId=N.", bar "No steps running"), or
	# its rows carry no mem= at all; "none" otherwise.  A line naming
	# no job asked for is ignored.  Each stderr line is read once.
	env LC_ALL=C gawk -v ids="$memids" -v rc="$memrc" '
		BEGIN { n = split(ids, Q, ","); for (i = 1; i <= n; i++) REQ[Q[i]] = 1 }
		ARGIND == 1 {
			if (!match($0, /^([0-9]+)[.][A-Za-z0-9_+]+[|]([^|]*)[|]$/, m) || !(m[1] in REQ)) next
			if ((sid = substr($0, 1, index($0, "|") - 1)) in SEEN) next
			SEEN[sid] = 1; ROWS[m[1]] = 1
			if (match(m[2], /(^|,)mem=[0-9]+(,|$)/)) {
				b = substr(m[2], RSTART, RLENGTH); gsub(/[^0-9]/, "", b)
				BYTES[m[1]] += b; HASMEM[m[1]] = 1
			}
			next
		}
		/No steps running/ { next }
		{	rest = $0
			while (match(rest, /job [0-9]+|StepId=[0-9]+[.]/)) {
				id = substr(rest, RSTART, RLENGTH); gsub(/[^0-9]/, "", id)
				if (id in REQ) FAIL[id] = 1
				rest = substr(rest, RSTART + RLENGTH)
			}
		}
		END {
			for (i = 1; i <= n; i++) {
				id = Q[i]
				o = (rc != 0 || (id in FAIL) || ((id in ROWS) && !(id in HASMEM))) ? "failed" \
				  : (id in ROWS) ? "ok" : "none"
				printf "%s\t%s\t%.0f\n", id, o, (o == "ok") ? BYTES[id] : 0
			}
		}' "$tmp/sstat" "$tmp/sstat.err" > "$tmp/memread"
	# renamed into place, so a reader never meets half a snapshot
	if [ -n "$memdir" ] && memtmp=$(mktemp "$memdir/memuse.XXXXXX" 2>/dev/null); then
		{ printf '%s\n' "$memnow"; cat "$tmp/memread"; } > "$memtmp" 2>/dev/null &&
			mv -f "$memtmp" "$memdir/memuse" 2>/dev/null
		rm -f "$memtmp"; memtmp=
	fi
}

# ============================================================================
# sq log JOBID: a job's output file, followed while the job runs
# ============================================================================
# Franz's decisions (2026-10-20): the whole file, live, ending shortly after
# the job ends, raw, to be piped or followed; stdout, --err for stderr; a job
# Slurm forgot is refused, an array asks for a task, a requeue ends the stream
# with a note, notes go to stderr also into a pipe, and a cluster selection is
# refused, as the file is read on this machine.
# sq computes the path the way the job's slurmstepd does, from the raw -o/-e
# pattern squeue prints (scontrol expands only some letters), and polls Slurm
# every 5 s in every phase: waiting for the job to start, for the file to
# appear, and while tail streams it.  The stream ends only at a final state
# (never during CG, when a job may still write), after a 3 s grace.
log_help() {
	cat <<'EOF'
usage: sq log [-e|--err] [-n N] [--no-follow] JOBID

Prints a batch job's output file from its start, then follows it while the
job runs, and ends shortly (within about 10 s) after the job ends: pipe it
to less or grep, or watch it as it comes.  JOBID is 12345, an array task
12345_4, or a het job 12345+1 (its leader writes the output).  A pending job
is waited for until it runs and its file is there.

  -e, --err      the job's stderr file instead of its stdout file
  -n N           only the last N lines, then follow
  --no-follow    print what is there now and stop
  -h, --help     this help

Notes ("sq log: ...") go to stderr, also into a pipe; the file's own bytes
are passed on as they are.  Exit 0 when done, whatever the job's own outcome
(a note names it), 1 when the file cannot be shown, 2 for a usage error,
128+N when stopped by signal N.

Good to know:
- The path is computed from -o/-e the way Slurm's job does.  A file name that
  is reused (no %j in it) may first show an earlier run's text.
- sq log follows for as long as Slurm cannot tell it the job ended: while
  Slurm does not answer, it keeps following.
- "Live" can lag: a job on another node writes through NFS, and a program
  buffers its output into a file (python -u, or stdbuf -oL, helps).
- A requeued job ends the stream with a note; run sq log again for its new run.
- Under watch, use --no-follow -n N:  watch -n 5 sq log --no-follow -n 20 12345
- Slurm forgets a job about 5 minutes after it ends; its path is then unknown.
EOF
}

# every message names sq log and is scrubbed whole: it carries paths, names
# and reasons, all of them outside text
log_say()   { printf 'sq log: %s\n' "$(printf '%s' "$1" | scrub)" >&2; }
log_usage() { log_say "$*"; exit 2; }          # the command line is wrong
log_fail()  { log_say "$*"; exit 1; }          # the file cannot be shown
log_noted=
log_note() {   # log_note KIND TEXT: TEXT, the first time KIND has something to say
	case " $log_noted " in *" $1 "*) return ;; esac
	log_noted="$log_noted $1"; log_say "$2"
}
# SLURM_CLUSTERS, -M/--cluster(s), --federation and --sibling would ask another
# cluster about the job, while its file is read here: one text per cause
log_refuse_cluster() {
	case $1 in
		SLURM_CLUSTERS) log_usage "job output files are read on this machine; unset SLURM_CLUSTERS" ;;
		*) log_usage "job output files are read on this machine; drop $1" ;;
	esac
}

# The facts, one squeue call: every SQUEUE_* variable unset, as SQUEUE_USERS,
# _PARTITION, _NAMES ... filter even under --jobs and SQUEUE_SORT can fail the
# call, the format in SQUEUE_FORMAT2, framed by the nonce like the dashboard's
# calls (-O reads Field:suffix as size 0, the field whole), and the time and
# bitstring formats pinned
log_fields="JobID ArrayJobID ArrayTaskID HetJobID HetJobOffset StateCompact RestartCnt
	BatchFlag BatchHost WorkDir STDOUT STDERR UserName Name StartTime Reason exit_code"
log_ask() {   # log_ask ID HOW JOB [TASK]: ask about ID, the record HOW names into log_*
	SLURM_TIME_FORMAT=%s SLURM_BITSTR_LEN=0 SQUEUE_FORMAT2=$log_fmt \
		collect -w facts squeue -h --jobs="$1" -t all
	local rc=$? kv k
	local -A said=()
	log_verdict= log_why=
	if [ $rc -ne 0 ]; then
		# a job Slurm no longer knows is rc 1 and this text (23.11.4, measured)
		if [ $rc = 1 ] && LC_ALL=C grep -q 'Invalid job id specified' "$tmp/facts.err" 2>/dev/null
		then log_verdict=none
		else log_verdict=fail; why_of log_why $rc "$tmp/facts" squeue
		fi
		return
	fi
	log_pick "$2" "$3" "${4-}" > "$tmp/pick" &&
	while IFS= read -r -d '' kv; do   # KEY=VALUE, the keys log_pick writes
		case " $log_keys " in *" ${kv%%=*} "*) said[${kv%%=*}]=${kv#*=} ;; esac
	done < "$tmp/pick"
	case ${said[verdict]-} in
		''|bad) log_verdict=fail; log_why="squeue output unreadable"; return ;;
	esac
	# a readable answer replaces every field; a failed or unreadable one
	# above changed only the verdict, so the last good record's host and
	# paths still describe the job for the notes
	for k in $log_keys; do printf -v "log_$k" '%s' "${said[$k]-}"; done
}
# A job's output paths, from the raw -o/-e patterns squeue prints, the way its
# slurmstepd computes them: gawk functions over R[record, squeue -O field
# name] (JobID ArrayJobID ArrayTaskID BatchHost UserName Name WorkDir STDOUT
# STDERR), shared by sq log and sq job
fname_awk='
function onetask(r) { return R[r, "ArrayTaskID"] ~ /^[0-9]+$/ }   # one task, numbered
# slurmstepd, src/slurmd/common/fname.c (23.11.4): remove_path_slashes()
# drops each backslash and keeps the second of two, and any backslash at
# all means no expansion
function unslash(f,   out, i, c) {
	for (i = 1; i <= length(f); i++) {
		c = substr(f, i, 1)
		if (c == "\\" && substr(f, i + 1, 1) == "\\") { out = out c; i++ }
		else if (c != "\\") out = out c
	}
	return out
}
function pad(v, wid) { return wid ? sprintf("%0" wid "d", v) : v }
# _create_batch_fname(): %% is %, a width (10 at most) zero-pads the
# numbers, %N is the batch host short name, %s "batch", %n %t 0; after a
# width an unknown letter keeps only the width last digit, and an unknown
# letter without one stays as written, "%" and all
function expand(f, r,   out, p, q, n, c, wid, host, v) {
	n = length(f); p = q = 1
	host = R[r, "BatchHost"]; sub(/[.].*/, "", host)
	while (p <= n) {
		if (substr(f, p, 1) != "%") { p++; continue }
		if (substr(f, p + 1, 1) == "%") { out = out substr(f, q, p + 1 - q); p += 2; q = p; continue }
		p++; wid = 0
		if (substr(f, p, 1) ~ /[0-9]/) {
			out = out substr(f, q, p - 1 - q)
			match(substr(f, p), /^[0-9]+/)
			wid = substr(f, p, RLENGTH) + 0; if (wid > 10) wid = 10
			p += RLENGTH; q = p - 1
			if (p > n) break
		}
		c = substr(f, p, 1)
		if      (c == "a") v = pad(onetask(r) ? R[r, "ArrayTaskID"] : 4294967294, wid)   # NO_VAL
		else if (c == "A") v = pad(R[r, "ArrayJobID"], wid)
		else if (c == "j" || c == "J") v = pad(R[r, "JobID"], wid)
		else if (c == "n" || c == "t") v = pad(0, wid)
		else if (c == "N") v = host
		else if (c == "s") v = "batch"
		else if (c == "u") v = R[r, "UserName"]
		else if (c == "x") v = R[r, "Name"]
		else continue
		out = out substr(f, q, p - 1 - q) v; p++; q = p
	}
	return out substr(f, q)
}
# fname_create(): a relative pattern is joined to the work dir, and one
# with a backslash is appended to it as it is, without a "/" (sic)
function fullpath(f, r,   dir) {
	if (substr(f, 1, 1) == "/") return index(f, "\\") ? unslash(f) : expand(f, r)
	dir = R[r, "WorkDir"]
	if (index(f, "\\")) return dir unslash(f)
	return dir (dir ~ /\/$/ ? "" : "/") expand(f, r)
}
# squeue prints a job without -o as WorkDir/slurm-JOBID.out, also for an
# array task, whose slurmstepd writes slurm-%A_%a.out; without -e it
# prints STDOUT for STDERR (src/squeue/print.c, 23.11.4), and slurmstepd
# then writes stderr where stdout goes
function outpat(r) {
	if (R[r, "STDOUT"] != R[r, "WorkDir"] "/slurm-" R[r, "JobID"] ".out") return R[r, "STDOUT"]
	return onetask(r) ? "slurm-%A_%a.out" : "slurm-%J.out"
}
function errpat(r) { return (R[r, "STDERR"] == R[r, "STDOUT"]) ? outpat(r) : R[r, "STDERR"] }
'
# What log_pick says, as KEY=VALUE, NUL-separated (no path holds a NUL):
#   verdict  ok, array or tasks (the array's task ids), leader (a het
#            component without its leader in the answer), none, notask,
#            nothet, bad
#   ok:      via: "", last (the array's last task) or het (a component, and
#            leader and offset name its het job and place); jobid, tid
#            (ArrayTaskID), state, restart, batch, host, reason, exit, and
#            out and err, the two paths
#   array, tasks: first (the smallest task id) and list (up to 10)
#   leader:  leader and offset
# log_keys are those keys, each kept in log_<key>; log_why, which log_ask
# sets for a failed or unreadable answer, is not one of them
log_keys="verdict via jobid tid state restart batch host reason exit out err first list leader offset"
# HOW is job (a plain id: the job itself, the leader of its het job, or the
# last task of an array, which carries the array's id), task (JOB_TASK),
# het (the leader of het job JOB) or tasks (array JOB's task ids).
log_pick() {   # log_pick HOW JOB [TASK]
	env LC_ALL=C gawk -v how="$1" -v job="$2" -v task="${3-}" -v fields="$log_fields" "$fname_awk"'
	BEGIN {
		RS = ENVIRON["SQ_NONCE"] "\n"; FS = ENVIRON["SQ_NONCE"]
		nf = split(fields, NAME, /[ \t\n]+/)        # R[record, field name], in this order
	}
	# every record whole, its job id a number, or nothing is read at all
	NF != nf || RT == "" || $1 !~ /^[0-9]+$/ { bad = 1; exit }
	{ nrec++; for (i = 1; i <= NF; i++) R[nrec, NAME[i]] = $i }
	function put(key, value) { printf "%s=%s%c", key, value, 0 }
	function ok(r, via) {
		put("verdict", "ok"); put("via", via)
		put("jobid", R[r, "JobID"]); put("tid", R[r, "ArrayTaskID"]); put("state", R[r, "StateCompact"])
		put("restart", R[r, "RestartCnt"]); put("batch", R[r, "BatchFlag"]); put("host", R[r, "BatchHost"])
		put("reason", R[r, "Reason"]); put("exit", R[r, "exit_code"])
		put("out", fullpath(outpat(r), r)); put("err", fullpath(errpat(r), r))
	}
	# the task ids of array job, smallest first, at most 10 of them; a
	# pending part is a bracket expression: a, a-b, a-b:step, %throttle
	function tasks(verdict,   r, x, t, nt, i, m, a, b, s, k, cnt, ids, sorted, nid, list) {
		for (r = 1; r <= nrec; r++) {
			if (R[r, "ArrayJobID"] != job || R[r, "ArrayTaskID"] == "N/A") continue
			x = R[r, "ArrayTaskID"]; sub(/%[0-9]+$/, "", x)
			nt = split(x, t, ",")
			for (i = 1; i <= nt; i++) {
				if (!match(t[i], /^([0-9]+)(-([0-9]+)(:([0-9]+))?)?$/, m)) continue
				a = m[1] + 0; b = (m[3] != "") ? m[3] + 0 : a; s = (m[5] != "") ? m[5] + 0 : 1
				if (s < 1 || b < a) continue
				cnt += int((b - a) / s) + 1
				for (k = a; k <= b && k < a + 10 * s; k += s) ids[k] = 1
			}
		}
		if (!cnt) { put("verdict", "none"); return }
		nid = asorti(ids, sorted, "@ind_num_asc")
		for (i = 1; i <= nid && i <= 10; i++) list = list (i > 1 ? "," : "") sorted[i]
		put("verdict", verdict); put("first", sorted[1]); put("list", list (cnt > 10 ? ",…" : ""))
	}
	END {
		if (bad) { put("verdict", "bad"); exit }
		if (how == "tasks") { tasks("tasks"); exit }
		if (how == "task") {
			for (r = 1; r <= nrec; r++)
				if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] == task) { ok(r, ""); exit }
			put("verdict", "notask"); exit
		}
		if (how == "het") {
			for (r = 1; r <= nrec; r++)
				if (R[r, "HetJobID"] == job && R[r, "HetJobOffset"] == "0") { ok(r, ""); exit }
			for (r = 1; r <= nrec; r++) if (R[r, "JobID"] == job) { put("verdict", "nothet"); exit }
			put("verdict", "none"); exit
		}
		for (me = 1; me <= nrec; me++) if (R[me, "JobID"] == job) break
		if (me <= nrec && R[me, "HetJobID"] != "N/A") {        # a het job: its leader writes
			if (R[me, "HetJobOffset"] == "0") { ok(me, ""); exit }
			for (r = 1; r <= nrec; r++)
				if (R[r, "HetJobID"] == R[me, "HetJobID"] && R[r, "HetJobOffset"] == "0") {
					ok(r, "het"); put("leader", R[me, "HetJobID"]); put("offset", R[me, "HetJobOffset"]); exit
				}
			put("verdict", "leader"); put("leader", R[me, "HetJobID"]); put("offset", R[me, "HetJobOffset"]); exit
		}
		for (r = 1; r <= nrec; r++) if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] != "N/A") { na++; last = r }
		if (na == 1 && R[last, "JobID"] == job && onetask(last)) { ok(last, "last"); exit }
		if (na) { tasks("array"); exit }
		if (me <= nrec) { ok(me, ""); exit }
		put("verdict", "none")
	}' "$tmp/facts"
}
# the file to read, from the record just taken: refused where it is /dev/null,
# noted where --err names the stdout file
log_resolve() {
	[ "$log_batch" != 0 ] || log_fail "job $log_label is an interactive job; its output went to its terminal"
	if [ $log_want = err ]; then
		[ "$log_err" != /dev/null ] || log_fail "job $log_label's stderr is discarded (it goes to /dev/null); drop --err"
		[ "$log_err" != "$log_out" ] ||
			log_note same "job $log_label writes its stderr into its stdout file; $doing that"
		log_path=$log_err
	else
		if [ "$log_out" = /dev/null ]; then
			[ "$log_err" = /dev/null ] && log_fail "job $log_label's output is discarded (it goes to /dev/null)"
			log_fail "job $log_label's output is discarded (it goes to /dev/null); its stderr has a file of its own: sq log --err $log_label"
		fi
		log_path=$log_out
	fi
}
# what a state means here: the job has not started (wait), runs or may still
# write (run: R, CG, a suspended job, any state sq does not know), ended
# (final), or was requeued (requeue: RQ RF; held: RH SE)
log_classify() {
	case $1 in
		PD|CF|RD) log_kind=wait ;;
		CD|F|CA|TO|OOM|NF|PR|BF|DL) log_kind=final ;;
		RQ|RF) log_kind=requeue ;;
		RH|SE) log_kind=held ;;
		*) log_kind=run ;;
	esac
}
log_readable() {   # is the file there to be read?  Not yet: 1.  Unreadable: rc 1 for sq
	{ : < "$log_path"; } 2>/dev/null && return 0
	[ -e "$log_path" ] || return 1
	local why; why=$({ : < "$log_path"; } 2>&1)
	log_fail "cannot read $log_path: ${why##*: }"
}
# tail's verdict once it ended: 0, its stderr ignored; its reader gone (141,
# or 1 with nothing said, where SIGPIPE was ignored) ends sq quietly with 0;
# a failure is its first line, rc 1, but for the "file truncated" and "has
# appeared" that -F reports and survives
log_tail_verdict() {   # log_tail_verdict RC
	[ "$1" != 0 ] || return 0
	[ "$1" != 141 ] || exit 0
	[ -s "$tmp/tail.err" ] || [ "$1" != 1 ] || exit 0
	local line
	line=$(env LC_ALL=C gawk '!/file truncated|has appeared/ { print; exit }' "$tmp/tail.err" 2>/dev/null)
	[ -n "$line" ] || [ ! -s "$tmp/tail.err" ] || return 0
	line=${line#tail: }
	log_fail "tail: ${line:-exit $1}"
}
log_dump() {   # what the file holds now, whole or its last N lines
	tail "${log_lines[@]}" -- "$log_path" 2> "$tmp/tail.err"
	log_tail_verdict $?
}
log_state_name() {   # the final state, as sacct and squeue -l spell it
	case $1 in
		CD) log_sname=COMPLETED ;; F) log_sname=FAILED ;; CA) log_sname=CANCELLED ;;
		TO) log_sname=TIMEOUT ;; OOM) log_sname=OUT_OF_MEMORY ;; NF) log_sname=NODE_FAIL ;;
		PR) log_sname=PREEMPTED ;; BF) log_sname=BOOT_FAIL ;; DL) log_sname=DEADLINE ;;
		*) log_sname=$1 ;;
	esac
}
# The end: the stream stopped (its sentinel killed, so tail reads once more
# and exits), else the file shown as it is now, then why it ended.  ENDING:
# final (the job ended), gone (Slurm forgot it), requeue or held
log_finish() {   # log_finish ENDING
	if [ -n "$log_tail_pid" ]; then
		kill "$log_sentinel_pid" 2>/dev/null
		{ wait "$log_tail_pid"; } 2>/dev/null; local rc=$?
		log_pids=$log_sentinel_pid log_tail_pid=
		log_tail_verdict $rc
	else
		case $1 in
			final|gone)
				log_readable || log_fail "job $log_label ended; $log_path was never written"
				log_dump ;;
		esac
	fi
	case $1 in
		final) log_state_name "$log_state"
		       log_say "job $log_label ended: $log_sname${log_exit:+ (exit code $log_exit)}" ;;
		gone)  log_say "job $log_label is gone from Slurm; stopping" ;;
		requeue) log_say "job $log_label was requeued (restart $log_restart); run sq log $log_label again for its new run" ;;
		held)  local now="is held"; [ "$log_state" != SE ] || now="is in special exit"
		       log_say "job $log_label was requeued (restart $log_restart) and $now; run sq log $log_label again for its new run" ;;
	esac
	exit 0
}

sub_log() {
	local a v positional=0 idraw= idset=0 job task= off=
	log_want=out log_follow=1 log_lines=(-n +1)
	while [ $# -gt 0 ]; do
		a=$1; shift
		if [ $positional = 0 ]; then
			case $a in
				-e|--err)    log_want=err; continue ;;
				--no-follow) log_follow=0; continue ;;
				-h|--help)   log_help; exit 0 ;;
				--)          positional=1; continue ;;
				-n|-n*)
					if [ "$a" = -n ]; then
						[ $# -gt 0 ] || log_usage "-n needs a number of lines, e.g. sq log -n 20 12345"
						a=$1; shift
					else a=${a#-n}; fi
					case $a in
						''|*[!0-9]*|??????????*)
							log_usage "-n needs a number of lines, not '$(printf '%s' "$a" | scrub 40)'; e.g. sq log -n 20 12345" ;;
					esac
					log_lines=(-n $((10#$a))); continue ;;
				--err=*|--no-follow=*|--help=*)
					log_usage "${a%%=*} takes no value; write it on its own, e.g. sq log ${a%%=*} 12345" ;;
				-?*) log_usage "'$(printf '%s' "$a" | scrub 40)' is not an option of sq log (sq log -h lists them); e.g. sq log -n 20 --err 12345" ;;
			esac
		fi
		[ $idset = 0 ] || log_usage "one job at a time, not '$(printf '%s' "$idraw" | scrub 40)' and '$(printf '%s' "$a" | scrub 40)'; e.g. sq log 12345"
		idraw=$a idset=1
	done
	[ $idset = 1 ] || log_usage "which job? e.g. sq log 12345"
	# 12345, an array task 12345_4 or a het component 12345+1, base 10; 0 and
	# the empty id are refused, as squeue would answer them with every job
	if [[ $idraw =~ ^([0-9]{1,10})(_([0-9]{1,7}))?$ ]]; then
		job=$((10#${BASH_REMATCH[1]})); [ -z "${BASH_REMATCH[3]}" ] || task=$((10#${BASH_REMATCH[3]}))
	elif [[ $idraw =~ ^([0-9]{1,10})[+]([0-9]{1,4})$ ]]; then
		job=$((10#${BASH_REMATCH[1]})) off=$((10#${BASH_REMATCH[2]}))
	else job=0
	fi
	if [ "$job" -lt 1 ] || [ "$job" -gt 4294967293 ] || { [ -n "$task" ] && [ "$task" -gt 4000000 ]; }; then
		log_usage "'$(printf '%s' "$idraw" | scrub 40)' is not a job id; e.g. sq log 12345, an array task 12345_4 or a het job's component 12345+1"
	fi
	log_label=$job${task:+_$task}${off:++$off}
	[ -z "${SLURM_CLUSTERS+set}" ] || log_refuse_cluster SLURM_CLUSTERS
	# following needs GNU tail: -F to wait out a file that is replaced,
	# --pid and --max-unchanged-stats (8.28 or newer)
	if [ $log_follow = 1 ]; then
		v=$(env LC_ALL=C tail --version 2>/dev/null); v=${v%%$'\n'*}
		[[ $v =~ ^tail\ \(GNU\ coreutils\)\ ([0-9]+)\.([0-9]+) ]] &&
			{ [ "${BASH_REMATCH[1]}" -gt 8 ] || { [ "${BASH_REMATCH[1]}" = 8 ] && [ "${BASH_REMATCH[2]}" -ge 28 ]; }; } ||
			log_fail "following needs GNU tail; use --no-follow"
	fi
	trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
	for v in $(compgen -e); do case $v in SQUEUE_*) unset "$v" ;; esac; done
	nonce=$(mint_nonce) || die "no usable random field separator"
	export SQ_NONCE=$nonce
	log_fmt=
	for v in $log_fields; do log_fmt="$log_fmt${log_fmt:+,}$v:$nonce"; done
	# The clock: a tick a second is a read on a FIFO of its own, which nothing
	# writes, so no process sleeps.  The sentinel is what tail's --pid
	# watches: killing it ends the stream, and it ends itself, removing $tmp,
	# within a second of sq being killed outright, so it starts before the
	# first Slurm call
	make_tmp
	mkfifo "$tmp/nap" && exec {log_nap}<> "$tmp/nap" || log_fail "cannot make a timer FIFO in $tmp"
	{ while kill -0 $$ 2>/dev/null; do read -t 1 -u "$log_nap"; done; rm -rf "$tmp"; } &
	log_sentinel_pid=$! log_tail_pid=; log_pids=$log_sentinel_pid
	local doing=following; [ $log_follow = 1 ] || doing=showing

	# the first answer: the record to follow, or why there is none.  A het
	# job's output is its leader's (offset 0), the only component that runs
	# the script; a component named by its own id is asked about again by
	# its het job's id, as only that brings the leader along
	local asked=$job qid=$log_label how=job het=
	[ -z "$task" ] || how=task
	[ -z "$off" ] || { how=het; [ "$off" = 0 ] || het=$job; }
	log_ask "$qid" $how "$job" "$task"
	if [ "$log_verdict" = leader ]; then
		het=$log_leader qid=$log_leader how=het job=$log_leader
		log_ask "$qid" het "$job"
	fi
	case $log_verdict in
		notask)   # its array may be known: then which tasks it has
			log_ask "$asked" tasks "$asked"
			[ "$log_verdict" != tasks ] ||
				log_fail "Slurm does not know task $log_label; array $asked has tasks $log_list"
			[ "$log_verdict" = fail ] || log_verdict=none ;;
		array)  log_usage "$asked is an array; name a task, e.g. sq log ${asked}_$log_first (its tasks: $log_list)" ;;
		nothet) log_usage "$asked is not a het job, so $log_label names no component of one; e.g. sq log $asked" ;;
	esac
	[ "$log_verdict" != fail ] || log_fail "slurm unreachable · $log_why"
	[ "$log_verdict" = ok ] ||
		log_fail "Slurm does not know job $log_label (it ended more than about 5 minutes ago, or never existed), so its output path is unknown"
	case $log_via in
		last) log_note last "job $log_label is task ${asked}_$log_tid of an array; $doing it" ;;
		het)  het=$log_leader qid=$log_leader how=het job=$log_leader ;;
	esac
	[ -z "$het" ] ||
		log_note het "job $log_label belongs to het job $het, whose leader $het+0 writes its output; $doing that"
	log_resolve
	log_classify "$log_state"
	local baseline=$log_restart

	if [ $log_follow = 0 ]; then
		case $log_kind in
			wait|requeue|held) log_fail "job $log_label has not started yet" ;;
		esac
		if ! log_readable; then
			[ $log_kind = final ] && log_fail "job $log_label ended; $log_path was never written"
			log_fail "$log_path was not written yet (job $log_label runs on $log_host)"
		fi
		log_dump
		[ $log_kind != final ] || { log_state_name "$log_state"
			log_say "job $log_label ended: $log_sname${log_exit:+ (exit code $log_exit)}"; }
		exit 0
	fi
	[ $log_kind != final ] || log_finish final    # already over: shown as it is

	# The loop, Slurm asked every 5th tick
	local tick=0 started=0 waited=0 grace=-1 ending= reason
	while :; do
		if [ -z "$ending" ] && [ $tick -gt 0 ] && [ $((tick % 5)) = 0 ]; then
			log_ask "$qid" $how "$job" "$task"
			case $log_verdict in
				ok)   log_classify "$log_state"
				      # a requeue counts once the job has run in this follow, or
				      # when RestartCnt rose; seen pending, it is still waiting
				      if [ $log_kind = held ] && [ $started = 1 ]; then ending=held
				      elif [ "$log_restart" -gt "$baseline" ] 2>/dev/null; then ending=requeue
				      elif [ $log_kind = requeue ] && [ $started = 1 ]; then ending=requeue
				      elif [ $log_kind = final ]; then ending=final
				      fi ;;
				fail) log_note unreachable "slurm unreachable ($log_why); still following" ;;
				*)    ending=gone ;;
			esac
			[ -z "$ending" ] || grace=3
		fi
		if [ -z "$ending" ]; then
			case $log_kind in
				wait|requeue|held)   # a reason of None says nothing
				      case $log_reason in ''|None) reason= ;; *) reason=" ($log_reason)" ;; esac
				      log_note pending "job $log_label is pending$reason; waiting for it to start" ;;
				run)  if [ $started = 0 ]; then         # the path as the job computed it
				          started=1; log_resolve
				      fi
				      if [ -z "$log_tail_pid" ]; then
				          if log_readable; then
				              { tail "${log_lines[@]}" -F -s 1 --max-unchanged-stats=1 --pid="$log_sentinel_pid" \
				                  -- "$log_path" 2> "$tmp/tail.err" & } 2>/dev/null
				              log_tail_pid=$!; log_pids="$log_tail_pid $log_sentinel_pid"
				          elif [ $((waited += 1)) -ge 10 ]; then
				              log_note appear "waiting for $log_path to appear (job $log_label runs on $log_host)"
				          fi
				      fi ;;
			esac
		fi
		# tail gone on its own: a reader gone, a write error, a failure
		if [ -n "$log_tail_pid" ] && ! kill -0 "$log_tail_pid" 2>/dev/null; then
			{ wait "$log_tail_pid"; } 2>/dev/null; local rc=$?
			log_pids=$log_sentinel_pid log_tail_pid=   # reaped: its pid is no longer ours
			log_tail_verdict $rc; exit 0
		fi
		[ $grace != 0 ] || log_finish "$ending"
		[ $grace -lt 0 ] || grace=$((grace - 1))
		read -t 1 -u "$log_nap"
		tick=$((tick + 1))
	done
}

# ============================================================================
# sq job JOBID: one job, its efficiency once it ended; an array's summary
# ============================================================================
# Franz's decisions (2026-10-20): grouped sections (state and times,
# resources, files, efficiency), the efficiency as compact CPU and MEM bar
# lines; peak memory is the largest step's total; a bare array id is one
# summary over its COMPLETED tasks (median, min with its task, max); a running
# job shows memory only, and only the caller's own, as the dashboard's MEM
# reads it; CPU per step the larger of TotalCPU and Slurm's polled figure;
# SQ_PSS_SINCE a setting, off by default; het jobs refused for now.
# The facts: one squeue --jobs=ID -t all (the live state, reason, dependency,
# start estimate, time left and output paths, while Slurm knows the job), one
# sacct -j ID without -X (request, allocation, the steps' CPU time and memory,
# the exit, and the job itself once squeue forgot it), and for the caller's
# own running job JOBMEM's reading.  One source down: the other's view, with a
# dim line saying which; both: rc 1.
job_help() {
	cat <<'EOF'
usage: sq job [--color|--no-color] JOBID

One job in one report: its state and times, the CPUs and memory it asked for
and was given, its work directory and output files, and once it ended how
well it used them: its CPU time against CPUs x elapsed, and its peak memory
against its allocation.  While your own job runs, the memory it uses now, as
the dashboard's MEM reads it (? no reading yet, ! the reading failed).  JOBID
is 12345, an array task 12345_4, or an array 12345, which gets one summary
over its completed tasks: the median, the weakest task and the best.

Exit 0 when shown, 1 when Slurm does not know the job or cannot be asked,
2 for a usage error, 128+N when stopped by signal N.

env: SQ_PSS_SINCE  when this cluster's accounting moved from RSS to PSS
                   (JobAcctGatherParams=UsePss), as YYYY-MM-DD[ HH:MM[:SS]]
                   [ ZONE], YYYY-MM-DDTHH:MM[:SS]Z or @EPOCH, e.g.
                   SQ_PSS_SINCE="2026-10-19 15:59 CEST": a peak measured in a
                   step that started before it gets a note, as RSS counts
                   memory shared between processes once per process.  Unset,
                   or empty: no such note.

Good to know:
- CPU time per step is the larger of what its processes reported and what
  Slurm's sampling saw, so processes Slurm killed or never waited for count;
  sampled, it is still a lower bound.
- Peak memory is the largest step's: with several tasks, the sum of each
  task's own peak, an upper bound.  Sampling misses a short spike, so a job
  killed for its memory can read well below its limit.
- Efficiency comes from accounting, so it shows once accounting has recorded
  the job's end, a moment after squeue says it ended.
- Slurm forgets a job's output paths about 5 minutes after it ends.
EOF
}
# every message names sq job and is scrubbed whole: it carries ids, names and
# reasons, all of them outside text
job_say()   { printf 'sq job: %s\n' "$(printf '%s' "$1" | scrub)" >&2; }
job_usage() { job_say "$*"; exit 2; }          # the command line is wrong
job_fail()  { job_say "$*"; exit 1; }          # nothing to show
# SLURM_CLUSTERS, -M/--cluster(s), --federation and --sibling would ask another
# cluster, which neither sstat nor the snapshot JOBMEM shares can: one text
# per cause
job_refuse_cluster() {
	case $1 in
		SLURM_CLUSTERS) job_usage "sq job reads this cluster only; unset SLURM_CLUSTERS" ;;
		*) job_usage "sq job reads this cluster only; drop $1" ;;
	esac
}
# squeue -O fields: sq log's record (the path functions read theirs by these
# names) and what the report shows; sacct -o fields, the job name last
job_qfields="$log_fields Partition SubmitTime EndTime TimeLimit TimeLeft TimeUsed Dependency NumCPUs
	NumNodes tres-alloc NodeList UserID"
job_afields="JobID JobIDRaw UID User State ExitCode ElapsedRaw AllocCPUS ReqCPUS ReqTRES AllocTRES
	TotalCPU TRESUsageInTot TRESUsageInMax NTasks Submit Start End NodeList Partition WorkDir JobName"
# SQ_PSS_SINCE, its epoch into job_pss (0: unset).  Only these forms, so a
# typo is an error, never a date GNU date makes of it ("1" is 01:00 today):
# YYYY-MM-DD[ HH:MM[:SS]][ ZONE], ZONE UTC, +HHMM or an abbreviation date
# knows; YYYY-MM-DDTHH:MM[:SS]Z; @EPOCH
job_pss_since() {
	local v=${SQ_PSS_SINCE:-} d='[0-9]{4}-[0-9]{2}-[0-9]{2}' t='[0-9]{2}:[0-9]{2}(:[0-9]{2})?'
	job_pss=0
	[ -n "$v" ] || return 0
	if [[ $v =~ ^$d(\ $t)?(\ (UTC|[+-][0-9]{4}|[A-Z]{2,5}))?$ || $v =~ ^${d}T${t}Z$ || $v =~ ^@[0-9]{1,12}$ ]] &&
		job_pss=$(env LC_ALL=C date -d "$v" +%s 2>/dev/null) && [[ $job_pss =~ ^[0-9]+$ ]]; then
		return 0
	fi
	job_pss=0
	job_usage "SQ_PSS_SINCE is no date sq job reads: '$(printf '%s' "$v" | scrub 40)'; e.g. SQ_PSS_SINCE=\"2026-10-19 15:59 CEST\", 2026-10-19T13:59Z or @1792418340"
}
# The report, a gawk program over the two answers (shared_awk and fname_awk
# before it)
read -r -d '' job_awk <<'JOBAWK'
function paint(c, s) { return (c == "") ? s : e(c) s e("0") }
function plural(n, w) { return n " " w (n == 1 ? "" : "s") }
function trim(s) { gsub(/^ +| +$/, "", s); return s }
function pct1(x) { return sprintf("%.1f%%", x) }
function stcode(st) { sub(/ .*/, "", st); return (st in SC) ? SC[st] : st }   # CANCELLED by 1025: CA
function stname(c) { return (c in LN) ? LN[c] : c }
function stcolour(c) { return (c == "R" || c == "CD") ? "32" : (c == "PD") ? "33" : (c in BAD) ? "31" : (c in DONE) ? "33" : "36" }
function isepoch(x) { return x ~ /^[0-9]+$/ && x + 0 > 0 }
function stamp(ep) { return strftime("%Y-%m-%d %H:%M", ep) }
function when(ep) { return stamp(ep) " (" (ep <= NOW ? ago(NOW - ep) " ago" : "in " ago(ep - NOW)) ")" }
# a number of a TRES text (cpu=2,mem=15600M,node=1, or a usage text in bytes):
# KEY= as a plain number, else -1
function tresnum(t, key,   m) { return match(t, "(^|,)" key "=([0-9]+)(,|$)", m) ? m[2] + 0 : -1 }
# the cpu= of a TRESUsageIn* text, D-HH:MM:SS, in seconds, else -1
function trescpu(t,   m) { return match(t, /(^|,)cpu=([^,]*)/, m) ? dur(m[2]) : -1 }
function stepname(id,   s) {
  s = substr(id, index(id, ".") + 1)
  return (s == "batch") ? "the batch script" : (s ~ /^[0-9]+$/) ? "step " s : s
}
# a bar of BARW cells, the dashboard's node bar over 0-100: █ to P (a share
# beyond 100 fills it), dim ▒ for the rest
function bar(p, hue) { return cells(100, p > 100 ? 100 : p, 100, BARW, hue) }
# CPU by waste, against what the CPUs allow (CAP, else 100): green from 70 % of
# it, yellow from 30 %, red below
function cpucolour(p, cap,   r) { r = p / (cap ? cap : 100); return (r >= 0.7) ? "32" : (r >= 0.3) ? "33" : "31" }
# one framed stream: records ending in NONCE "\n", the fields NAMES lists
# separated by NONCE, the first matching ANCHOR, into ARR[record, name] with
# every control character a "?" (they reach the terminal); the count, or -1
# when a record is not whole (a field missing or too many, the end cut off)
function read_stream(file, nonce, names, ARR, anchor,   saved, n, nn, N, ln, f, i, bad) {
  nn = split(names, N, /[ \t\n]+/)
  saved = RS; RS = nonce "\n"
  while ((getline ln < file) > 0) {
    if (split(ln, f, nonce) != nn || RT == "" || f[1] !~ anchor) { bad = 1; break }
    n++; for (i = 1; i <= nn; i++) { gsub(/[[:cntrl:]]/, "?", f[i]); ARR[n, N[i]] = f[i] }
  }
  close(file); RS = saved
  return bad ? -1 : n + 0
}
# does a pending array's task expression (squeue's ArrayTaskID: a, a-b,
# a-b:step, comma-separated, maybe %throttle) hold task T?
function task_in(x, t,   p, np, i, m, a, b, s) {
  sub(/%[0-9]+$/, "", x); np = split(x, p, ",")
  for (i = 1; i <= np; i++) {
    if (!match(p[i], /^([0-9]+)(-([0-9]+)(:([0-9]+))?)?$/, m)) continue
    a = m[1] + 0; b = (m[3] != "") ? m[3] + 0 : a; s = (m[5] != "") ? m[5] + 0 : 1
    if (t >= a && t <= b && s >= 1 && (t - a) % s == 0) return 1
  }
  return 0
}

# ---- which records: the job's, a task's, or an array's -----------------------
# sacct: job_row[id] its job rows, row_by_unique_id[unique id] the same, step_row[id, k] / nsteps[id] the
# steps of each, task_row[k] / ntask_rows the rows of array JOB's tasks; squeue: array_record[k] / narray_records
# the records of array JOB.  The answer: het, array, none, or one (with qrow
# and arow, the job's squeue record and sacct row, either may be 0; inmeta
# when its record is a pending array's, which still holds the task)
function pick(   r, id, p, k) {
  for (r = 1; r <= na; r++) {
    id = A[r, "JobID"]
    if (index(id, "+")) het = 1
    if ((p = index(id, ".")) > 0) { k = substr(id, 1, p - 1); step_row[k, ++nsteps[k]] = r; continue }
    if (!(id in job_row)) job_row[id] = r
    if (!(A[r, "JobIDRaw"] in row_by_unique_id)) row_by_unique_id[A[r, "JobIDRaw"]] = r
    if (task == "" && index(id, job "_") == 1) task_row[++ntask_rows] = r
  }
  for (r = 1; r <= nq; r++) {
    if (R[r, "HetJobID"] != "N/A") het = 1
    if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] != "N/A") array_record[++narray_records] = r
  }
  if (het) return "het"
  if (task == "") {
    if (ntask_rows || narray_records) return "array"
    for (r = 1; r <= nq && !qrow; r++) if (R[r, "JobID"] == job) qrow = r
    arow = (job in job_row) ? job_row[job] : (job in row_by_unique_id) ? row_by_unique_id[job] : 0
  } else {
    for (r = 1; r <= nq && !qrow; r++)
      if (R[r, "ArrayJobID"] == job && R[r, "ArrayTaskID"] == task) qrow = r
    for (r = 1; r <= nq && !qrow; r++)
      if (R[r, "ArrayJobID"] == job && task_in(R[r, "ArrayTaskID"], task)) { qrow = r; inmeta = 1 }
    arow = ((job "_" task) in job_row) ? job_row[job "_" task] : 0
  }
  if (!qrow && !arow) return "none"
  # the job as the title names it, its unique id (none for a task still in a
  # pending array's record), its state: squeue's while it knows the job
  if (arow) { jid = A[arow, "JobID"]; raw = A[arow, "JobIDRaw"] }
  else if (inmeta) { jid = job "_" task; raw = "" }
  else { jid = onetask(qrow) ? R[qrow, "ArrayJobID"] "_" R[qrow, "ArrayTaskID"] : R[qrow, "JobID"]; raw = R[qrow, "JobID"] }
  if (inmeta) R[qrow, "ArrayTaskID"] = task         # its paths are the task's
  STATE = qrow ? R[qrow, "StateCompact"] : stcode(A[arow, "State"])
  OWN = (myuid != "") && (qrow ? R[qrow, "UserID"] : A[arow, "UID"]) == myuid
  ALLOC = (qrow && !(STATE in DONE)) ? tres_mem(R[qrow, "tres-alloc"]) : arow ? tres_mem(A[arow, "AllocTRES"]) : qrow ? tres_mem(R[qrow, "tres-alloc"]) : -1
  NODES = qrow ? R[qrow, "NumNodes"] : tresnum(A[arow, "AllocTRES"], "node")
  return "one"
}

# ---- one job's efficiency, from its sacct row r and its steps, into eff_* -------
# CPU seconds of a step: the larger of TotalCPU (what the tasks' wait() and
# the last poll gave) and the polled TRESUsageInTot / TRESUsageInMax cpu=
# (Franz: "The larger of both"): TotalCPU misses processes Slurm killed or
# never waited for (11191: 0.008 s of a 12 h TIMEOUT, polled 2-19:40:01).
# eff_polled: a polled figure won somewhere
function stepcpu(s,   t, p) {
  t = dur(A[s, "TotalCPU"]); if (t < 0) t = 0
  p = trescpu(A[s, "TRESUsageInTot"]); if (trescpu(A[s, "TRESUsageInMax"]) > p) p = trescpu(A[s, "TRESUsageInMax"])
  if (p > t) { eff_polled = 1; return p }
  return t
}
# CPU efficiency = the steps' CPU seconds, summed and rounded to whole seconds
# as seff does, / (ElapsedRaw x AllocCPUS); no step rows: the job row's
# TotalCPU.  Memory efficiency = the largest step's TRESUsageInTot mem= (its
# tasks' peaks, summed: Franz's "Largest step total") / AllocTRES mem=.
# eff_cap: the share of the CPUs a program running one thread per requested CPU
# reaches, when more were allocated than requested; eff_rss: the peak step
# started before SQ_PSS_SINCE
function effcalc(id, r,   k, s, b) {
  eff_elapsed = A[r, "ElapsedRaw"] + 0; eff_cpus = A[r, "AllocCPUS"] + 0; eff_req_cpus = A[r, "ReqCPUS"] + 0
  eff_polled = 0
  if (nsteps[id]) { eff_cpu_sec = 0; for (k = 1; k <= nsteps[id]; k++) eff_cpu_sec += stepcpu(step_row[id, k]); eff_cpu_sec = int(eff_cpu_sec + 0.5) }
  else eff_cpu_sec = (dur(A[r, "TotalCPU"]) < 0) ? -1 : int(dur(A[r, "TotalCPU"]) + 0.5)
  eff_core_sec = eff_elapsed * eff_cpus
  eff_cpu_pct = (eff_core_sec > 0 && eff_cpu_sec >= 0) ? eff_cpu_sec / eff_core_sec * 100 : -1
  eff_alloc_mb = tres_mem(A[r, "AllocTRES"])
  eff_peak_bytes = -1; eff_peak_step = ""; eff_peak_tasks = 0; eff_peak_start = ""
  for (k = 1; k <= nsteps[id]; k++) {
    s = step_row[id, k]; b = tresnum(A[s, "TRESUsageInTot"], "mem")
    if (b > eff_peak_bytes) { eff_peak_bytes = b; eff_peak_step = A[s, "JobID"]; eff_peak_tasks = A[s, "NTasks"] + 0; eff_peak_start = A[s, "Start"] }
  }
  eff_rss = (pss > 0 && eff_peak_bytes >= 0 && isepoch(eff_peak_start) && eff_peak_start + 0 < pss)
  eff_mem_pct = (eff_alloc_mb > 0 && eff_peak_bytes >= 0) ? eff_peak_bytes / (eff_alloc_mb * 1048576) * 100 : -1
  eff_cap = (eff_req_cpus > 0 && eff_cpus > eff_req_cpus) ? eff_req_cpus / eff_cpus * 100 : 0
}
function captext(req, ncpu, cap) {
  return plural(req, "requested CPU") " became " ncpu ": a program running " plural(req, "thread") \
         " reaches at most " sprintf(cap >= 10 ? "%.0f" : "%.1f", cap) "%"
}
function pss_text() { return stamp(pss) " " strftime("%Z", pss) }
# the CPU and MEM lines: P as a bar and a share, then TAIL
function cpuline(p, cap, tail) { return "  CPU " bar(p, cpucolour(p, cap)) " " sprintf("%6s", pct1(p)) "  " tail }
function memline(p, hue, tail) { return "  MEM " bar(p, hue) " " sprintf("%6s", pct1(p)) "  " tail }
# accounting's failure, in place of what it would have shown
function acct_down() {
  if (astat == "timeout") return "accounting did not answer within " tmo "s"
  if (astat == "bad") return "accounting answered what cannot be read"
  return "accounting did not answer (" ENVIRON["SQJ_AWHY"] ")"
}

# ---- the model: key/value lines, raw lines and notes, by section -------------
function kv(sec, key, val) { M++; MT[M] = "kv"; MS[M] = sec; MK[M] = key; MV[M] = val }
function note(sec, text)   { M++; MT[M] = "note"; MS[M] = sec; MV[M] = text }
function line(sec, text)   { M++; MT[M] = "line"; MS[M] = sec; MV[M] = text }
# Franz's pick (2026-10-20): grouped sections, each under its dim caption, the
# keys aligned; the efficiency lines as they are, their notes at "  ↳", and a
# note elsewhere under the values
function print_sections(   i, w, cur) {
  printf "%s\n", TITLE
  for (i = 1; i <= M; i++) if (MT[i] == "kv" && length(MK[i]) > w) w = length(MK[i])
  for (i = 1; i <= M; i++) {
    if (MS[i] != cur) { cur = MS[i]; if (cur in SECNAME) printf "%s\n", paint("2", SECNAME[cur]) }
    if      (MT[i] == "kv")   printf "  %-*s  %s\n", w, MK[i], MV[i]
    else if (MT[i] == "line") printf "%s\n", MV[i]
    else if (MS[i] == "eff" || MS[i] == "arr" || MS[i] == "top") printf "  %s\n", paint("2", "↳ " MV[i])
    else                      printf "  %*s  %s\n", w, "", paint("2", "↳ " MV[i])
  }
}
# what one source being down means, under the title: the view is what the
# other one knows
function source_notes(final) {
  if (qstat == "fail") note("top", "squeue did not answer; shown from accounting")
  if (qstat == "bad")  note("top", "squeue answered what cannot be read; shown from accounting")
  if (astat != "ok" && !final) note("top", acct_down())
}

# ---- the efficiency section of one job -----------------------------------------
# None for a pending job; for a running one memory only, and only the caller's
# own (JOBMEM's reading: sstat answers only a job's owner); once it ended, CPU
# and memory from accounting, when accounting has recorded the end
function eff_job(c, q, r,   reading, use_pct, mark, cell, at) {
  if (c == "PD") return
  if (!(c in DONE)) {
    if (!OWN || c != "R") return
    reading = mem_outcome(raw, ALLOC, NODES)
    if (reading == "ok") {
      use_pct = job_bytes[raw] / (ALLOC * 1048576) * 100
      line("eff", memline(use_pct, memcolour(use_pct), trim(memcell(job_bytes[raw], ALLOC, "", 0)) " now"))
    } else {                                   # the mark, dim (no reading) or red (failed)
      mark = (reading == "failed") ? "!" : "?"
      cell = (ALLOC > 0) ? trim(memcell(0, ALLOC, mark, 0)) : mark; at = index(cell, mark)
      cell = substr(cell, 1, at - 1) paint(mark == "!" ? "31" : "2", mark) substr(cell, at + 1)
      line("eff", "  MEM " cells(0, -1, 100, BARW, "") " " sprintf("%6s", "") "  " cell " now")
    }
    note("eff", "CPU efficiency comes when the job ends")
    return
  }
  if (astat != "ok") { note("eff", acct_down()); return }
  if (never_started(q, r)) { note("eff", "it never started"); return }
  if (!r || !(stcode(A[r, "State"]) in DONE)) { note("eff", "accounting has not recorded its end yet"); return }
  effcalc(jid, r)
  if (eff_cpu_pct >= 0) line("eff", cpuline(eff_cpu_pct, eff_cap, elap(eff_cpu_sec) " of " elap(eff_core_sec)))
  if (eff_mem_pct >= 0)
    line("eff", memline(eff_mem_pct, c == "OOM" ? "1;31" : memcolour(eff_mem_pct), trim(memcell(eff_peak_bytes, eff_alloc_mb, "", 0)) " peak (" stepname(eff_peak_step) ")"))
  if (eff_cap) note("eff", captext(eff_req_cpus, eff_cpus, eff_cap))
  if (eff_polled) note("eff", POLLED)
  if (c == "OOM") note("eff", "OUT_OF_MEMORY: it hit its " memsize(eff_alloc_mb, 0) " limit between two samples; the peak shown is too low")
  if (eff_rss) note("eff", stepname(eff_peak_step) " started before " pss_text() \
                  " (RSS accounting): memory shared between processes counted once per process; the peak may read high")
  if (eff_peak_tasks > 1) note("eff", stepname(eff_peak_step) " ran " eff_peak_tasks " tasks: its peak adds up each task's own peak, an upper bound")
}
# a job that ended without ever running: no CPUs, no start (cancelled or
# failed while pending); with squeue alone, no node
function never_started(q, r) {
  if (r) return A[r, "AllocCPUS"] + 0 == 0 || A[r, "Start"] == "None" || A[r, "Start"] == "Unknown"
  return R[q, "NodeList"] == ""
}

# ---- sq job ID: one job, or one task -------------------------------------------
function exit_text(c,   t, sg) {
  sg = JSG[jid] + 0; t = "exit " exlabel(JRC[jid] + 0, sg)
  if (sg == 0)   return t
  if (sg <= 31)  return t ": signal " sg ((sg in SIGNAME) ? " (" SIGNAME[sg] ")" : "")
  if (sg == 125) return t (c == "OOM" ? "" : ": out of memory")
  return t ": Slurm error" ((sg in SLERR) ? ", " SLERR[sg] : "")
}
function build_job(   q, r, c, final, never, name, user, unique, state, reason, dependency, start, submit,
                      left, ended, step, req_cpus, req_mb, req_text, alloc_cpus, limit, out, err) {
  q = qrow; r = arow; c = STATE
  final = (c in DONE); never = final && never_started(q, r)
  name = q ? R[q, "Name"] : A[r, "JobName"]; user = q ? R[q, "UserName"] : A[r, "User"]
  unique = (raw != "" && raw != jid) ? " " paint("2", "(unique id " raw ")") : ""
  TITLE = paint("1;36", "▌ ") paint("1", jid) unique "  " name " · " user
  source_notes(final)
  state = paint(stcolour(c), stname(c))
  if (c == "PD") {
    reason = q ? R[q, "Reason"] : ""
    kv("state", "state", state (reason != "" && reason != "None" ? " (" reason ")" : ""))
    dependency = q ? R[q, "Dependency"] : ""
    if (dependency != "" && dependency != "(null)") kv("state", "dependency", dependency)
    start = q ? R[q, "StartTime"] : ""             # a pending job's: Slurm's estimate
    kv("state", "start", (isepoch(start) && start + 0 > NOW) ? when(start) ", Slurm's estimate" : "no estimate yet")
    submit = q ? R[q, "SubmitTime"] : A[r, "Submit"]
    if (isepoch(submit)) kv("state", "submitted", when(submit))
  } else if (!final) {
    kv("state", "state", state " on " (q ? R[q, "NodeList"] : A[r, "NodeList"]) " (" (q ? R[q, "Partition"] : A[r, "Partition"]) ")")
    if (q) {
      left = R[q, "TimeLeft"]
      left = (left == "UNLIMITED") ? "no time limit" : (left == "INVALID") ? "past its time limit" \
           : elap(dur(left)) " left of " elap(dur(R[q, "TimeLimit"]))
      kv("state", "time", elap(dur(R[q, "TimeUsed"])) " elapsed · " left)
    } else kv("state", "time", elap(A[r, "ElapsedRaw"] + 0) " elapsed")
    start = q ? R[q, "StartTime"] : A[r, "Start"]
    if (isepoch(start)) kv("state", "started", when(start))
  } else {
    # the exit over the job row and its steps, as the finished block reads
    # it, while accounting has the end; else squeue's
    if (r && (stcode(A[r, "State"]) in DONE)) {
      xcm(jid, A[r, "ExitCode"]); for (step = 1; step <= nsteps[jid]; step++) xcm(jid, A[step_row[jid, step], "ExitCode"])
      kv("state", "state", state " · " exit_text(c))
      if (!never) kv("state", "ran", elap(A[r, "ElapsedRaw"] + 0) " on " A[r, "NodeList"] " (" A[r, "Partition"] ")")
      ended = A[r, "End"]
    } else {
      xcm(jid, R[q, "exit_code"], 1)
      kv("state", "state", state " · " exit_text(c))
      if (!never) kv("state", "ran", elap(dur(R[q, "TimeUsed"])) " on " R[q, "NodeList"] " (" R[q, "Partition"] ")")
      ended = R[q, "EndTime"]
    }
    if (isepoch(ended)) kv("state", "ended", when(ended))
  }

  # resources: a pending job's request (or one that never ran), else what it
  # was given and asked for.  The memory a running job uses is the
  # efficiency section's, not repeated here
  if (c == "PD" || never) {
    req_cpus = (r && (never || !q)) ? A[r, "ReqCPUS"] : R[q, "NumCPUs"]   # squeue's NumCPUs: the request, while pending
    kv("res", "CPUs", req_cpus " requested")
    req_mb = (r && (never || !q)) ? tres_mem(A[r, "ReqTRES"]) : tres_mem(R[q, "tres-alloc"])
    if (req_mb > 0) kv("res", "memory", memsize(req_mb, 0) " requested")
    limit = q ? R[q, "TimeLimit"] : ""
    if (c == "PD" && limit != "") kv("res", "time limit", (limit == "UNLIMITED") ? "none" : elap(dur(limit)))
  } else {
    alloc_cpus = r ? A[r, "AllocCPUS"] + 0 : R[q, "NumCPUs"] + 0; req_cpus = r ? A[r, "ReqCPUS"] + 0 : 0
    kv("res", "CPUs", alloc_cpus " allocated" ((req_cpus && req_cpus != alloc_cpus) ? " (" req_cpus " requested)" : ""))
    # the cap note: the efficiency section says it once the job ended
    if (req_cpus && alloc_cpus > req_cpus && !final) note("res", captext(req_cpus, alloc_cpus, req_cpus / alloc_cpus * 100))
    req_mb = r ? tres_mem(A[r, "ReqTRES"]) : -1
    req_text = (req_mb > 0 && req_mb != ALLOC) ? " (" memsize(req_mb, 0) " requested)" : ""
    if (!final && !OWN && ALLOC > 0) kv("res", "memory", memsize(ALLOC, 0) " allocated" req_text " · its use is shown to " user " only")
    else if (ALLOC > 0)              kv("res", "memory", memsize(ALLOC, 0) " allocated" req_text)
  }

  # files: from squeue's record while Slurm has it, else the work dir alone
  if (q) {
    kv("files", "work dir", R[q, "WorkDir"])
    if (R[q, "BatchFlag"] == "0") kv("files", "output", "its terminal (an interactive job)")
    else {
      out = fullpath(outpat(q), q); err = fullpath(errpat(q), q)
      kv("files", "stdout", out); kv("files", "stderr", (err == out) ? "into stdout" : err)
    }
  } else {
    kv("files", "work dir", A[r, "WorkDir"])
    kv("files", "output", (qstat == "none") ? "unknown: Slurm forgets a job's paths about 5 minutes after it ends" \
                                            : "unknown: squeue did not answer")
  }
  eff_job(c, q, r)
  print_sections()
}

# ---- sq job ARRAY: one summary over the tasks that completed -------------------
function median(V, n,   S, k) {
  k = asort(V, S, "@val_num_asc")
  return (k % 2) ? S[(k + 1) / 2] : (S[k / 2] + S[k / 2 + 1]) / 2
}
# a task, or K of them still in a pending array's record, counted by state C:
# done (COMPLETED), cancelled, failed (any other final state), pending, running
function count(c, k) {
  if (c == "CD") done += k; else if (c == "CA") canc += k; else if (c == "PD") pend += k
  else if (c in DONE) fail += k; else run += k
  total += k
}
function build_array(   i, r, id, c, k, ncv, nmv, CV, MV, cmin, cmax, mmin, mmax, cminid, mminid, rss, multi,
                        polled, name, user, cap, req, ncpu, mixed, st, cmed, mmed, why) {
  if (ntask_rows) {                                       # accounting: every task, and the figures
    for (i = 1; i <= ntask_rows; i++) {
      r = task_row[i]; id = A[r, "JobID"]
      if (name == "") { name = A[r, "JobName"]; user = A[r, "User"] }
      c = stcode(A[r, "State"])
      if (id ~ /\[/) {                             # tasks still in a pending array's record
        count((c == "CA") ? "CA" : (c in DONE) ? "F" : "PD", ntasks(id, ID)); continue
      }
      count(c, 1)
      if (c != "CD") continue                      # Franz: the statistics are the COMPLETED tasks'
      effcalc(id, r)
      if (eff_cpu_pct >= 0) {
        CV[++ncv] = eff_cpu_pct
        if (cmin == "" || eff_cpu_pct < cmin) { cmin = eff_cpu_pct; cminid = id }
        if (cmax == "" || eff_cpu_pct > cmax) cmax = eff_cpu_pct
      }
      if (eff_mem_pct >= 0) {
        MV[++nmv] = eff_mem_pct
        if (mmin == "" || eff_mem_pct < mmin) { mmin = eff_mem_pct; mminid = id }
        if (mmax == "" || eff_mem_pct > mmax) mmax = eff_mem_pct
      }
      rss += eff_rss; polled += eff_polled; multi += (eff_peak_tasks > 1)
      if (ncpu == "") { ncpu = eff_cpus; req = eff_req_cpus; cap = eff_cap }
      else if (ncpu != eff_cpus || req != eff_req_cpus) mixed = 1
    }
  } else                                           # the queue's records alone
    for (i = 1; i <= narray_records; i++) {
      r = array_record[i]
      if (name == "") { name = R[r, "Name"]; user = R[r, "UserName"] }
      k = onetask(r) ? 1 : ntasks(job "_[" R[r, "ArrayTaskID"] "]", ID)
      count(R[r, "StateCompact"], k)
    }
  for (i = 1; i <= narray_records && why == ""; i++)          # what the pending tasks wait for
    if (R[array_record[i], "StateCompact"] == "PD" && R[array_record[i], "Reason"] != "None") why = R[array_record[i], "Reason"]
  st = (done ? " · " done " done" : "") (fail ? " · " fail " failed" : "") (canc ? " · " canc " cancelled" : "") \
       (run ? " · " run " running" : "") (pend ? " · " pend " pending" : "")
  TITLE = paint("1;36", "▌ ") paint("1", job) "  " name " · " user " · array of " total (st != "" ? ": " substr(st, 4) : "")
  source_notes(1)
  if (ncv) cmed = median(CV, ncv)
  if (nmv) mmed = median(MV, nmv)
  if (ncv) line("arr", cpuline(cmed, cap, "median · min " pct1(cmin) " (" cminid ") · max " pct1(cmax) \
                ((!mixed && cap) ? " · " plural(ncpu, "CPU") " per task (" req " requested)" : "")))
  if (nmv) line("arr", memline(mmed, memcolour(mmed), "median · min " pct1(mmin) " (" mminid ") · max " pct1(mmax)))
  if (astat != "ok") note("arr", acct_down())
  else if (!done) note("arr", "no task has completed yet" (why != "" ? "; pending (" why ")" : ""))
  if (!mixed && cap) note("arr", captext(req, ncpu, cap))
  if (polled) note("arr", plural(polled, "task") ": " POLLED)
  if (done) note("arr", "over the " plural(done, "completed task") "; the weakest: sq job " cminid)
  if (rss) note("arr", plural(rss, "task") " started before " pss_text() \
                " (RSS accounting): shared memory counted once per process; their peaks may read high")
  if (multi) note("arr", plural(multi, "task") " peaked in a step of several tasks: that peak adds up each task's own, an upper bound")
  print_sections()
}

BEGIN {
  NONCE = ENVIRON["SQ_NONCE"]; NONCE2 = ENVIRON["SQ_NONCE2"]
  if (NONCE !~ /^[A-Za-z][A-Za-z0-9]{16,}$/ || NONCE2 !~ /^[A-Za-z][A-Za-z0-9]{16,}$/) {
    print "internal field separator missing" > "/dev/stderr"; exit 3
  }
  color = ENVIRON["SQJ_COLOR"]
  POLLED = "CPU time includes processes Slurm killed or never waited for (polled between two samples, so still a lower bound)"
  NOW = systime(); ID = id_anchor(); BARW = 16
  final_states()
  # every state squeue's StateCompact or sacct's State can name, both ways
  split("PD R CG S CD CA F TO NF PR BF DL OOM RQ RV RS SE CF RH RF RD SI SO step_row", sc, " ")
  split("PENDING RUNNING COMPLETING SUSPENDED COMPLETED CANCELLED FAILED TIMEOUT NODE_FAIL PREEMPTED " \
        "BOOT_FAIL DEADLINE OUT_OF_MEMORY REQUEUED REVOKED RESIZING SPECIAL_EXIT CONFIGURING " \
        "REQUEUE_HOLD REQUEUE_FED RESV_DEL_HOLD SIGNALING STAGE_OUT STOPPED", sl, " ")
  for (i in sc) { LN[sc[i]] = sl[i]; SC[sl[i]] = sc[i] }
  split("HUP INT QUIT ILL TRAP ABRT BUS FPE KILL USR1 SEGV USR2 PIPE ALRM TERM", x, " ")
  for (i in x) SIGNAME[i] = "SIG" x[i]
  SLERR[53] = "its output file could not be opened"; SLERR[52] = "its tasks could not start"
  SLERR[54] = "its prolog failed"; SLERR[46] = "no process container"; SLERR[48] = "setuid/setgid failed"
  SLERR[115] = "a spank plugin failed"
  SECNAME["state"] = "state and times"; SECNAME["res"] = "resources"; SECNAME["files"] = "files"
  SECNAME["eff"] = "efficiency"

  # squeue's records: their job id a number; sacct's rows: an id or a step's
  nq = (qstat == "ok") ? read_stream(ENVIRON["SQJ_QFILE"], NONCE, qfields, R, "^[0-9]+$") : 0
  na = (astat == "ok") ? read_stream(ENVIRON["SQJ_AFILE"], NONCE2, afields, A, ID "([.][A-Za-z0-9_+.-]+)?$") : 0
  if (nq < 0) { qstat = "bad"; nq = 0; delete R }
  if (na < 0) { astat = "bad"; na = 0; delete A }
  verdict = pick()
  if (phase == "pick") {
    printf "verdict=%s%cqstat=%s%castat=%s%craw=%s%cstate=%s%cown=%d%c", verdict, 0, qstat, 0, astat, 0, raw, 0, STATE, 0, OWN, 0
    exit 0
  }
  mem_load(ENVIRON["SQJ_MEMREAD"])
  if (verdict == "array") build_array(); else build_job()
}
JOBAWK
job_run() {   # job_run PHASE: the report's gawk, PHASE pick (what to show) or show
	env LC_ALL="$gloc" gawk -v phase="$1" -v job="$job" -v task="$task" -v myuid="$myuid" -v qstat="$qstat" \
		-v astat="$astat" -v memfail="$memfail" -v pss="$job_pss" -v tmo="$tmo" \
		-v qfields="$job_qfields" -v afields="$job_afields" "$shared_awk$fname_awk$job_awk"
}

sub_job() {
	local a v f positional=0 idraw= idset=0 job task= off= label rc qfmt= afmt= kv
	local qstat astat qwhy= qwhy_real= awhy= awhy_real= verdict= raw= state= own=0
	while [ $# -gt 0 ]; do
		a=$1; shift
		if [ $positional = 0 ]; then
			case $a in
				-h|--help) job_help; exit 0 ;;
				--)        positional=1; continue ;;
				# as before the subcommand: sq job --no-color 123 is sq --no-color job 123
				--color|--colour)       color=1; continue ;;
				--no-color|--no-colour) color=0; continue ;;
				--help=*|--color=*|--colour=*|--no-color=*|--no-colour=*)
					job_usage "${a%%=*} takes no value; write it on its own, e.g. sq job ${a%%=*} 12345" ;;
				-?*) job_usage "'$(printf '%s' "$a" | scrub 40)' is not an option of sq job (sq job -h); e.g. sq job 12345" ;;
			esac
		fi
		[ $idset = 0 ] || job_usage "one job at a time, not '$(printf '%s' "$idraw" | scrub 40)' and '$(printf '%s' "$a" | scrub 40)'; e.g. sq job 12345"
		idraw=$a idset=1
	done
	[ $idset = 1 ] || job_usage "which job? e.g. sq job 12345"
	# as sq log reads it: 12345, an array task 12345_4, a het component
	# 12345+1, base 10; 0 and the empty id are refused, as squeue would answer
	# them with every job
	if [[ $idraw =~ ^([0-9]{1,10})(_([0-9]{1,7}))?$ ]]; then
		job=$((10#${BASH_REMATCH[1]})); [ -z "${BASH_REMATCH[3]}" ] || task=$((10#${BASH_REMATCH[3]}))
	elif [[ $idraw =~ ^([0-9]{1,10})[+]([0-9]{1,4})$ ]]; then
		job=$((10#${BASH_REMATCH[1]})) off=$((10#${BASH_REMATCH[2]}))
	else job=0
	fi
	if [ "$job" -lt 1 ] || [ "$job" -gt 4294967293 ] || { [ -n "$task" ] && [ "$task" -gt 4000000 ]; }; then
		job_usage "'$(printf '%s' "$idraw" | scrub 40)' is not a job id; e.g. sq job 12345, an array task 12345_4 or an array 12345"
	fi
	label=$job${task:+_$task}
	[ -z "${SLURM_CLUSTERS+set}" ] || job_refuse_cluster SLURM_CLUSTERS
	job_pss_since
	[ -z "$off" ] || job_fail "het jobs are not supported yet"
	trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
	# every SQUEUE_* and SACCT_* setting unset: they filter, sort or reformat
	# even under --jobs / -j (SACCT_FEDERATION and SACCT_LOCAL too)
	for v in $(compgen -e); do case $v in SQUEUE_*|SACCT_*) unset "$v" ;; esac; done
	# two nonces, as the dashboard has: sacct's --delimiter is on its command
	# line for anyone to read, the queue's stays in the environment
	nonce=$(mint_nonce) && nonce2=$(mint_nonce) || die "no usable random field separator"
	[ "$nonce" != "$nonce2" ] || die "two field separators collided"
	export SQ_NONCE=$nonce SQ_NONCE2=$nonce2
	make_tmp
	# The sentinel, as sq log's: a process of its own that ticks once a
	# second (a read on a FIFO nothing writes) while sq lives.  Killed
	# outright, sq runs no EXIT cleanup, so within a tick the sentinel ends
	# the call sq was waiting for (collect -w names it in $tmp/inflight) and
	# removes $tmp; else the cleanup ends the sentinel
	collect_pidfile=$tmp/inflight
	mkfifo "$tmp/nap" && exec {job_nap}<> "$tmp/nap" || job_fail "cannot make a timer FIFO in $tmp"
	{ while kill -0 $$ 2>/dev/null; do read -t 1 -u "$job_nap"; done
	  read -r v < "$tmp/inflight" 2>/dev/null && [ -n "$v" ] && kill "$v" 2>/dev/null
	  rm -rf "$tmp"; } &
	job_sentinel_pid=$!
	color_resolve
	gawk_locale
	myuid=$(id -u 2>/dev/null)
	case $myuid in ''|*[!0-9]*) myuid= ;; esac

	for f in $job_qfields; do qfmt="$qfmt${qfmt:+,}$f:$nonce"; done
	SLURM_TIME_FORMAT=%s SLURM_BITSTR_LEN=0 SQUEUE_FORMAT2=$qfmt collect -w queue squeue -h --jobs="$label" -t all
	rc=$?
	# a job Slurm no longer knows is rc 1 and this text (23.11.4, measured)
	if [ $rc = 0 ]; then qstat=ok
	elif [ $rc = 1 ] && LC_ALL=C grep -q 'Invalid job id specified' "$tmp/queue.err" 2>/dev/null; then qstat=none
	else qstat=fail; why_of qwhy $rc "$tmp/queue" squeue
	fi
	for f in $job_afields; do afmt="$afmt${afmt:+,}$f"; done
	SLURM_TIME_FORMAT=%s SLURM_BITSTR_LEN=0 collect -w acct \
		sacct -p --delimiter="$nonce2" -n --noconvert -a -j "$label" -o "$afmt"
	rc=$?
	if [ $rc = 0 ]; then astat=ok
	else why_of awhy $rc "$tmp/acct" sacct; astat=fail; [ "$awhy_real" != "no response after ${tmo}s" ] || astat=timeout
	fi
	export SQJ_QFILE=$tmp/queue SQJ_AFILE=$tmp/acct SQJ_MEMREAD=$tmp/memread SQJ_AWHY=$awhy SQJ_COLOR=$color
	: > "$tmp/memread"

	# what to show, and whether it is the caller's own running job
	job_run pick > "$tmp/pick" 2> "$tmp/pick.err" &&
	while IFS= read -r -d '' kv; do
		case ${kv%%=*} in
			verdict) verdict=${kv#*=} ;; qstat) qstat=${kv#*=} ;; astat) astat=${kv#*=} ;;
			raw) raw=${kv#*=} ;; state) state=${kv#*=} ;; own) own=${kv#*=} ;;
		esac
	done < "$tmp/pick"
	[ -n "$verdict" ] || { a=$(scrub -f "$tmp/pick.err"); job_fail "${a:-its report failed}"; }
	[ "$qstat" != bad ] || { qwhy="squeue output unreadable" qwhy_real=$qwhy; }
	[ "$astat" != bad ] || { awhy="sacct output unreadable" awhy_real=$awhy; }
	case $verdict in
		het)  job_fail "het jobs are not supported yet" ;;
		none) # a source that did not answer might have known it
		      case $qstat:$astat in
			      ok:ok|none:ok) job_fail "Slurm does not know job $label (neither the queue nor accounting has it)" ;;
			      ok:*|none:*)   job_fail "slurm unreachable · $(first_why awhy)" ;;
			      *:ok)          job_fail "slurm unreachable · $(first_why qwhy)" ;;
			      *)             job_fail "slurm unreachable · $(first_why qwhy awhy)" ;;
		      esac ;;
	esac
	# the caller's own running job: the memory it uses, as the dashboard
	# reads it, from the snapshot every sq of the user's shares while it is
	# fresh, else JOBMEM's call for all of the caller's running jobs, which
	# renews the snapshot (its calls with this command's time and bitstring
	# formats too, which change nothing they print)
	if [ "$verdict" = one ] && [ "$own" = 1 ] && [ "$state" = R ] && [[ $raw =~ ^[0-9]+$ ]]; then
		jobmem_snapshot || SLURM_TIME_FORMAT=%s SLURM_BITSTR_LEN=0 jobmem_collect -w
	fi
	# the report on stdout: a reader that is gone (| head) ends sq quietly,
	# rc 0; a write that fails is rc 1, with gawk's reason ("print to
	# "standard output" failed (No space left on device)", or "error writing
	# standard output: ...")
	job_run show 2> "$tmp/show.err"
	rc=$?
	[ $rc != 0 ] && [ $rc != 141 ] || exit 0
	local why; why=$(scrub -f "$tmp/show.err")
	case $why in
		*"Broken pipe"*) exit 0 ;;
		*"standard output"*)
			if [[ $why =~ \(([^()]*)\)$ ]]; then why=${BASH_REMATCH[1]}; else why=${why##*: }; fi
			job_fail "cannot write the report: $why" ;;
	esac
	job_fail "${why:-its report failed (gawk exit $rc)}"
}

fields=${SQ_FMT:-i,j,u,T,M,L,C,m,R}
fsrc=${SQ_FMT:+SQ_FMT}; fsrc=${fsrc:--o}         # which one to blame for a bad letter
center=${SQ_CENTER:-0}
fold=${SQ_FOLD:-1}
recent=${SQ_RECENT:-1}
bell=${SQ_BELL:-1}
eta=${SQ_ETA:-1}
color=${SQ_COLOR:-auto}
args=()
seen=                            # the filters already set, for the repeat check
modeflag=                        # --compact or --full, as given
clustersel=0                     # --federation or --sibling given (-M is in $seen)
reserve=0                        # lines COMPACT leaves alone, e.g. for watch's header

# One example per option, because "sq -j NAME" would read wrong: a usage error
# is only useful when it shows the command the user meant.  vlist is the list
# form a repeated filter has to be written as instead.
opt_hint() {
	vlist=
	case $1 in
		-u) vnoun='a user name';        vex=$(id -un); vlist="$vex,alice" ;;
		-p) vnoun='a partition name';   vex=batch;     vlist=batch,gpu ;;
		-A) vnoun='an account name';    vex=myaccount; vlist=acct1,acct2 ;;
		-q) vnoun='a QoS name';         vex=normal;    vlist=normal,long ;;
		-j) vnoun='a job id';           vex=12345;     vlist=12345,12346 ;;
		-M) vnoun='a cluster name';     vex=mycluster; vlist=cluster1,cluster2 ;;
		-n) vnoun='a job name';         vex=myjob ;;
		-t) vnoun='a state list';       vex=R,PD ;;
		-w) vnoun='a node list';        vex=node01 ;;
		-L) vnoun='a license name';     vex=matlab ;;
		-R) vnoun='a reservation name'; vex=maint ;;
		-S) vnoun='a sort key list';    vex=-i ;;
	esac
}

# the one spelling a filter is tracked and reported under: squeue accepts up to
# three for most of them, and --me is -u with the login already filled in
canon_opt() {
	case $1 in
		-u|--user|--users)       kopt=-u ;;
		-p|--partition|--partitions) kopt=-p ;;
		-A|--account|--accounts) kopt=-A ;;
		-q|--qos)                kopt=-q ;;
		-j|--job|--jobs)         kopt=-j ;;
		-M|--cluster|--clusters) kopt=-M ;;
		-n|--name)               kopt=-n ;;
		-t|--states|--state)     kopt=-t ;;
		-w|--nodelist|--node|--nodes) kopt=-w ;;
		-L|--licenses|--license) kopt=-L ;;
		-R|--reservation)        kopt=-R ;;
		-S|--sort)               kopt=-S ;;
		*)                       kopt= ;;
	esac
}

# squeue keeps only the LAST of a repeated filter while sacct takes the UNION,
# so "sq -u fsill -u root" showed an empty queue beside a finished block full of
# root's jobs: the two halves of the screen disagreeing about what they show.
# Both tools accept the list form, so the error has somewhere to point.
mark_filter() {                  # $1 the filter's own spelling, $2 as written
	case " $seen " in
		*" $1 "*) opt_hint "$1"
			die "$2 sets the same filter twice; squeue would keep only the last one, so write one list instead, e.g. sq $1 $vlist" ;;
	esac
	seen="$seen $1"
}

# ---- where a subcommand stands, and words sq cannot place ------------------
# A subcommand is the first word after nothing but options that take no value
# and at most one "--", so `alias sq='sq --me'` still reaches `sq log 123`,
# while in `sq -n log` the word is a job name: the next word after an option
# that takes a value is that value, whatever it looks like (ROLE, below).  Its
# name is matched exactly as written, never abbreviated or case-folded.
# Every other bare word is a usage error: squeue takes none, and used to answer
# one with a fake "slurm unreachable".  The loop below keeps what this needs:
# subpos stays 1 while a subcommand may still stand at the next word (valued
# says whether an option that takes a value is what ended that), and
# after_j / after_cluster hold the word before it when that was a -j value or
# an unparsed short-option cluster (-ao); clustercause the first -M, --cluster(s),
# --federation or --sibling, which both subcommands refuse.
subcommands="log job"
is_subcommand() { case " $subcommands " in *" $1 "*) return 0 ;; esac; return 1; }
subpos=1 valued=0 after_j= after_cluster= j_seen= cluster_seen= clustercause=
# the hint for a word that is no subcommand: a fixed table, never a guess
# from edit distance.  The long options sq knows, for one written without "--"
long_names=" me all hide array noconvert noheader priority local federation sibling
	expand no-recent no-bell color colour no-color no-colour compact full center centre
	center-all centre-all reserve format help user users partition partitions account
	accounts qos job jobs cluster clusters name state states node nodes nodelist
	license licenses reservation sort "
long_names=${long_names//[$'\t\n']/ }
stray() {   # stray WORD: a word sq cannot place, refused with the hint that fits
	local w=$1 shown low hint= ex= i
	case $w in *[![:space:]]*) ;; *) die "an empty argument (an unset variable?)" ;; esac
	shown=$(printf '%s' "$w" | scrub 40)
	if [ -n "$after_cluster" ]; then   # -ao i: is i -o's value, or -a's?
		for ((i = 1; i < ${#after_cluster}; i++)); do ex="$ex -${after_cluster:i:1}"; done
		die "cannot tell what '$shown' belongs to after '$after_cluster'; write the options apart, e.g.$ex $shown"
	fi
	low=${w,,}
	if is_subcommand "$low"; then hint="sq $low"
	elif is_subcommand "${low%s}"; then hint="sq ${low%s}"
	elif [ "$low" = help ]; then hint="sq -h"
	elif case $long_names in *" $low "*) true ;; *) false ;; esac; then hint="sq --$low"
	elif [ -n "$after_j" ] && [[ $w =~ ^[0-9]+([_+][0-9]+)?$ ]]; then hint="sq -j $after_j,$w"
	elif [[ $w =~ ^[0-9]+$ ]]; then hint="sq job $w"
	fi
	die "'$shown' is not a subcommand; sq -h lists them${hint:+ (did you mean $hint?)}"
}
place_word() {   # place_word WORD REST...: run the subcommand WORD names, else refuse it
	if [ -z "$after_cluster" ] && is_subcommand "$1"; then
		# both subcommands refuse a cluster selection, also where they would
		# otherwise only be told to come first
		[ -z "$clustercause" ] || "$1_refuse_cluster" "$clustercause"
		[ "$subpos" = 1 ] || [ "$valued" = 1 ] || die "subcommands come first: sq $1 …"
		[ "$subpos" = 1 ] || die "subcommands come first, before any option that takes a value: sq $1 …"
		local sub=$1; shift
		"sub_$sub" "$@"; exit
	fi
	stray "$1"
}

while [ $# -gt 0 ]; do
	after_j=$j_seen after_cluster=$cluster_seen; j_seen= cluster_seen=
	case $1 in
		-o|--format) [ $# -ge 2 ] || die "$1 needs a column list, e.g. -o i,j,u"
			fields=$2; fsrc=-o; subpos=0 valued=1; shift 2 ;;
		-c|--center|--centre) center=1; shift ;;
		-C|--center-all|--centre-all) center=2; shift ;;
		-x|--expand) fold=0; shift ;;
		--no-recent) recent=0; shift ;;
		--no-bell) bell=0; shift ;;
		--color|--colour) color=1; shift ;;
		--no-color|--no-colour) color=0; shift ;;
		--compact|--full)       # repeating one is harmless, giving both is not
			[ -z "$modeflag" ] || [ "$modeflag" = "$1" ] \
				|| die "--compact and --full contradict each other; give one of them"
			modeflag=$1; shift ;;
		--reserve|--reserve=*)  # the value attached, or the next word
			subpos=0 valued=1
			case $1 in
				--reserve=*) reserve=${1#*=}; shift ;;
				*) [ $# -ge 2 ] || die "--reserve needs a number of lines, e.g. sq --reserve 2"
				   reserve=$2; shift 2 ;;
			esac
			case $reserve in
				''|*[!0-9]*) die "--reserve needs a number of lines, not '$(printf '%s' "$reserve" \
					| scrub 40)'; e.g. sq --reserve 2" ;;
			esac ;;
		-h|--help) awk 'NR>1 && /^#/ {sub(/^#/, ""); sub(/^ /, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
		# a squeue format flag beats SQUEUE_FORMAT, so it would silently replace
		# the nonce-framed format below and collapse every record into one field
		-O|-O?*|--Format|--Format=*|--format=*|-o?*)
			die "$1 would override sq's own output format; write the column list as 'sq -o i,j,u'" ;;
		-l)         # squeue's own long format replaces the framed one
			die "-l replaces the output format sq parses; sq -o i,j,u picks columns" ;;
		-v)         # the parameter dump contains SQUEUE_FORMAT itself, nonce and
			    # all, so one dump line parses as a record: a real job
			    # vanishes from the table and the counts lie
			die "-v prints squeue's own parameters into the output sq parses" ;;
		-V)         die "-V asks squeue for its version; run 'squeue -V' for that" ;;
		-s|-s?*|--step|--step=*|--steps|--steps=*)   # squeue ignores SQUEUE_FORMAT in step mode and has
		              # no step-format env var, so the framing cannot be delivered there.
		              # The "=" spelling has to be here too: without it --steps=x walked
		              # past this guard into exactly the mode it exists to refuse
			die "${1%%=*} lists job steps, which sq cannot frame safely; sq shows jobs" ;;
		--help=*) die "--help takes no value; write it on its own, e.g. sq --help" ;;
		# sq's own long flags take no value: "--color=never" is what every other
		# CLI accepts, and squeue answered it with a fake "slurm unreachable"
		# banner.  --me is here too, because --me IS the value.
		--me=*|--expand=*|--no-recent=*|--no-bell=*|--color=*|--colour=*|--no-color=*|--no-colour=*|--center=*|--centre=*|--center-all=*|--centre-all=*|--compact=*|--full=*)
			die "${1%%=*} takes no value; write it on its own, e.g. sq ${1%%=*}" ;;
		# -i reprints the queue every N seconds, so a collector would run until
		# SQ_TIMEOUT and the screen would read "no response after 5s"
		-i|-i?*|--iterate|--iterate=*)
			die "$1 repeats squeue's own output; sq refreshes with 'watch -tc -n 5 sq'" ;;
		# squeue ignores SQUEUE_FORMAT in these modes and answers with one whole
		# document instead of rows, so the framing never arrives and the screen
		# could only say "queue output unreadable".  Both take an OPTIONAL value,
		# so the "=" spelling has to be here too, exactly as for --steps=
		--json|--json=*|--yaml|--yaml=*)
			die "${1%%=*} asks squeue for a machine-readable document, which sq cannot render; run 'squeue ${1%%=*}' for that" ;;
		# "--" ends sq's options: what follows is a subcommand or nothing, so it
		# can neither carry a value nor smuggle an option past the guards above.
		# The filters whose value may legitimately begin with "-" (-n -t -w -L
		# -R -S) already accept one.
		--)	shift
			# a wrapper writing `sq -- "$@"` with nothing to pass produces a
			# bare "--", so swallow that
			[ $# -gt 0 ] || break
			after_j= after_cluster=; place_word "$@" ;;
		''|-|[!-]*)   # a bare word: a subcommand where one may stand, else refused
			place_word "$@" ;;
		--me)   # a user filter carrying its own value, so it collides with -u
			mark_filter -u "$1"; args+=("$1"); shift ;;
		*)
			# ROLE, for every value-taking option sq forwards: the NEXT TOKEN IS
			# ITS VALUE, whatever it looks like, so sq can never match a value
			# against one of its own flags.  "sq -u -x" used to switch on
			# --expand and leave -u bare, and the screen then blamed slurm for a
			# typo.  A value with nothing after it is still a usage error, and a
			# value is still forwarded exactly as written.
			opt=$1; val=; have=0
			case $opt in                        # a value may be attached already
				--*=*)             val=${opt#*=}; have=1; opt=${opt%%=*} ;;
				-[upAqjMntwLRS]?*) val=${opt#??}; have=1; opt=${opt:0:2} ;;
			esac
			canon_opt "$opt"
			# THE CLOSED LIST.  squeue parses its long options with getopt_long,
			# which honours any unambiguous ABBREVIATION, so every guard above was
			# walkable: "--iter=5" reached -i and stalled for the whole timeout,
			# "--part=" reached an empty -p and drew an empty queue, "--forma=%i"
			# reached -o.  sq cannot see that without carrying squeue's own option
			# table AND getopt's ambiguity rules, which drift between releases, so
			# it carries the opposite: the full names it knows, and nothing else.
			# canon_opt above holds the value-taking ones; these are the flags that
			# take none.  Enumerated from squeue 23.11's --help, its man page and
			# every prefix of every name probed against the binary.  Left off
			# deliberately: --long and --start replace SQUEUE_FORMAT, --verbose
			# prints its parameters into the stream, --version/--usage/--autocomplete
			# answer instead of querying, --json/--yaml are refused by name above,
			# and --format/--help/--me/--iterate/--steps are read by sq itself.
			if [ -z "$kopt" ]; then
				case $opt in
					--all|--hide|--array|--noconvert|--noheader|\
					--priority|--federation|--local|--sibling)
						# the name is on the list, but none of them takes a
						# value, and "--all=x" forwarded raw came back as a
						# fake outage
						[ "$1" = "$opt" ] || die "$opt takes no value; write it on its own, e.g. sq $opt"
						case $opt in --federation|--sibling) clustersel=1; clustercause=${clustercause:-$opt} ;; esac ;;
					--*) die "$(printf '%s' "$opt" | scrub 40) is not one of the long options sq forwards; sq -h lists them" ;;
					# a short option squeue may know, forwarded as written: no
					# subcommand after it, and after letters run together (-ao)
					# sq cannot tell whose value the next word is
					*)  subpos=0
					    case $1 in -[A-Za-z][A-Za-z]*) cluster_seen=$1 ;; esac ;;
				esac
				args+=("$1"); shift; continue
			fi
			subpos=0 valued=1
			case $kopt in -M) clustercause=${clustercause:-$opt} ;; esac
			[ $have -eq 1 ] || [ $# -ge 2 ] || { opt_hint "$kopt"
				die "$opt needs $vnoun, e.g. sq $opt $vex"; }
			[ $have -eq 1 ] || val=$2
			# EMPTY, for every filter: an empty value is never what anyone meant,
			# and neither tool says so.  "squeue -t ''" exits 0 with no rows and
			# no message, so "sq -t ''" drew "queue is empty" with four jobs
			# queued - the same lie the six were taught to refuse, reaching the
			# screen through the five filters that still forwarded it.  sacct is
			# no better: an empty -u exits 1 with zero bytes of stderr, and an
			# empty -j quietly returns every job.  -S is excluded: an empty sort
			# key only leaves squeue's default order, and sq -S "$SORT" with
			# SORT unset is a fair thing for a wrapper to write.
			case $kopt in
				-S) ;;
				*)  [ -n "$val" ] || { opt_hint "$kopt"
						die "$opt needs $vnoun, e.g. sq $opt $vex"; } ;;
			esac
			# SHAPE, only for the six whose values are Slurm entity names or
			# ids: no user, partition, account, QoS, job id or cluster begins
			# with "-", while a job name legally may (and a state list, node
			# list, license or reservation is forwarded as written), as may
			# -S/--sort's key, which is why none of them is in this set.
			case $kopt in
				-u|-p|-A|-q|-j|-M)
					case $val in
						-*) opt_hint "$kopt"
							die "$opt needs $vnoun, not '$(printf '%s' "$val" \
								| scrub 40)'; e.g. sq $opt $vex" ;;
					esac ;;
			esac
			# REPEAT, for every filter and not only the six: squeue keeps the LAST
			# of a repeated filter while sacct unions them, so "-t R -t PD" showed
			# "0 running" with four jobs running.  -S is excluded: a second sort
			# key refines the order, it does not contradict a filter.
			case $kopt in -S) ;; *) mark_filter "$kopt" "$opt" ;; esac
			case $kopt in -j) j_seen=$val ;; esac   # `sq -j 5 6` means -j 5,6
			if [ $have -eq 1 ]; then args+=("$1"); shift
			else args+=("$1" "$2"); shift 2; fi ;;
	esac
done

# the mode: a flag beats SQ_COMPACT, and anything else in SQ_COMPACT means
# unset, like SQ_COLOR.  Detection asks whether a screen is there to fit: a
# terminal on stdout, or COLUMNS and LINES both exported, which only watch
# (or a deliberate export) does - an interactive shell keeps them unexported.
# SQ_WIDTH/SQ_HEIGHT size the screen but never choose the mode.
screen=0
if [ -t 1 ] || { [ -n "${COLUMNS:-}" ] && [ -n "${LINES:-}" ]; }; then screen=1; fi
compact=${SQ_COMPACT:-}
case $modeflag in --compact) compact=1 ;; --full) compact=0 ;; esac
case $compact in 0|1) ;; *) compact=$screen ;; esac
# -C centres vertically only on that screen: in a file or a pipe there is no
# height to centre in, only blank lines above the dashboard
[ "$center" != 2 ] || [ "$screen" = 1 ] || center=1

color_resolve

nonce=$(mint_nonce)   || die "no usable random field separator"
# Two of the three separators cannot travel in the environment, so they are
# visible in /proc/<pid>/cmdline (mode 0444) and each gets its OWN nonce:
# sacct's --delimiter has no environment equivalent at all, nor has sinfo's -O
# (SINFO_FORMAT is -o's, and even that is silently IGNORED in -N mode - 23.11.4:
# honoured without -N, replaced by the default node format with it, rc 0).  A
# reader who catches one can then forge nothing in the other two blocks, and the
# queue nonce - the only one covering user-supplied text - never leaves the 0400
# environment.
nonce2=$(mint_nonce)  || die "no usable random field separator"
nonce3=$(mint_nonce)  || die "no usable random field separator"
[ "$nonce" != "$nonce2" ] && [ "$nonce" != "$nonce3" ] && [ "$nonce2" != "$nonce3" ] \
	|| die "two field separators collided"
# gawk reads these as ENVIRON["SQ_NONCE"] / ["SQ_NONCE2"] / ["SQ_NONCE3"]: passed
# with -v they would land on gawk's own world-readable command line
export SQ_NONCE=$nonce
export SQ_NONCE2=$nonce2
export SQ_NONCE3=$nonce3
unset SQUEUE_FORMAT SQUEUE_FORMAT2 SINFO_FORMAT   # each collector exports or passes the
                                     # one it needs, so an inherited setting can never
                                     # win over ours

# %s is the only letter that is not a squeue field, and squeue reports it on
# stderr with rc 0, so without this check it renders as a column of "%s"
squeue_letters=abcdefghijklmnopqrtuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ

# normalise "%.10i, j" -> "i j"
fl=$(printf '%s' "$fields" | tr ',' ' ' | tr -s ' ')
# qfield appends one field to the queue format and counts it, so a hidden field
# is found by the position recorded as it is added, never by arithmetic on
# what came before it
fmt= qfields=0
qfield() { fmt="$fmt%$1$nonce"; qfields=$((qfields + 1)); }
qfield i; keys=""                # hidden leading field: the job id anchors a record
for f in $fl; do                 # start even when the user did not ask for it
	k=$(printf '%s' "$f" | tr -cd 'A-Za-z' | cut -c1)
	[ -n "$k" ] || continue
	case $squeue_letters in
		*"$k"*) ;;
		*) die "%$k is not a squeue field letter (in $fsrc '$fields')" ;;
	esac
	qfield "$k"; keys="$keys$k,"
done
qfield t; qpos_state=$qfields        # hidden trailing fields: state, limit, start;
qfield l; qfield S
keys=${keys%,}                       # the last nonce leaves an empty field that only
                                     # squeue can emit, so a record ends unambiguously
# COMPACT sorts jobs by their reason code and their elapsed time, which must not
# depend on the columns shown, so it asks for both itself; FULL never reads them
[ "$compact" = 0 ] || { qfield r; qfield M; }
# The caller's own running jobs show the memory they use in MEM (see "memory
# use" below), which needs MEM on screen and no cluster selection: sstat has no
# -M, so under one it would ask the local cluster about another's ids.  Then
# the queue also brings each row's unique job id (%A, what the allocation call
# and sstat name a job by, never 123_4) and numeric uid (%U, "own" is the uid
# that `id -u` names, never a login compared as text), hidden and last.
# SLURM_CLUSTERS counts even when empty: squeue then takes the first cluster
# the database knows (slurmdb_get_info_cluster with no name), not the local one.
memon=0 qpos_jobid= qpos_uid=
case ",$keys," in *,m,*) memon=1 ;; esac
case " $seen " in *" -M "*) memon=0 ;; esac
[ "$clustersel" = 0 ] || memon=0
[ -z "${SLURM_CLUSTERS+set}" ] || memon=0
[ "$memon" = 0 ] || { qfield A; qpos_jobid=$qfields; qfield U; qpos_uid=$qfields; }

cols=${SQ_WIDTH:-${COLUMNS:-}}
lines=${SQ_HEIGHT:-${LINES:-}}
mincols=21 minlines=5            # anything smaller is no usable size, from any source,
[ "$compact" = 0 ] || minlines=1 # but COMPACT fits whatever height it is given, down
                                 # to the footer alone; 0 still means "not sized yet"

# the terminal's own size needs no terminfo entry for $TERM, which tput does
# (xterm-kitty, xterm-ghostty); asked once, and only for an axis the env left
# open.  No controlling terminal fails silently, and a pty not yet sized says
# 0 0, so a value under the minimum is left to tput instead
if [ -z "$cols" ] || [ -z "$lines" ]; then
	tty_size=$({ stty size </dev/tty; } 2>/dev/null) || tty_size=
	tty_lines=${tty_size% *} tty_cols=${tty_size#* }
	[ -n "$cols" ] || { [ "$tty_cols" -ge $mincols ] 2>/dev/null && cols=$tty_cols; }
	[ -n "$lines" ] || { [ "$tty_lines" -ge $minlines ] 2>/dev/null && lines=$tty_lines; }
fi

[ -n "$cols" ] || cols=$(tput cols 2>/dev/null) || cols=100
[ "$cols" -ge $mincols ] 2>/dev/null || cols=100

[ -n "$lines" ] || lines=$(tput lines 2>/dev/null) || lines=24
[ "$lines" -ge $minlines ] 2>/dev/null || lines=24

login=                                          # what "--me" means to squeue,
me=${SQ_BELL_USER:-$(id -un)}                   # resolved only if --me asks
bellall=${SQ_BELL_ALL:-0}

# how many finished rows to show.  0 = work it out from what the screen has
# left; anything that is not a plain positive integer is not a row count
rmax=${SQ_RECENT_MAX:-0}
case $rmax in ''|*[!0-9]*|?????????*) rmax=0 ;; esac
[ "$rmax" -gt 0 ] 2>/dev/null || rmax=0
statedir=${XDG_CACHE_HOME:-$HOME/.cache}/sq
statetmp=$statedir/alerted.$$                   # renamed over alerted at the end
[ "$bell" = 0 ] || mkdir -p "$statedir" 2>/dev/null || bell=0

# writing to /dev/tty is a gawk FATAL without a controlling terminal (ssh
# without -t, cron, systemd), and the device node exists even then, so the only
# honest probe is to open it
hastty=0
[ -c /dev/tty ] && { : >/dev/tty; } 2>/dev/null && hastty=1

# a failure only rings while it is this fresh, which is what makes a first run,
# a cleared cache and a week of downtime behave sanely
horizon=${SQ_BELL_HORIZON:-600}
case $horizon in ''|*[!0-9]*) horizon=600 ;; esac

make_tmp

# SLURM_TIME_FORMAT is pinned on every collector: "relative" or a custom
# format turns a date into something epoch() cannot read, which silently kills
# both the AGO column and the newest-first ordering
# SLURM_BITSTR_LEN=0 is pinned on every squeue and sacct call: unset, squeue
# cuts an array id at 31 characters mid-number and sacct ends a long one in
# a literal "...", and a small inherited value cuts every bracket - each such
# id fails the record anchor and the whole row is dropped
# The node collector is framed like the job ones, because a node's drain/down
# REASON is free text: a "|" in it used to shift the whole node block and a
# newline split the record.  CPUsState ("alloc/idle/other/total") leads, so a
# record is anchored by a machine-emitted field the way a job record is anchored
# by %i, and the trailing nonce leaves the empty field that ends one
# unambiguously.  It is -O, not -o, because AllocMem has no -o letter.  -O reads
# type:[.][size][suffix], so every field says size 0 - printed whole, neither
# padded nor cut (measured on 23.11.4) - and the nonce follows as the suffix:
# letter-led, so strtol cannot take any of it for a width, and alphanumeric, so
# it holds no "," to split the field list.  Those eight fields print byte for
# byte what -o's %C %N %e %m %T %E %H %O print (measured, same nonce).
nfmt=
for f in CPUsState NodeList FreeMem Memory StateLong Reason TimeStamp CPUsLoad AllocMem; do
	nfmt="$nfmt${nfmt:+,}$f:0$nonce3"
done
SLURM_TIME_FORMAT=standard collect nodes sinfo -hN -O "$nfmt"
why_of nerr $? "$tmp/nodes" sinfo

SLURM_TIME_FORMAT=standard SLURM_BITSTR_LEN=0 SQUEUE_FORMAT=$fmt collect jobs squeue -h -S t,i "${args[@]+"${args[@]}"}"
why_of jerr $? "$tmp/jobs" squeue

# ---- memory use of the caller's own running jobs: JOBMEM, above -----------
: > "$tmp/memalloc"; : > "$tmp/memread"
# does the queue stream read whole, and hold a whole record, or with UID a
# running one of that uid?  Whole as the table reads it below: lines put back
# together into records of every field and the empty sentinel, none left half
# assembled at the end, where the table would give way to "queue output
# incomplete" (or "unreadable") and no answer to another call would be shown;
# and a record as the table takes one, its job id a job id (else "no
# readable rows").  The nonce, which no name can hold, ends every field; the
# state and the uid are where qfield put them
queue_has() {   # queue_has [UID]
	env LC_ALL=C gawk -v need="$((qfields + 1))" -v pstate="$qpos_state" -v puid="$qpos_uid" -v uid="${1-}" "$shared_awk"'
		BEGIN { FS = ENVIRON["SQ_NONCE"]; JOBID = id_anchor() "$" }
		{	if (!n) { n = NF ? NF : 1; for (i = 1; i <= n; i++) F[i] = $i }
			else { F[n] = F[n] "\n" $1; for (i = 2; i <= NF; i++) F[++n] = $i }
			if (n < need) next
			if (n == need && F[need] == "" && ntasks(F[1], JOBID) >= 1 &&
			    (uid == "" || (F[pstate] == "R" && F[puid] == uid))) found = 1
			n = 0; delete F
		}
		END { exit !(found && !n) }' "$tmp/jobs"
}
if [ "$memon" = 1 ] && [ -z "$jerr" ]; then
	myuid=$(id -u 2>/dev/null)
	case $myuid in ''|*[!0-9]*) myuid= ;; esac
fi
if [ -n "$myuid" ] && queue_has "$myuid"; then jobmem_collect; fi

# ---- every job's total memory ----------------------------------------------
# MEM shows each job's total: what a running job holds, what a pending one asks
# for.  %m cannot say that (per node or per CPU, and squeue drops which), so
# one more call asks for tres-alloc, whose mem= is the job's total, about the
# very records the queue call returned: its arguments and env pins, only its
# sort dropped, so the same jobs come back and a pending array prints as the
# same one record (per task).  -O JobID is %A, which the queue brings hidden
# while MEM is shown.  Only where MEM is shown and no cluster is selected
# (memon), and only after the queue call answered with a record.  For gawk:
# $tmp/memtotal "<id> TAB <MB>" for each record with a mem= (the first of a
# repeated id stands: -P prints a job once per partition; a record without
# one leaves its row's MEM at %m), and totfail=1 when the call
# failed or answered what cannot be read, every record whole: then every cell
# it would have filled reads "!" and %m.
totfail=0
: > "$tmp/memtotal"
if [ "$memon" = 1 ] && [ -z "$jerr" ] && queue_has; then
	SLURM_TIME_FORMAT=standard SLURM_BITSTR_LEN=0 SQUEUE_FORMAT2="JobID:$nonce,tres-alloc:$nonce" \
		collect tres squeue -h "${args[@]+"${args[@]}"}"
	if [ $? -ne 0 ] || ! env LC_ALL=C gawk "$shared_awk"'
		BEGIN { RS = ENVIRON["SQ_NONCE"] "\n"; FS = ENVIRON["SQ_NONCE"] }
		NF != 2 || $1 !~ /^[0-9]+$/ || RT == "" { bad = 1; exit }
		$1 in SEEN { next }
		{ SEEN[$1] = 1; if ((mb = tres_mem($2)) >= 0) printf "%s\t%.0f\n", $1, mb }
		END { exit bad }' "$tmp/tres" > "$tmp/memtotal"
	then totfail=1; : > "$tmp/memtotal"
	fi
fi

# ---- the recently-finished block's source --------------------------------
# sacct and squeue spell the same letters differently and several take a value
# on one side but not the other (-p partition vs --parsable, -s steps vs
# --state, -S sort vs --starttime), so nothing is forwarded that is not on this
# closed list.  Dropping an unknown arg is not an option either: the queue
# table and this block would then disagree about what they are showing.
# -u maps to -u and then suppresses -a, because sacct takes the LAST of the two
# and "-u x -a" quietly means "everybody".
sargs=(); sfilt=; sskip=; suser=0; ai=0
while [ $ai -lt ${#args[@]} ]; do
	a=${args[$ai]}; ai=$((ai+1)); v=; have=0
	case $a in                                       # all four spellings:
		--me)        v=${login:=$(id -un)}; have=2 ;;   # carries no value of its own,
		--*=*)       v=${a#*=}; have=1; a=${a%%=*} ;;   # it supplies one: sacct has
		-[upAqjM]?*) v=${a#??}; have=1; a=${a:0:2} ;;   # no --me, only -u <login>
	esac
	case $a in                                       # -u x and --user x
		-u|--user)               sf=-u; lbl=user ;;
		--me)                    sf=-u; lbl=user       # "--me=x" dies in the arg loop
			[ $have -eq 2 ] || { sskip="$a takes no value"; break; }
			[ -n "$v" ] || { sskip="$a has no login name to translate"; break; } ;;
		-p|--partition)          sf=-r; lbl=part ;;
		-A|--account|--accounts) sf=-A; lbl=acct ;;
		-q|--qos)                sf=-q; lbl=qos ;;
		-j|--job|--jobs)         sf=-j; lbl=job ;;
		-M|--cluster|--clusters) sf=-M; lbl=cluster ;;
		*) sskip="$a has no sacct equivalent"; break ;;
	esac
	if [ $have -eq 0 ]; then
		[ $ai -lt ${#args[@]} ] || { sskip="$a is missing its value"; break; }
		v=${args[$ai]}; ai=$((ai+1))
	fi
	sargs+=("$sf" "$v"); sfilt="$sfilt · $lbl=$v"
	[ "$sf" = -u ] && suser=1
done
sfilt=$(printf '%s' "$sfilt" | scrub)
sskip=$(printf '%s' "$sskip" | scrub)

# an overlap filter, so a job that started days ago and ended inside the window
# is returned - which is the whole point.  Never --state: that redefines -S/-E
# from "overlapped the window" to "was in that state during it".
since=$(printf '%s' "${SQ_SINCE:-now-2hours}" | scrub 40)
[ -n "$since" ] || since=now-2hours
case $since in
	now-*) wtxt="last $(printf '%s' "${since#now-}" | sed -E 's/^([0-9]+)([A-Za-z]).*$/\1\2/')" ;;
	*)     wtxt="since $since" ;;
esac

: > "$tmp/recent"
# rwhyc names the CAUSE, not the text: "accounting is down" and "this filter
# has no accounting equivalent" both end on the squeue fallback, and the
# caption used to blame the first for both
rsrc=none; rwhy=$sskip rwhy_real=$sskip; rerr= rerr_real=; rwhyc=
[ -z "$sskip" ] || rwhyc=filter
# sacct runs whatever $jerr says: it talks to slurmdbd, not slurmctld, so it is
# the one block that can still be filled while the controller is out.  No -X,
# because the allocation row of a signalled job reports SUCCESS/0 and the
# signal lives only in its .batch step; the step rows arrive in this same call
# and gawk folds them into their parent by id.  -p, not -P: the trailing
# delimiter makes the last field a machine-emitted empty sentinel, which is the
# invariant the reassembler asserts.
if [ "$recent" != 0 ] && [ -z "$sskip" ]; then
	aflag=(-a); [ "$suser" = 0 ] || aflag=()
	SLURM_TIME_FORMAT=standard SLURM_BITSTR_LEN=0 collect recent \
		sacct -p --delimiter="$nonce2" -n -S "$since" -E now \
		"${aflag[@]+"${aflag[@]}"}" "${sargs[@]+"${sargs[@]}"}" \
		-o JobID,User,State,ExitCode,Elapsed,End,NodeList,JobName
	se=$?
	# rc=0 with no rows is not proof of success (-M/-r typos are silent), which
	# is what the closed whitelist above is for; rc!=0 can still leave a partial
	# file behind, so that is thrown away rather than rendered
	if [ $se -eq 0 ]; then rsrc=sacct
	else why_of rwhy $se "$tmp/recent" sacct; rwhyc=acct; : > "$tmp/recent"
	fi
fi

# every field is nonce-terminated, including the last, so gawk can tell a name
# holding the delimiter, a tab or a newline from a real record boundary
if [ "$recent" != 0 ] && [ "$rsrc" = none ] && [ -z "$jerr" ]; then
	SLURM_TIME_FORMAT=standard SLURM_BITSTR_LEN=0 \
		SQUEUE_FORMAT2="JobID:$nonce,StateCompact:$nonce,State:$nonce,exit_code:$nonce,TimeUsed:$nonce,EndTime:$nonce,ArrayJobID:$nonce,ArrayTaskID:$nonce,UserName:$nonce,Name:$nonce" \
		collect recent squeue -t all -h "${args[@]+"${args[@]}"}"
	fe=$?
	if [ $fe -eq 0 ]; then rsrc=squeue
	else why_of rerr $fe "$tmp/recent" squeue; : > "$tmp/recent"
	fi
fi

# "CANCELLED by <uid>" is the only state carrying a number, and a uid means
# nothing to a reader.  Resolved here, not in gawk, which has no passwd access.
uidmap=
if [ "$rsrc" = sacct ]; then
	for u in $(LC_ALL=C grep -ao 'CANCELLED by [0-9][0-9]*' "$tmp/recent" 2>/dev/null \
	           | LC_ALL=C awk '{print $3}' | sort -u); do
		nm=$(getent passwd "$u" 2>/dev/null | cut -d: -f1 | tr -cd 'A-Za-z0-9._-')
		[ -n "$nm" ] && uidmap="$uidmap$u=$nm,"
	done
fi

gawk_locale

# Every value that can carry outside text - a setting, a filter, a path, the
# host name, a collector's stderr - reaches gawk through ENVIRON, which it takes
# byte for byte.  A -v value has its backslash escapes processed AFTER the scrub
# above, so "sq -u 'alice\nFORGED: 0 jobs'" printed a forged line.  -v carries
# only what sq minted or validated itself: numbers, fixed words, field letters.
# sqv names them once: each is the shell variable of that name, exported as
# SQV_<name>, and gawk reads the same list back into its own variable.
statef=$statedir/alerted host=$(hostname -s | scrub) now=$(date '+%H:%M:%S %Z')
# the unreachable banner names sinfo's reason or squeue's; "finished jobs
# unavailable" the filter or sacct's, the fallback's, squeue's: the filter is
# the actionable half and the fallback's stderr only a symptom
uwhy=$(first_why nerr jerr) fwhy=$(first_why rwhy rerr jerr)
memallocf=$tmp/memalloc memreadf=$tmp/memread memtotalf=$tmp/memtotal
sqv="center fold color bell eta recent bellall me statef statetmp uwhy jerr rwhy fwhy wtxt sfilt host now memallocf memreadf memtotalf"
for v in $sqv; do export "SQV_$v=${!v}"; done
env LC_ALL="$gloc" gawk -v keys="$keys" -v cols="$cols" -v lines="$lines" -v hastty="$hastty" \
                      -v horizon="$horizon" -v rsrc="$rsrc" -v rwhyc="$rwhyc" -v rmax="$rmax" \
                      -v compact="$compact" -v reserve="$reserve" -v uidmap="$uidmap" -v sqv="$sqv" \
                      -v screen="$screen" -v memon="$memon" -v myuid="$myuid" -v memfail="$memfail" -v totfail="$totfail" \
                      -v qfields="$qfields" -v qpos_jobid="$qpos_jobid" -v qpos_uid="$qpos_uid" "$shared_awk"'
function compress(list,   a, m, i, out, start, prev) {    # 0,1,2,5 -> 0-2,5
  m = split(list, a, ",")
  for (i=1; i<=m; i++) a[i] = a[i]+0
  asort(a)
  start = prev = a[1]
  for (i=2; i<=m; i++) {
    if (a[i] == prev+1 || a[i] == prev) { prev = a[i]; continue }
    out = out (out?",":"") (start==prev ? start : start "-" prev)
    start = prev = a[i]
  }
  return out (out?",":"") (start==prev ? start : start "-" prev)
}
# An id cell narrowed to wd: a bracket shrinks INSIDE, 600_[1,4,7,…] ×67, since
# the right cut takes the ×N first and that is what a long irregular set is
# read for.  The content keeps whole leading terms only (a cut number would
# name a task the set may not have), and a throttle %n goes with it:
# concurrency, not membership.
# Below BASE_[…] ×N the cell is returned whole, for the plain right cut:
# the base id is in this cell alone, the footer and "+N more" still count.
function idfloor(x,   b) {                  # the narrowest idfit() can go
  return match(x, BRACKET, b) ? length(b[1] b[3] "…") : length(x)
}
function idfit(x, wd,   b, keep) {
  if (length(x) <= wd || wd < idfloor(x)) return x
  match(x, BRACKET, b)
  keep = substr(b[2], 1, wd - length(b[1] b[3] "…"))   # "…" is 3 under LC_ALL=C
  sub(/[^,]*$/, "", keep)
  return b[1] keep "…" b[3]
}
function epoch(t,   d) {                                  # 2026-08-13T10:59:35 -> epoch
  if (t !~ /^[0-9]{4}-/) return 0
  d = t; gsub(/[-T:]/, " ", d)
  return mktime(d)
}
function exset(list, cap,   a, m, i, seen, sk, idx, o, c, nd, x) {
  m = split(list, a, ",")                 # distinct exits, WORST FIRST, then capped:
  for (i=1; i<=m; i++) {                  # taking them in row order hid the loudest
    if (a[i] in seen) continue            # failure behind the ellipsis, because row
    seen[a[i]] = 1                        # order is task order.  The list holds raw
    split(a[i], x, ":")                   # "rc:N" pairs, so the order is numeric and
    sk[sprintf("%03d:%03d", 999-x[1], 999-x[2])] = exlabel(x[1], x[2])   # no label
  }                                       # text is ever parsed back
  nd = asorti(sk, idx)
  for (i=1; i<=nd; i++) if (++c <= cap) o = o (o?",":"") sk[idx[i]]
  return (nd > cap) ? o ",…" : o
}
function fcol(code) {                     # one table drives finished-ness, the bell
  if (code == "") return "36"             # and the colour, so PREEMPTED and REVOKED
  if (code == "CD") return "32"           # stop reading as failures and an unknown
  return (code in BAD) ? "31" : "33"      # state is loud instead of silent
}
function when(t,   ep) {                                  # start estimate, compactly
  ep = epoch(t)
