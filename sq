  for (i=1; i<=nu; i++) if (split(um[i], uv, "=") == 2) UMAP[uv[1]] = uv[2]
  pend_tables()
  split("stuck|blocked on nodes|held by admin|pending|running|other", SECNAME, "|")
  split("title banner qcap notes nodes reasons fin fslots b0 b1 b2 b3 b4", SHOWN, " ")
  split("JOBID NAME STATE EXIT ELAPSED AGO", rhd, " ")
  split("0 0 0 1 1 1", rrt, " ")                          # right-aligned?
  if (bell && hastty) {                                 # id<TAB>end, aged out
