# the final states, by squeue code, into DONE, and those that are failures
# (worth a bell, red) into BAD
function final_states(   ts, i) {
  split("CD F CA TO NF OOM DL PR BF RV SE", ts, " "); for (i in ts) DONE[ts[i]] = 1
  split("F TO NF OOM DL BF", ts, " "); for (i in ts) BAD[ts[i]] = 1
}
