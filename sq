  if (why in FAULT || why ~ /^ReqNodeNotAvail/ || why ~ /^Nodes required for job are /) return 2
  return (why == "JobHeldAdmin" || why ~ /requeued held$/ || why ~ /^job requeued in /) ? 3 : 1
