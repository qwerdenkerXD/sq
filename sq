# one nonce per input, so a separator leaked by one collector cannot frame a
# record for another: nodes got NONCE3, the queue NONCE, the finished block
# whichever its source was given.  BEGINFILE runs before the first record of a
# file, so it is in time
BEGINFILE { FS = (ARGIND == 1) ? NONCE3 : (ARGIND == 3 && SACCT) ? NONCE2 : NONCE
            anf = 0; delete ACC }
ENDFILE   {                     # unreadable (our format never took effect, e.g. an
  if (anf) {                    # abbreviated --forma=) vs genuinely cut off mid-record
    if (ARGIND == 1) { if (seen[1]) ntrunc = 1; else nbad = 1 }
    if (ARGIND == 2) { if (seen[2]) qtrunc = 1; else qbad = 1 }
    if (ARGIND == 3) { if (seen[3]) rtrunc = 1; else rbad = 1 }
  }
}

{                               # ---- every collector, reassembled
  # A newline inside a field splits one record over several physical lines: the
  # last field of a line and the first of the next are two halves of one field.
  # A blank line is never skipped - it is a field that begins or ends with one.
  if (NF > 1) seen[ARGIND] = 1   # the separator did arrive, so the format took effect
  if (anf == 0) { anf = NF ? NF : 1; for (i=1; i<=anf; i++) ACC[i] = $i }
  else { ACC[anf] = ACC[anf] "\n" $1; for (i=2; i<=NF; i++) ACC[++anf] = $i }
  need = (ARGIND == 1) ? FN : (ARGIND == 2) ? FQ : FR
  # Complete only with every separator seen, the machine-emitted empty sentinel
  # last and a machine-emitted anchor first.  Neither a job name nor a node reason
  # can contain the nonce of this run, so neither can forge a boundary or hide
  # one, and NF alone could not tell.
  anchor = (ARGIND == 1) ? NODEID : (ARGIND == 3 && SACCT) ? SACCTID : JOBID
  if (anf < need) next                          # a field held a newline: read on
  # ... and an id that names at least one job.  In the fallback -O JobID is the
  # plain job id and its expression arrives bare in ArrayTaskID (0-9%3), so it
  # is put back together the way %i and sacct print it, and gated as that
  tid = ACC[1]
  if (ARGIND == 3 && !SACCT && ACC[8] != "N/A" && ACC[8] !~ /^[0-9]+$/)
    tid = ACC[7] "_[" ACC[8] "]"
  if (anf > need || ACC[need] != "" || ACC[1] !~ anchor || (tw = ntasks(tid, anchor)) < 1) {
    skip[ARGIND]++                              # a row we cannot read (squeue
    anf = 0; delete ACC                         # -s emits step ids, say): lose that
    next                                        # record, never the rest of the stream
  }
  if (ARGIND == 1) rawnode = ACC[2]             # the name as sinfo sent it, unscrubbed
  for (i=1; i<=need; i++) { F[i] = ACC[i]; gsub(/[[:cntrl:]]/, "?", F[i]) }
  anf = 0; delete ACC           # scrubbed before any width or colour is read

  # ---- sinfo: CPUsState NodeList FreeMem Memory StateLong Reason TimeStamp
  #      CPUsLoad AllocMem
  if (ARGIND == 1) {
    if (rawnode in nodeseen) next               # sinfo -N prints one record per node
    nodeseen[rawnode] = 1                       # and partition: the first one stands
    nn++
    node[nn] = F[2]; nst[nn] = F[5]
    split(F[1], cp, "/"); used[nn] = cp[1]+0; tot[nn] = cp[4]+0
    load[nn] = (F[8] ~ /^[0-9]+([.][0-9]+)?$/) ? F[8]+0 : -1    # N/A: not known
    memreal[nn] = F[4]+0; memalloc[nn] = F[9]+0
    if (F[3] == "N/A") { memu[nn] = "-"; mempc[nn] = -1; meminuse[nn] = -1 }
    else {
      usedmem = F[4] - F[3]                     # RealMemory can be configured below the
      if (usedmem < 0) usedmem = 0              # real RAM, so FreeMem may exceed it
      memu[nn]  = sprintf("%.0f", usedmem/1024)
      mempc[nn] = F[4] ? int(usedmem*100/F[4]) : 0
      meminuse[nn] = usedmem
    }
    memt[nn] = sprintf("%.0fG", F[4]/1024)
    nreason[nn] = (F[6] == "none" || F[6] == "") ? "" : F[6]
    if (nreason[nn] != "" && F[7] ~ /^[0-9]{4}-/) nreason[nn] = nreason[nn] " · since " substr(F[7], 1, 10)
    if (length(F[2])     > wn) wn = length(F[2])
    if (length(F[5])     > ws) ws = length(F[5])
    if (length(used[nn]) > wu) wu = length(used[nn])
    if (length(tot[nn])  > wt) wt = length(tot[nn])
    if (length(memu[nn]) > wf) wf = length(memu[nn])
    if (length(memt[nn]) > wm) wm = length(memt[nn])
    next
  }
  if (ARGIND == 2) {                            # ---- queue: %i, n fields, 3 hidden
    q++
    for (i=1; i<=n; i++) raw[q,i] = F[i+1]
    qstate[q] = F[n+2]; qlimit[q] = F[n+3]; qstart[q] = F[n+4]
    if (compact) { qwhy[q] = F[n+5]; qsec[q] = dur(F[n+6]) }
    if (memon) { row_jobid[q] = F[qpos_jobid]; row_uid[q] = F[qpos_uid] }
    qw[q] = tw; qjobs += tw                     # a pending bracket is many jobs in one
    cnt[F[n+2]] += tw                           # row; tw is read from the hidden %i, so
                                                # it counts whatever columns are shown
    next
  }
  if (SACCT) {       # ---- sacct: JobID User State ExitCode Elapsed End Node Name
    if ((dot = index(F[1], ".")) > 0) {   # a step row only adds its exit to the
      xcm(substr(F[1], 1, dot-1), F[4])   # job: a signal, an OOM or a launch error
      next                                # often shows on a step row alone
    }
    xcm(F[1], F[4])
    ep = epoch(F[6])
    # a second allocation row for one id (a requeue rewrite).  Its exit still
    # counts towards the fold, its STATE only if it is the later attempt: 23.11
    # rewrites the row in place, but letting row order decide would mean a job
    # that ended COMPLETED could render FAILED - and ring - on a release that
    # keeps both rows.  A later row could in principle hide an earlier terminal
    # one, but a running or pending row has End=Unknown, which epoch() reads as
    # 0, so it always loses the comparison
    if (F[1] in arow) {
      if (ep <= aend[F[1]]) next
      s = arow[F[1]]
    } else {
      s = ++dq; arow[F[1]] = s
    }
    aend[F[1]] = ep
    split(F[3], stok, " ")
    code = (stok[1] in SC) ? SC[stok[1]] : ""
    ddrop[s] = (code != "" && !FIN[stok[1]])   # running, pending, requeued, resizing
    did[s] = dlbl[s] = F[1]; duser[s] = F[2]; dw[s] = tw
    dsc[s] = code                         # "" = unknown: raw, cyan, never rings
    dstate[s] = stok[1]                   # " by <uid>" never reaches the display
    dcxl[s] = (stok[1] == "CANCELLED" && stok[2] == "by") ? stok[3] : ""
    dsec[s] = dur(F[5])                   # the raw HH:MM:SS is never displayed
    dend[s] = ep; dname[s] = F[8]
    # accounting has no Array* field at all, so base and task come from the
    # JobID; a bracketed id (10401_[0-9]) names no single task and never folds
    if (match(F[1], /^(.+)_([0-9]+)$/, smm)) { daj[s] = smm[1]; dat[s] = smm[2] }
    else                                     { daj[s] = F[1];   dat[s] = "" }
    dkey[s] = dstate[s] SUBSEP dcxl[s]
    next
  }
  if (!(F[2] in DONE)) next                     # ---- squeue -t all, finished only
  xcm(F[1], F[4], 1)
  dq++
  did[dq]=F[1]; dname[dq]=F[10]; dsc[dq]=F[2]; dstate[dq]=F[3]
  dlbl[dq]=tid; dw[dq]=tw         # shown as sacct shows it; the bell keeps the JobID
  dkey[dq]=F[2]; dcxl[dq]=""
  dsec[dq]=dur(F[5])
  dend[dq]=epoch(F[6]); daj[dq]=F[7]; dat[dq]=F[8]; duser[dq]=F[9]
}

END{
  if (fatal) exit 1
  # A record left half-assembled at EOF means the stream was cut off, never a
  # hostile name or reason: show a caption instead of a table, a bar or a count
  # built from what arrived
  # the nfix constant and BAR_PREF still claim their minimum for the shared right edge,
  # exactly as they do when sinfo returns nothing at all, so the caption sits on a
  # narrower dashboard than a healthy node block would give
  if (ntrunc || nbad) { nn = 0; wn = wu = wt = wf = wm = ws = 0 }
  if (nn) membar()
  if (qtrunc || qbad) q = 0
  if (rtrunc || rbad) dq = 0

  # ---- the running rows of the caller: what each one reads ----------------
  # row_outcome "ok", "none" or "failed"; row_alloc_mb its allocation (0: not
  # known), row_bytes the bytes in use.  Not measured (no allocation, several
  # nodes) or not in the snapshot (started since): "none"
  for (r=1; r<=q && memon && myuid != ""; r++) {
    if (row_uid[r] != myuid || qstate[r] != "R") continue
    a = row_jobid[r]
    if (memfail) { row_outcome[r] = "failed"; continue }
    row_alloc_mb[r] = job_alloc_mb[a] + 0
    row_outcome[r] = mem_outcome(a, row_alloc_mb[r], job_nodes[a])
    row_bytes[r] = job_bytes[a]
  }

  # ---- pending start estimates, before folding so they stay per-task ---
  if (eta && rc)
    for (r=1; r<=q; r++)
      if (qstate[r] == "PD" && (est = when(qstart[r])) != "")
        raw[r,rc] = raw[r,rc] " → " est

  # ---- fold array tasks ----------------------------------------------
  for (r=1; r<=q; r++) {
    id = idc ? raw[r,idc] : ""
    base = ""; task = ""
    if (fold && idc && match(id, /^(.+)_([0-9]+)$/, mm)) { base = mm[1]; task = mm[2] }
    if (base == "") key = "row" SUBSEP r
    else {
      key = base SUBSEP qstate[r]
      for (i=1; i<=n; i++) if (i != idc) key = key SUBSEP raw[r,i]
    }
    c = jclass(qstate[r], qwhy[r])
    if (key in grp) {
      g = grp[key]; gtask[g] = gtask[g] "," task; gn[g]++; gw[g] += qw[r]
      memadd(g, r); totadd(g, r)
      if (c < section[g]) section[g] = c        # the most visible task decides, and
      if (qsec[r] > rsec[g]) rsec[g] = qsec[r]  # the longest-running one survives
    } else {
      grp[key] = g = ++rows
      for (i=1; i<=n; i++) v[rows,i] = raw[r,i]
      state[rows] = qstate[r]; gtask[rows] = task; gn[rows] = 1; gbase[rows] = base
      gw[rows] = qw[r]; section[rows] = c; rsec[rows] = qsec[r]
      memadd(rows, r); totadd(rows, r)
      lfrac[rows] = -1
      if (lc) {                                 # how much of the limit is left
        lim = dur(qlimit[r]); lft = dur(raw[r,lc])
        if (lim > 0 && lft >= 0) lfrac[rows] = lft / lim
      }
    }
  }
  # gn counts distinct ids and alone decides the rebuild, or a bracket would come
  # out as 7000_[1-20]_[] ×20; a bracket never folds (it has no _N), so its ×N
  # is the weight of its own row, and shows under -x too
  for (r=1; r<=rows; r++)
    if (gn[r] > 1) v[r,idc] = sprintf("%s_[%s] ×%d", gbase[r], compress(gtask[r]), gn[r])
    else if (idc && gw[r] > 1) v[r,idc] = v[r,idc] " ×" gw[r]
  if (mc) for (r in grp_own) memcells(r)
  MEMFORMS["decimal"] = MEMFORMS["whole"] = 1
  if (mc) for (r in grp_other) othercells(r)

  # ---- group finished jobs by array base, state and canceller ---------
  for (r=1; r<=dq; r++) {
    if (ddrop[r]) continue                      # the winning row says not finished
    if (fold && dat[r] ~ /^[0-9]+$/) key = "a" SUBSEP daj[r] SUBSEP dkey[r]
    else                             key = "s" SUBSEP r
    if (key in dgrp) g = dgrp[key]
    else {
      dgrp[key] = g = ++d
      gid1[d]=dlbl[r]; rname[d]=dname[r]; rstate[d]=dstate[r]; gcxl[d]=dcxl[r]
      rst[d]=dsc[r]; rend[d]=rmin[d]=dend[r]; gbase2[d]=daj[r]
      guser[d]=duser[r]; gmin[d]=gmax[d]=dsec[r]
    }
    ex = (JRC[did[r]]+0) ":" (JSG[did[r]]+0)    # raw, labelled by exset
    grows[g]++
    gex[g]  = (grows[g] > 1 ? gex[g]  "," : "") ex
    gids[g] = (grows[g] > 1 ? gids[g] "," : "") did[r]
    if (!((g SUBSEP dat[r]) in gseen)) {        # ×N counts DISTINCT task ids, so no
      gseen[g SUBSEP dat[r]] = 1                # step row or repeated row can inflate
      gtsk[g] = (gcnt[g] ? gtsk[g] "," : "") dat[r]
      gcnt[g]++
      gw2[g] += dw[r]                           # and jobs: a bracket is many in one row
    }
    if (dsec[r] < gmin[g]) gmin[g] = dsec[r]
    if (dsec[r] > gmax[g]) gmax[g] = dsec[r]
    if (dend[r] > rend[g]) rend[g] = dend[r]
    if (dend[r] < rmin[g]) rmin[g] = dend[r]
  }

  # Newest End first, globally, with at most two groups per array base in the
  # first pass.  Round-robin gave every base a slot before any base got a
  # second, which demoted a FRESH array failure below four staler single jobs
  # - seen live, with a fresh FAILED group hidden behind "+118 more".
  # A non-array group is its own base, so single jobs are never capped against
  # each other.  The second pass refills from what the cap held back, still
  # newest-first, so a window with few bases wastes no slot.
  for (r=1; r<=d; r++) {
    best = 0
    for (j=1; j<=d; j++) if (!dused[j] && (!best || rend[j] > rend[best])) best = j
    dused[best] = 1
    sord[r] = best
  }
  r = 0
  for (j=1; j<=d; j++) {
    g = sord[j]
    if (bn[gbase2[g]]++ >= 2) { held[++nheld] = g; continue }
    ord[++r] = g
  }
  for (j=1; j<=nheld; j++) ord[++r] = held[j]
  for (g=1; g<=d; g++) if (gcxl[g] != "") {    # a canceller who is the owner is
    cn = (gcxl[g] in UMAP) ? UMAP[gcxl[g]] : gcxl[g]     # noise; anybody else is
    gcxl[g] = (cn == guser[g]) ? "" : cn                 # the answer, and costs
  }                                                      # nothing but EXIT slack

  # ---- what the screen shows ------------------------------------------
  # Rows keep the order squeue gave them; the sections only decide which rows
  # survive.  Running survives by elapsed time, longest first, so a hidden row
  # can sit between two shown ones; the other sections survive in squeue order.
  # A "… n jobs" line follows the last row of its block, shown or not: those of
  # the pending categories together after the last pending row, so they never
  # split rows that interleave by id, running after its own, other states last.
  for (r=1; r<=rows; r++) {
    x = section[r]; SECR[x, ++SECN[x]] = r; RANK[x, SECN[x]] = SECN[x]
    if (state[r] == "PD") lastpd = r
  }
  for (x=1; x<=4; x++) ELLAT[x] = lastpd
  ELLAT[5] = SECR[5, SECN[5]]; ELLAT[6] = rows
  # the counts come only from a whole, readable job list.  When squeue failed
  # or hung, or its stream was unreadable or cut off (counting what arrived
  # would be a lower bound), the footer says "?" for each instead of a number
  QKNOWN = (jerr == "" && !qtrunc && !qbad)
  BANNER = (uwhy != "")
  QCAP   = (qbad || qtrunc || !rows)            # a caption stands in for the table
  NOTES  = (skip[2] > 0) + (skip[3] > 0)
  for (r=1; r<=nn; r++) if (nreason[r] != "") NRSN++
  if (compact) {
    for (i=1; i<=SECN[5]; i++)                  # ties keep squeue order
      ek[sprintf("%d %013d %07d", memband(SECR[5,i]), 999999999999 - rsec[SECR[5,i]], i)] = i
    asorti(ek, eo)
    for (j=1; j<=SECN[5]; j++) RANK[5, ek[eo[j]]] = j
    FINCAP = rmax ? rmax : 25                   # SQ_RECENT_MAX caps the rows here
    FSLOTS = (d <= FINCAP) ? d : FINCAP + 1     # rows, plus "+N more" if any is cut
    for (j=1; j<=d && !(rst[ord[j]] in BAD); j++) ;   # "in": a lookup would add the
                                                       # key, and fcol() reads BAD by "in"
    if (j > d) j = 1                            # the one line: the newest failure, else
    FAILJ = j; FAILG = ord[j]                   # the newest job; the block reaches
    FMIN = (j + 1 >= d) ? d : j + 1             # down to it at least
    if (FMIN > FSLOTS) FMIN = FSLOTS
    avail = lines - reserve
    fit()
  } else {                                      # FULL: everything
    for (x in SHOWN) SHOW[SHOWN[x]] = 1
    SHOW["nodes"] = SHOW["fin"] = 2
    for (x=1; x<=6; x++) QUOTA[x] = SECN[x]
    avail = lines
  }
  for (x=1; x<=6; x++) {                        # the survivors, and what each
    if (QUOTA[x] < 0) continue                  # "… n jobs" line counts
    hid = 0
    for (i=1; i<=SECN[x]; i++)
      if (RANK[x,i] <= QUOTA[x]) QSHOW[SECR[x,i]] = 1
      else { hid++; ELLJ[x] += gw[SECR[x,i]]; last = SECR[x,i] }
    if (hid == 1) { QSHOW[last] = 1; delete ELLJ[x] }    # it costs what its line would
  }
  QBODY = qbody()

  # ---- natural widths -------------------------------------------------
  for (i=1; i<=n; i++) w[i] = length(hd[i])
  for (r=1; r<=rows; r++) if (QSHOW[r])          # the rows SHOWN: a collapsed id
    for (i=1; i<=n; i++) if (length(v[r,i]) > w[i]) w[i] = length(v[r,i])    # widens nothing

  nfix = 30 + wn + wu + wt + wf + wm + ws       # node line, bars and margin aside
  bar  = BAR_PREF
  tabw = QBODY ? (n-1) : 0                      # one space per gap
  for (i=1; i<=n; i++) tabw += w[i]

  # ---- shrink whatever cannot fit -------------------------------------
  budget = cols - 2                             # keep at least the default margin
  # own MEM cells are form b with decimal allocations, every other one a
  # decimal total; on a screen where the table with them is too wide, all of
  # them take whole numbers, and if that is still too wide and the screen shows
  # colour, own cells form a, the allocation, which the colour alone
  # qualifies.  Off a screen always decimal.  MEM is cut last, as a cut cell
  # ("1006.…") loses its unit: only once every other column is down to its
  # floor, so a screen too narrow even for that still gets its height
  formb = (mc && length(grp_own))
  if (screen && tabw > budget && (formb || length(grp_other))) memform("whole")
  if (formb && screen && color && tabw > budget) memform("alloc")
  while (tabw > budget) {                       # shave the widest flexible column
    big = 0
    for (i=1; i<=n; i++) if (FLEX[k[i]] && w[i] > 8 && w[i] > w[big]) big = i
    if (!big) break
    w[big]--; tabw--
  }
  while (tabw > budget) {                       # still over: any column, floor 5
    big = 0
    for (i=1; i<=n; i++) if (w[i] > 5 && w[i] > w[big] && i != mc) big = i
    if (!big && mc && w[mc] > 5) big = mc        # MEM last
    if (!big) break
    w[big]--; tabw--
  }

  # FULL shows every finished job: SQ_SINCE already bounds the block, and cut
  # to the height of the screen it hid an old failure behind "+N more".  A
  # SQ_RECENT_MAX you set still caps it, as given
  shown = (rmax && d > rmax) ? rmax : d
  if (compact) shown = (SHOW["fin"] == 2) ? finrows() : 0
  # when the cap cuts the block above the newest failure, the failure takes its
  # last row, so it is never lost; "+N more" still counts every job not shown
  if (compact && shown && FAILJ > shown) {
    for (j=FAILJ; j>shown; j--) ord[j] = ord[j-1]
    ord[shown] = FAILG
  }
  more = 0                                      # jobs, not groups: "+2 more" must
  for (r=shown+1; r<=d; r++) more += gw2[ord[r]]      # not be able to hide 200 tasks

  # ---- the finished rows, then a shrink ladder until they fit ----------
  idmin = length(rhd[1])                        # how far rung 4 may shave JOBID
  for (r=1; r<=shown; r++) {                    # level-independent cells, once
    g = ord[r]
    rv[g,1] = fid(g)
    if (idfloor(rv[g,1]) > idmin) idmin = idfloor(rv[g,1])
    rv[g,2] = rname[g]
    if (!rend[g]) rv[g,6] = "-"
    else {                                      # a group whose tasks ended minutes
      lo = ago(systime() - rend[g])             # apart must not claim one of their
      hi = rmin[g] ? ago(systime() - rmin[g]) : lo        # times for the whole group
      rv[g,6] = (lo == hi) ? lo : lo "-" hi
    }
  }
  # NAME alone used to be shaved, and at 8 characters it gave up and let this
  # block run past the shared right edge; each rung drops the least useful
  # detail instead, down to the compact state code as a last resort
  for (lvl=0; lvl<=5; lvl++) {
    excap = (lvl >= 3) ? 1 : (lvl >= 2) ? 2 : 3
    for (r=1; r<=shown; r++) {
      g = ord[r]
      rv[g,3] = (lvl >= 5 && rst[g] != "") ? rst[g] : rstate[g]
      rv[g,4] = fexit(g, excap)
      rv[g,5] = (gmin[g] == gmax[g] || lvl >= 1) ? elap(gmax[g]) \
                                                 : elap(gmin[g]) "-" elap(gmax[g])
    }
    for (i=1; i<=6; i++) rw[i] = length(rhd[i])
    for (r=1; r<=shown; r++)
      for (i=1; i<=6; i++) if (length(rv[ord[r],i]) > rw[i]) rw[i] = length(rv[ord[r],i])
    rtabw = shown ? 5 : 0
    for (i=1; i<=6; i++) if (shown) rtabw += rw[i]
    while (rtabw > budget && rw[2] > 8) { rw[2]--; rtabw-- }   # NAME first, always
    while (lvl >= 4 && rtabw > budget && rw[1] > idmin) { rw[1]--; rtabw-- }   # then
    if (rtabw <= budget) break                  # inside the brackets, never past ×N
  }
  while (rtabw > budget) {                      # a terminal too narrow even for that
    big = 0
    for (i=1; i<=6; i++) if (rw[i] > 4 && rw[i] > rw[big]) big = i
    if (!big) break
    rw[big]--; rtabw--
  }

  # ---- agree on a common right edge -----------------------------------
  # BAR_MIN counts both bars together, 2 cells each at least: no width draws a
  # bar of 1 to 3 cells.  With bar 0 both gaps before the percentages go too,
  # so the node line is nfix - 2 wide
  if (nfix + bar > budget) bar = budget - nfix
  if (bar < BAR_MIN) bar = 0
  nodew  = nfix + bar - (bar ? 0 : 2)
  target = (tabw > nodew) ? tabw : nodew
  if (rtabw > target) target = rtabw
  if (target > budget) target = budget

  if (nodew < target) {                         # node block grows: bars first, to
    bar = target - nfix                         # nfix + bar.  "+= target - nodew" left
                                                # out the gap of bars that had collapsed
                                                # and ran one column past the edge
    # bars too narrow to draw go, and the line is padded before the state
    # instead, so the state column still ends on the shared edge
    if (bar < BAR_MIN) { npad = target - (nfix - 2); bar = 0 }
    else if (bar > BAR_MAX) { npad = bar - BAR_MAX; bar = BAR_MAX }
  }
  gap[1] = 0                                    # table grows: gaps first, capped, then
  for (i=2; i<=n; i++) gap[i] = 1               # the widest text column soaks up the rest
  if (QBODY && tabw < target) {
    extra = target - tabw
    room  = (n > 1) ? (n-1) * (GAP_MAX - 1) : 0
    if (room > extra) room = extra
    for (j=0; j<room; j++) gap[2 + (j % (n-1))]++
    rest = extra - room
    if (rest) {
      pick = 0                                  # prefer a flexible column ...
      for (i=1; i<=n; i++) if (FLEX[k[i]] && (!pick || w[i] > w[pick])) pick = i
      if (!pick) for (i=n; i>=1; i--) if (!RIGHT[k[i]]) { pick = i; break }
      if (pick) w[pick] += rest                 # ... never a right-aligned one
      else for (j=0; j<rest; j++) gap[2 + (j % (n-1))]++
    }
  }
  rgap[1] = 0
  for (i=2; i<=6; i++) rgap[i] = 1
  if (shown && rtabw < target) {
    extra = target - rtabw
    room  = 5 * (GAP_MAX - 1)
    if (room > extra) room = extra
    for (j=0; j<room; j++) rgap[2 + (j % 5)]++
    rpad = extra - room                         # the rule reaches the edge, rows stay compact
  }

  # ---- left margin ----------------------------------------------------
  left = center ? int((cols - target) / 2) : 2
  if (left < 0) left = 0
  lm = sprintf("%*s", left, "")

  # ---- render into a buffer, so we can centre vertically --------------
  if (SHOW["title"])
    out[++o] = sprintf("%s%s▌ SLURM%s %s%s%s  %s%s%s", lm, e("1;36"), e("0"), e("2"), host, e("0"), e("1"), now, e("0"))
  if (BANNER && SHOW["banner"]) {
    x = clip("⚠ slurm unreachable · " uwhy, target)
    if (SHOW["b0"]) out[++o] = ""
    out[++o] = sprintf("%s%s%s%s", lm, e("1;31"), x, e("0"))
  }
  if (SHOW["b1"]) out[++o] = ""
  if (SHOW["nodes"] == 1) out[++o] = lm clip(digest(), target)
  # In place of every node line and bar.  Unlike the queue, no user argument reaches
  # sinfo and there is no SINFO_FORMAT2, so our format cannot be overridden from
  # outside: both of these mean the stream itself was wrong.
  if (SHOW["nodes"] == 2 && (nbad || ntrunc))
    out[++o] = sprintf("%s%s⚠ node output %s%s", lm, e("1;31"),
                       nbad ? "unreadable (unexpected sinfo output?)" : "incomplete",
                       e("0"))
  barc = int(bar/2); barm = bar - barc
  for (r=1; r<=nn && SHOW["nodes"] == 2; r++) {
    down = (nst[r] ~ /down|drain|fail|inval|unk/)
    p = tot[r] ? int(used[r]*100/tot[r]) : 0
    mp = mempc[r]
    sc = cells(used[r], load[r], tot[r], barc, down ? "31" : (p>85 ? "33" : "32"))
    if (MEMALLOC)                               # allocated, drawn as the CPU bar is
      sm = cells(memalloc[r], (meminuse[r] < 0) ? -1 : memalloc[r], memden[r], barm,
                 down ? "31" : (mp>85 ? "33" : "32"))
    else
      sm = cells(memalloc[r], meminuse[r], memreal[r], barm,
                 down ? "31" : (mp>95 ? "1;31" : (mp>85 ? "33" : "32")))
    out[++o] = sprintf("%s%s%-*s%s %s%s%3d%%  %s%*d%s/%-*d cpu   %s%s%3s%%  %s%*s%s/%-*s mem  %*s%s%s%s",
                       lm, e("1"), wn, node[r], e("0"), sc, (bar?" ":""), p,
                       e("1"), wu, used[r], e("0"), wt, tot[r],
                       sm, (bar?" ":""), (mp<0 ? "-" : sprintf("%d", mp)),
                       e(mp>95 && mp>=0 && !MEMALLOC ? "1;31" : "1"), wf, memu[r], e("0"), wm, memt[r],
                       npad+0, "", e("2"), nst[r], e("0"))
    if (SHOW["reasons"] && nreason[r] != "") {
      x = nreason[r]
      if (length(x) + wn + 3 > target) x = substr(x, 1, target - wn - 4) "…"
      out[++o] = sprintf("%s%*s%s↳ %s%s", lm, wn+1, "", e("2"), x, e("0"))
    }
  }
  if (SHOW["nodes"] == 2 && skip[1])           # see which table it is talking about
    out[++o] = sprintf("%s%s↳ %d unreadable node row%s skipped%s", lm, e("2"),
                       skip[1], (skip[1] > 1 ? "s" : ""), e("0"))
  if (SHOW["nodes"] == 2 && MEMNOTE)
    out[++o] = sprintf("%s%s%s%s", lm, e("2"),
                       clip("↳ memory counts RealMemory: scontrol failed (" serr ")", target), e("0"))
  if (SHOW["b2"]) out[++o] = ""

  if (QCAP && !SHOW["qcap"]) ;                 # COMPACT found no line for the caption
  else if (qbad) out[++o] = sprintf("%s%s⚠ queue output unreadable (output format overridden?)%s", lm, e("1;31"), e("0"))
  else if (qtrunc) out[++o] = sprintf("%s%s⚠ queue output incomplete%s", lm, e("1;31"), e("0"))
  else if (!rows && skip[2]) out[++o] = sprintf("%s%sno readable rows%s", lm, e("2"), e("0"))
  else if (!rows && jerr != "") out[++o] = sprintf("%s%sjob list unavailable%s", lm, e("2"), e("0"))
  else if (!rows) out[++o] = sprintf("%s%squeue is empty%s", lm, e("2"), e("0"))
  else if (QBODY) {
    line = lm e("4")
    for (i=1; i<=n; i++) line = line sprintf("%*s%-*.*s", gap[i], "", w[i], w[i], hd[i])
    out[++o] = line e("0")
    for (r=1; r<=rows; r++) {
      if (QSHOW[r]) out[++o] = qrow(r)
      for (x=1; x<=6; x++)                      # after the row it follows, shown or not
        if (ELLAT[x] == r && (x in ELLJ))
          out[++o] = sprintf("%s%s%s%s", lm, e("2"), clip("… " ELLJ[x] " jobs " SECNAME[x], target), e("0"))
    }
  }

  if (recent && SHOW["fin"]) {                  # ---- recently finished
    if (SHOW["b3"]) out[++o] = ""
    # the caption always renders, so "quiet window" and "broken" stop looking
    # alike: before, zero rows took the header away with them
    if (rbad || rtrunc) {
      out[++o] = sprintf("%s%srecently finished%s", lm, e("2"), e("0"))
      out[++o] = sprintf("%s%s⚠ output %s%s", lm, e("1;31"),
                         rbad ? "unreadable" : "incomplete", e("0"))
    } else if (SHOW["fin"] == 1 && d) {         # COMPACT: one line, the newest failure
      g = FAILG                                 # (the fallback says it is one)
      cap = "recently finished" (rsrc == "sacct" ? "" \
            : " (" (rwhyc == "filter" ? rwhy : "no accounting") ")") ": "
      x = clip(cap fid(g) " " rname[g] " " rstate[g] " " fexit(g, 3), target)
      out[++o] = sprintf("%s%s%s%s%s%s%s", lm, e("2"), substr(x, 1, length(cap)), e("0"),
                         e(fcol(rst[g])), substr(x, length(cap) + 1), e("0"))
    } else {
      if (rsrc == "sacct")
        cap = "recently finished · " wtxt sfilt (shown ? "" : " · nothing in this window")
      # accounting down, or a filter accounting cannot express: the
      # parenthetical has to say which, because the fix differs
      else if (rsrc == "squeue")
        cap = "recently finished · recent only " ((rwhyc == "filter") \
              ? "(" rwhy ")" \
              : "(no accounting) · " rwhy)
      # both paths gone: the reason the shell chose, see fwhy
      else
        cap = "finished jobs unavailable · " fwhy
      out[++o] = sprintf("%s%s%s%s", lm, e(rsrc == "none" ? "1;31" : "2"), clip(cap, target), e("0"))
    }
  }
  if (recent && !rbad && !rtrunc && shown) {
    line = lm e("4")
    for (i=1; i<=6; i++) line = line sprintf("%*s%-*.*s", rgap[i], "", rw[i], rw[i], rhd[i])
    out[++o] = line sprintf("%*s", rpad+0, "") e("0")
    for (r=1; r<=shown; r++) {
      best = ord[r]
      fc = fcol(rst[best])
      line = lm
      for (i=1; i<=6; i++) {
        x = (i == 1) ? idfit(rv[best,i], rw[i]) : rv[best,i]
        if (length(x) > rw[i]) x = substr(x, 1, rw[i]-1) "…"
        fw = rrt[i]+0 ? rw[i] : -rw[i]
        if (i==1 || i==3) line = line sprintf("%*s%s%*s%s", rgap[i], "", e(fc),  fw, x, e("0"))
        else              line = line sprintf("%*s%s%*s%s", rgap[i], "", e("2"), fw, x, e("0"))
      }
      out[++o] = line
    }
    if (more) out[++o] = sprintf("%s%s+%d more%s", lm, e("2"), more, e("0"))
  }

  if (bell && hastty)                           # every failure, displayed or not
    for (r=1; r<=d; r++)                        # ... but never an unknown user
      if (BAD[rst[r]] && guser[r] != "" && (bellall || guser[r] == me)) {
        nid = split(gids[r], gi, ",")
        for (j=1; j<=nid; j++) {
          if (!(gi[j] in rung) && rend[r] > systime() - horizon) ding = 1
          rung[gi[j]] = rend[r] ? rend[r] : systime()
        }
      }

  for (i = 2; i <= 3 && SHOW["notes"]; i++)    # the node note renders with the node
    if (skip[i])                                # block instead, where a reader can
      out[++o] = sprintf("%s%s↳ %d unreadable %s row%s skipped%s", lm, e("2"), skip[i],
                         (i == 2 ? "queue" : "finished"),
                         (skip[i] > 1 ? "s" : ""), e("0"))

  if (SHOW["b4"]) out[++o] = ""                 # the footer, always the last line
  out[++o] = sprintf("%s%s%s%s jobs   %s%s running%s   %s%s pending%s   %s%s other%s", lm,
                     e("1"), QKNOWN ? qjobs+0 : "?", e("0"),
                     e("32"), QKNOWN ? cnt["R"]+0 : "?", e("0"),
                     e("33"), QKNOWN ? cnt["PD"]+0 : "?", e("0"),
                     e("31"), QKNOWN ? qjobs - cnt["R"] - cnt["PD"] : "?", e("0"))

  if (compact) {                                # a blank with nothing to separate,
    m = 0                                       # where a section collapsed away, goes
    for (i=1; i<=o; i++) if (out[i] != "" || (m && out[m] != "")) out[++m] = out[i]
    if (m && out[m] == "") m--
    o = m
  }
  if (center == 2) {                            # vertical centring, never overflowing
    top = int((avail - o) / 2)
    for (i=0; i<top; i++) print ""
  }
  for (i=1; i<=o; i++) print out[i]

  if (bell && hastty) {                         # everything remembered, not just
    printf "" > statetmp                        # what this run happened to query;
    for (id in rung) printf "%s\t%d\n", id, rung[id] > statetmp
    close(statetmp)                             # the shell renames it into place
    if (ding) { print "\a" > "/dev/tty"; close("/dev/tty") }
  }
}
' "$tmp/nodes" "$tmp/jobs" "$tmp/recent"
rc=$?

# rename(2), so a second instance can never read or leave a torn state file.
# Only on success: a gawk that died mid-write leaves a partial temp, and
# promoting that would wipe the bell memory and re-ring everything.
[ "$rc" -eq 0 ] && [ -f "$statetmp" ] && mv -f "$statetmp" "$statedir/alerted"
exit $rc
